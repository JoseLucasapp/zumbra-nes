import "../src/core/cartridge.zum" as cartridge;
import "../src/frontend/headless.zum" as headless;
import "../src/testing/assert.zum" as test;
var cart << cartridge.load("fixtures/synthetic/nrom-128-horizontal.nes");
var report << headless.run(cart);
test.assertU16(report.resetVector, 0x8000u16, "reset vector");
test.assertInt(report.cpuA, 1, "LDA from synthetic diagnostic ROM");
test.assertInt(report.cpuInstructions, 2, "diagnostic instruction count");
test.assertBool(report.cpuCycles > 29780u64, "hardware CPU cycles");
test.assertU64(report.ppuCycles, u64(report.cpuCycles * 3u64), "PPU clock ratio");
test.assertBool(report.ppuFrame >= 1u64, "headless frame completed");
test.assertBool(report.audioSamples > 0u64, "headless audio generated");
test.assertInt(report.controllerA, 1, "controller A serial bit");
test.assertU64(report.dmaCycles, 0u64, "headless DMA remains idle");
test.assertString(report.format, "iNES 1.0", "diagnostic format");
show("headless_test: ok");
