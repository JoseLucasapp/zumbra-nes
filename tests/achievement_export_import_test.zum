import "../src/achievements/offline.zum" as offline;
import "../src/achievements/engine.zum" as engine;
import "../src/core/cartridge.zum" as cartridge;
import "../src/core/console.zum" as console;
import "../src/persistence/store.zum" as store;
import "../src/testing/assert.zum" as test;
var source << store.memory();
var cart << cartridge.load("fixtures/synthetic/nrom-128-horizontal.nes");
var machine << console.create(cart);
var digest << cart["info"].digest;
offline.install(source, cart["info"], 10u64);
engine.evaluate(source, digest, machine, 1, 1, 0, 11u64);
var snapshot << store.snapshot(source);
test.assertInt(sizeOf(snapshot["achievementDefinitions"]), 5, "definitions exported");
test.assertInt(sizeOf(snapshot["achievementEvents"]), 2, "unlock events exported");
var destination << store.memory();
store.importSnapshot(destination, snapshot);
var summary << offline.summary(destination, digest);
test.assertInt(summary["unlocked"], 2, "imported unlocked achievements");
test.assertInt(sizeOf(store.achievementEvents(destination, digest, 10)), 2, "imported events");
store.close(source);
store.close(destination);
show("achievement_export_import_test: ok");
