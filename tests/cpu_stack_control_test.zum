import "../src/testing/assert.zum" as test;
import "../src/testing/cpu_fixture.zum" as fixture;
var machine << fixture.createMachine(0x8000,[0xA9u8, 0x2Au8, 0x20u8, 0x08u8, 0x80u8, 0x85u8, 0x10u8, 0xEAu8, 0x48u8, 0xA9u8, 0x05u8, 0x68u8, 0x60u8]);
var processor << machine["cpu"];
var systemBus << machine["bus"];
var index << 0;
while (index < 7) {
    processor.step(systemBus);
    index << index + 1;
}
test.assertInt(processor.a, 0x2A, "PHA PLA restore");
test.assertInt(fixture.readByte(systemBus, 0x10), 0x2A, "JSR RTS result");
test.assertInt(processor.sp, 0xFD, "stack pointer restored");
test.assertInt(processor.pc, 0x8007, "RTS return address");
var jumpMachine << fixture.createMachine(0x8000,[0x6Cu8, 0xFFu8, 0x02u8]);
var jumpCpu << jumpMachine["cpu"];
var jumpBus << jumpMachine["bus"];
fixture.writeByte(jumpBus, 0x02FF, 0x34);
fixture.writeByte(jumpBus, 0x0200, 0x12);
fixture.writeByte(jumpBus, 0x0300, 0x56);
jumpCpu.step(jumpBus);
test.assertInt(jumpCpu.pc, 0x1234, "JMP indirect page-wrap bug");
show("cpu_stack_control_test: ok");
