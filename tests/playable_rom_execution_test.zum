import "../src/core/cartridge.zum" as cartridge;
import "../src/core/console.zum" as console;
import "../src/testing/assert.zum" as test;
var cart << cartridge.load("fixtures/synthetic/z22-playable-loop.nes");
var machine << console.create(cart);
var executed << console.runFrame(machine, 200000);
test.assertBool(executed > 0, "playable fixture executes CPU instructions");
test.assertU64(machine["bus"]["ppu"]["core"].frame, 1u64, "playable fixture completes one frame");
test.assertBool(!machine["cpu"].halted, "playable fixture does not halt on an unsupported opcode");
show("playable_rom_execution_test: ok");
