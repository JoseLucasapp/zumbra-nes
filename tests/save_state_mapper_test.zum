import "../src/core/bus.zum" as bus;
import "../src/core/cartridge.zum" as cartridge;
import "../src/core/console.zum" as console;
import "../src/persistence/save_state.zum" as saveState;
import "../src/testing/assert.zum" as test;
var machine << console.create(cartridge.load("fixtures/synthetic/mapper227-multicart.nes"));
bus.write(machine["bus"], 0x818D, 0u8);
var expected << bus.peek(machine["bus"], 0x8000);
var state << saveState.snapshot(machine);
bus.write(machine["bus"], 0x8002, 0u8);
test.assertBool(bus.peek(machine["bus"], 0x8000) != expected, "mapper bank changed");
var result << saveState.restore(machine, state);
test.assertBool(result.ok, result.message);
test.assertInt(bus.peek(machine["bus"], 0x8000), expected, "mapper bank restored");
show("save_state_mapper_test: ok");
