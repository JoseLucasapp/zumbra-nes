import "../src/achievements/catalog.zum" as catalog;
import "../src/achievements/offline.zum" as offline;
import "../src/core/cartridge.zum" as cartridge;
import "../src/persistence/store.zum" as store;
import "../src/testing/assert.zum" as test;
var db << store.memory();
var cart << cartridge.load("fixtures/synthetic/nrom-128-horizontal.nes");
var summary << offline.install(db, cart["info"], 123u64);
test.assertInt(store.schemaVersion(db), 7, "local store schema version");
test.assertInt(summary["total"], 5, "bundled development achievement count");
test.assertInt(summary["unlocked"], 0, "nothing unlocked during install");
test.assertInt(sizeOf(store.achievementGameRows(db)), 1, "local achievement game registered");
var visibleFixture << cartridge.load("fixtures/synthetic/visible-frame.nes");
var visibleFixturePack << catalog.packForInfo(visibleFixture["info"]);
test.assertString(visibleFixturePack["id"], "zumbra-dev-nrom", "visible-frame fixture receives development achievements");
test.assertInt(sizeOf(visibleFixturePack["definitions"]), 5, "visible-frame fixture development achievement count");
var tetrisPack << catalog.packFor("acab10f2dbad4d4ef5d56b31cd4cea208bb6e2e2c5dba5eb339d711ec04e3535");
test.assertString(tetrisPack["id"], "tetris-nintendo-nes", "Tetris receives its own deterministic pack");
test.assertInt(sizeOf(tetrisPack["definitions"]), 8, "Tetris achievement count");
var tetrisByCrc << catalog.packForFingerprints("", 0u64, 0x1394F57Eu64);
test.assertString(tetrisByCrc["id"], "tetris-nintendo-nes", "Tetris content CRC resolves its game pack");
var popeyeUs << catalog.packForFingerprints("", 0u64, 0x70860FCAu64);
test.assertString(popeyeUs["id"], "popeye-nintendo-nes", "Popeye USA content CRC resolves its game pack");
var popeyeJp << catalog.packForFingerprints("", 0u64, 0x5581E835u64);
test.assertString(popeyeJp["id"], "popeye-nintendo-nes", "Popeye Japan content CRC resolves its game pack");
test.assertInt(sizeOf(popeyeUs["definitions"]), 8, "Popeye achievement count");
var unknownPack << catalog.packFor("ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff");
test.assertInt(sizeOf(unknownPack["definitions"]), 0, "unknown ROM does not inherit emulator-use achievements");
var unknownCart << cartridge.load("fixtures/synthetic/nrom-256-chr-ram.nes");
var unknownByInfo << catalog.packForInfo(unknownCart["info"]);
test.assertString(unknownByInfo["id"], "none", "unknown ROM requires a real game-specific pack");
test.assertInt(sizeOf(unknownByInfo["definitions"]), 0, "unknown ROM receives no fake procedural achievements");
store.close(db);
show("achievement_offline_install_test: ok");
