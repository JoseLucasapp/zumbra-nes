import "../src/testing/assert.zum" as test;
import "../src/testing/cpu_fixture.zum" as fixture;
var program <<[0xA5u8, 0x10u8, 0xA2u8, 0x01u8, 0xB5u8, 0x10u8, 0xA0u8, 0x02u8, 0xB6u8, 0x10u8, 0xADu8, 0x00u8, 0x60u8, 0xA2u8, 0x01u8, 0xBDu8, 0x00u8, 0x60u8, 0xA0u8, 0x01u8, 0xB9u8, 0x00u8, 0x60u8, 0xA2u8, 0x04u8, 0xA1u8, 0x1Cu8, 0xA0u8, 0x02u8, 0xB1u8, 0x24u8];
var machine << fixture.createMachine(0x8000, program);
var processor << machine["cpu"];
var systemBus << machine["bus"];
fixture.writeByte(systemBus, 0x10, 0x11);
fixture.writeByte(systemBus, 0x11, 0x22);
fixture.writeByte(systemBus, 0x12, 0x33);
fixture.writeByte(systemBus, 0x20, 0x00);
fixture.writeByte(systemBus, 0x21, 0x60);
fixture.writeByte(systemBus, 0x24, 0xFE);
fixture.writeByte(systemBus, 0x25, 0x5F);
fixture.writeByte(systemBus, 0x6000, 0x44);
fixture.writeByte(systemBus, 0x6001, 0x55);
processor.step(systemBus);
test.assertInt(processor.a, 0x11, "zero page");
processor.step(systemBus);
processor.step(systemBus);
test.assertInt(processor.a, 0x22, "zero page X");
processor.step(systemBus);
processor.step(systemBus);
test.assertInt(processor.x, 0x33, "zero page Y");
processor.step(systemBus);
test.assertInt(processor.a, 0x44, "absolute");
processor.step(systemBus);
processor.step(systemBus);
test.assertInt(processor.a, 0x55, "absolute X");
processor.step(systemBus);
processor.step(systemBus);
test.assertInt(processor.a, 0x55, "absolute Y");
processor.step(systemBus);
processor.step(systemBus);
test.assertInt(processor.a, 0x44, "indexed indirect");
processor.step(systemBus);
processor.step(systemBus);
test.assertInt(processor.a, 0x44, "indirect indexed");
show("cpu_addressing_test: ok");
