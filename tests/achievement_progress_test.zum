import "../src/achievements/catalog.zum" as catalog;
import "../src/core/cartridge.zum" as cartridge;
import "../src/persistence/store.zum" as store;
import "../src/testing/assert.zum" as test;
var db << store.memory();
var cart << cartridge.load("fixtures/synthetic/nrom-128-horizontal.nes");
var digest << cart["info"].digest;
store.seedAchievements(db, digest, catalog.defaults());
store.updateAchievement(db, digest, "hundred-frames", 42, false, 0u64);
var rows << store.achievementRows(db, digest);
var found << false;
var index << 0;
while (index < sizeOf(rows)) {
    if (rows[index]["id"] == "hundred-frames") {
        test.assertInt(rows[index]["progress"], 42, "progress persisted");
        found << true;
    }
    index << index + 1;
}
test.assertBool(found, "achievement row found");
store.close(db);
show("achievement_progress_test: ok");
