import "../src/core/cartridge.zum" as cartridge;
import "../src/core/console.zum" as console;
import "../src/debugger/debugger.zum" as debugger;
import "../src/testing/assert.zum" as test;
var machine << console.create(cartridge.load("fixtures/synthetic/z22-playable-loop.nes"));
var debug << debugger.create(machine);
var first << debugger.disassembleAt(debug, 0x8000);
test.assertString(first.mnemonic, "SEI", "disassembler mnemonic");
test.assertInt(first.bytes, 1, "disassembler size");
debugger.addPcBreakpoint(debug, 0x8000);
test.assertInt(debugger.run(debug, 20), 0, "PC breakpoint before execution");
test.assertString(debug["reason"], "PC breakpoint at 32768", "PC breakpoint reason");
debugger.clearBreakpoints(debug);
test.assertBool(debugger.stepInstruction(debug) > 0, "single instruction step");
test.assertInt(sizeOf(debugger.trace(debug)), 1, "trace entry recorded");
var regs << debugger.registers(debug);
test.assertInt(regs.pc, 0x8001, "PC after SEI");
var bytesView << debugger.memory(debug, 0x8000, 3);
test.assertInt(toInt(bytesView[0]), 0x78, "memory view opcode");
test.assertString(debugger.mapperState(debug)["name"], "NROM", "mapper inspection");
show("debugger_test: ok");
