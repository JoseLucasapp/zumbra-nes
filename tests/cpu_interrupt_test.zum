import "../src/core/cpu6502.zum" as cpu6502;
import "../src/testing/assert.zum" as test;
import "../src/testing/cpu_fixture.zum" as fixture;
var machine << fixture.createMachine(0x8000,[0xEAu8]);
var cart << machine["cart"];
var processor << machine["cpu"];
var systemBus << machine["bus"];
fixture.installProgram(cart, 0x9000,[0xE8u8, 0x40u8]);
fixture.installProgram(cart, 0x9100,[0xC8u8, 0x40u8]);
fixture.setWord(cart, 0xFFFA, 0x9000);
fixture.setWord(cart, 0xFFFE, 0x9100);
processor.requestNmi();
var nmiCycles << processor.step(systemBus);
test.assertInt(nmiCycles, 7, "NMI cycles");
test.assertInt(processor.pc, 0x9000, "NMI vector");
test.assertBool((fixture.readByte(systemBus, 0x01FB) band cpu6502.FLAG_BREAK) == 0, "NMI pushes break clear");
processor.step(systemBus);
processor.step(systemBus);
test.assertInt(processor.x, 1, "NMI handler executed");
test.assertInt(processor.pc, 0x8000, "RTI restored NMI PC");
processor.setFlag(cpu6502.FLAG_INTERRUPT, false);
processor.requestIrq();
var irqCycles << processor.step(systemBus);
processor.clearIrq();
test.assertInt(irqCycles, 7, "IRQ cycles");
test.assertInt(processor.pc, 0x9100, "IRQ vector");
processor.step(systemBus);
processor.step(systemBus);
test.assertInt(processor.y, 1, "IRQ handler executed");
test.assertInt(processor.pc, 0x8000, "RTI restored IRQ PC");
var brkMachine << fixture.createMachine(0x8000,[0x00u8, 0xEAu8]);
var brkCart << brkMachine["cart"];
var brkCpu << brkMachine["cpu"];
var brkBus << brkMachine["bus"];
fixture.installProgram(brkCart, 0x9200,[0x40u8]);
fixture.setWord(brkCart, 0xFFFE, 0x9200);
brkCpu.step(brkBus);
test.assertInt(brkCpu.pc, 0x9200, "BRK vector");
test.assertBool((fixture.readByte(brkBus, 0x01FB) band cpu6502.FLAG_BREAK) != 0, "BRK pushes break set");
brkCpu.step(brkBus);
test.assertInt(brkCpu.pc, 0x8002, "BRK pushes PC plus padding byte");
show("cpu_interrupt_test: ok");
