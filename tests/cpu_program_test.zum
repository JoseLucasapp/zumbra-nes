import "../src/testing/assert.zum" as test;
import "../src/testing/cpu_fixture.zum" as fixture;
var machine << fixture.createMachine(0x8000,[0xA9u8, 0x00u8, 0x85u8, 0x10u8, 0xA2u8, 0x05u8, 0xE6u8, 0x10u8, 0xCAu8, 0xD0u8, 0xFBu8]);
var processor << machine["cpu"];
var systemBus << machine["bus"];
var count << 0;
while (count < 18) {
    processor.step(systemBus);
    count << count + 1;
}
test.assertInt(fixture.readByte(systemBus, 0x10), 5, "loop result");
test.assertInt(processor.x, 0, "loop counter");
test.assertInt(processor.pc, 0x800B, "loop end PC");
test.assertInt(processor.instructions, 18, "loop instruction count");
show("cpu_program_test: ok");
