import "../src/core/bus.zum" as bus;
import "../src/core/cartridge.zum" as cartridge;
import "../src/core/console.zum" as console;
import "../src/persistence/save_state.zum" as saveState;
import "../src/testing/assert.zum" as test;
var cart << cartridge.load("fixtures/synthetic/z22-playable-loop.nes");
var machine << console.create(cart);
machine["cpu"].a << 0x42;
machine["cpu"].x << 0x17;
machine["bus"]["ram"][10] << 0x77u8;
machine["bus"]["prgRam"][5] << 0x66u8;
machine["bus"]["ppu"]["palette"][2] << 0x21u8;
machine["bus"]["apu"]["pulse1"].enabled << true;
machine["bus"]["apu"]["pulse1"].lengthCounter << 9;
bus.write(machine["bus"], 0x8000, 1u8);
var path << "build/states/roundtrip.zst";
test.assertBool(saveState.save(path, machine), "save state written");
machine["cpu"].a << 0;
machine["cpu"].x << 0;
machine["bus"]["ram"][10] << 0u8;
machine["bus"]["prgRam"][5] << 0u8;
machine["bus"]["ppu"]["palette"][2] << 0u8;
machine["bus"]["apu"]["pulse1"].enabled << false;
machine["bus"]["apu"]["pulse1"].lengthCounter << 0;
var loaded << saveState.load(path, machine);
test.assertBool(loaded.ok, loaded.message);
test.assertInt(machine["cpu"].a, 0x42, "CPU accumulator restored");
test.assertInt(machine["cpu"].x, 0x17, "CPU X restored");
test.assertInt(toInt(machine["bus"]["ram"][10]), 0x77, "CPU RAM restored");
test.assertInt(toInt(machine["bus"]["prgRam"][5]), 0x66, "PRG RAM restored");
test.assertInt(toInt(machine["bus"]["ppu"]["palette"][2]), 0x21, "PPU palette restored");
test.assertBool(machine["bus"]["apu"]["pulse1"].enabled, "APU state restored");
test.assertInt(machine["bus"]["apu"]["pulse1"].lengthCounter, 9, "APU counter restored");
show("save_state_test: ok");
