import "../src/core/cpu6502.zum" as cpu6502;
import "../src/testing/assert.zum" as test;
import "../src/testing/cpu_fixture.zum" as fixture;
var machine << fixture.createMachine(0x8000,[0xA9u8, 0x10u8, 0xC9u8, 0x10u8, 0xA2u8, 0x20u8, 0xE0u8, 0x10u8, 0xA0u8, 0x05u8, 0xC0u8, 0x06u8, 0xE6u8, 0x30u8, 0xC6u8, 0x31u8, 0xCAu8, 0x88u8]);
var processor << machine["cpu"];
var systemBus << machine["bus"];
fixture.writeByte(systemBus, 0x30, 0xFF);
fixture.writeByte(systemBus, 0x31, 0x00);
processor.step(systemBus);
processor.step(systemBus);
test.assertBool(processor.getFlag(cpu6502.FLAG_ZERO), "CMP equal");
test.assertBool(processor.getFlag(cpu6502.FLAG_CARRY), "CMP carry");
processor.step(systemBus);
processor.step(systemBus);
test.assertBool(processor.getFlag(cpu6502.FLAG_CARRY), "CPX greater");
processor.step(systemBus);
processor.step(systemBus);
test.assertBool(!processor.getFlag(cpu6502.FLAG_CARRY), "CPY less");
processor.step(systemBus);
test.assertInt(fixture.readByte(systemBus, 0x30), 0, "INC wraps");
test.assertBool(processor.getFlag(cpu6502.FLAG_ZERO), "INC zero");
processor.step(systemBus);
test.assertInt(fixture.readByte(systemBus, 0x31), 0xFF, "DEC wraps");
test.assertBool(processor.getFlag(cpu6502.FLAG_NEGATIVE), "DEC negative");
processor.step(systemBus);
processor.step(systemBus);
test.assertInt(processor.x, 0x1F, "DEX");
test.assertInt(processor.y, 0x04, "DEY");
show("cpu_compare_memory_test: ok");
