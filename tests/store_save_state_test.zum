import "../src/persistence/store.zum" as store;
import "../src/testing/assert.zum" as test;
var db << store.memory();
store.recordSaveState(db, "digest", 0, "/tmp/state-0.zst", 123u64, 45u64);
store.recordSaveState(db, "digest", 3, "/tmp/state-3.zst", 124u64, 90u64);
store.recordSaveState(db, "digest", 9, "/tmp/state-9.zst", 125u64, 180u64);
var rows << store.saveStateRows(db, "digest");
test.assertInt(sizeOf(rows), 3, "save-state metadata rows");
test.assertInt(rows[0]["slot"], 0, "save-state first slot");
test.assertString(rows[0]["path"], "/tmp/state-0.zst", "save-state first path");
test.assertInt(rows[1]["slot"], 3, "save-state middle slot");
test.assertInt(rows[1]["frame"], 90, "save-state middle frame");
test.assertInt(rows[2]["slot"], 9, "save-state last slot");
test.assertString(rows[2]["path"], "/tmp/state-9.zst", "save-state last path");
test.assertInt(store.schemaVersion(db), 5, "achievement schema version");
store.close(db);
show("store_save_state_test: ok");
