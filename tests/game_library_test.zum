import "../src/achievements/offline.zum" as offline;
import "../src/core/cartridge.zum" as cartridge;
import "../src/frontend/library.zum" as library;
import "../src/persistence/store.zum" as store;
import "../src/testing/assert.zum" as test;
var db << store.memory();
test.assertInt(store.schemaVersion(db), 7, "game library schema migration");
var first << cartridge.load("fixtures/synthetic/nrom-128-horizontal.nes");
var second << cartridge.load("fixtures/synthetic/visible-frame.nes");
var third << cartridge.load("fixtures/synthetic/nrom-256-chr-ram.nes");
offline.install(db, first["info"], 1000u64);
offline.install(db, second["info"], 2000u64);
offline.install(db, third["info"], 3000u64);
test.assertInt(library.count(db, 0, ""), 3, "all library rows");
test.assertInt(library.count(db, 1, ""), 2, "known achievement games");
test.assertInt(library.count(db, 4, ""), 1, "no-pack games");
test.assertInt(library.count(db, 0, "visible"), 1, "search by ROM path/title");
var allState << library.pageState(db, 0, 0, "", 0, 5);
test.assertInt(allState["total"], 3, "page state total");
test.assertInt(sizeOf(allState["rows"]), 3, "page rows");
var firstDetail << library.detail(db, first["info"].digest);
test.assertBool(library.hasAchievementPack(firstDetail), "known pack exposed to library");
test.assertString(library.completionLabel(firstDetail), "NOT STARTED", "fresh pack status");
test.assertString(library.displayTitle(firstDetail), "Zumbra synthetic fixture", "achievement metadata title");
test.assertString(library.playTimeLabel(3720), "1H 2M", "play time label");
store.updateAchievement(db, first["info"].digest, "first-frame", 1, 1, 4000);
test.assertInt(library.count(db, 2, ""), 1, "in-progress filter");
var progressDetail << library.detail(db, first["info"].digest);
test.assertInt(progressDetail["achievement_unlocked"], 1, "library unlock count");
test.assertInt(progressDetail["achievement_total"], 5, "library achievement total");
test.assertInt(progressDetail["achievement_percent"], 20, "library percent");
var unlockedRows << library.achievements(db, first["info"].digest, "unlocked");
test.assertInt(sizeOf(unlockedRows), 1, "unlocked achievement view");
var lockedRows << library.achievements(db, first["info"].digest, "locked");
test.assertInt(sizeOf(lockedRows), 4, "locked achievement view");
store.updateAchievement(db, first["info"].digest, "hundred-frames", 100, 1, 4001);
store.updateAchievement(db, first["info"].digest, "first-input", 1, 1, 4002);
store.updateAchievement(db, first["info"].digest, "hundred-thousand-instructions", 100000, 1, 4003);
store.updateAchievement(db, first["info"].digest, "one-minute", 60, 1, 4004);
test.assertInt(library.count(db, 3, ""), 1, "completed filter");
test.assertString(library.completionLabel(library.detail(db, first["info"].digest)), "COMPLETE", "completed status");
var sessionId << store.beginSession(db, first["info"].digest, 1700000000u64);
store.finishSession(db, sessionId, first["info"].digest, 1700000120u64, 120, 7200u64);
var sessionDetail << library.detail(db, first["info"].digest);
test.assertInt(sessionDetail["play_seconds"], 120, "library play time accumulated");
test.assertInt(sessionDetail["sessions"], 1, "library session count");
test.assertInt(sizeOf(library.sessions(db, first["info"].digest, 5)), 1, "library session history");
var progressSorted << library.page(db, 0, 2, "", 5, 0);
test.assertString(progressSorted[0]["digest"], first["info"].digest, "progress sort puts completed game first");
var playTimeSorted << library.page(db, 0, 3, "", 5, 0);
test.assertString(playTimeSorted[0]["digest"], first["info"].digest, "play-time sort puts played game first");
var sessionSorted << library.page(db, 0, 4, "", 5, 0);
test.assertString(sessionSorted[0]["digest"], first["info"].digest, "session sort puts played game first");
test.assertString(library.lastPlayedLabel(1700000000, 1700000060), "1M AGO", "relative last played label");
test.assertString(library.lastPlayedLabel(5000, 1700000060), "LEGACY", "legacy tick timestamp label");
test.assertString(library.filterLabel(library.nextFilter(4)), "ALL", "filter cycles");
test.assertString(library.sortLabel(library.nextSort(4)), "RECENT", "sort cycles");
test.assertString(library.achievementFilterLabel(library.nextAchievementFilter(2)), "ALL", "achievement filter cycles");
store.close(db);
show("game_library_test: ok");
