import "../src/compatibility/local.zum" as compatibility;
import "../src/core/cartridge.zum" as cartridge;
import "../src/core/mapper.zum" as mapper;
import "../src/frontend/library.zum" as library;
import "../src/persistence/store.zum" as store;
import "../src/testing/assert.zum" as test;
var db << store.memory();
test.assertInt(store.schemaVersion(db), 7, "compatibility schema migration");
var supported << cartridge.load("fixtures/synthetic/nrom-128-horizontal.nes");
var supportedInfo << supported["info"];
var initial << compatibility.register(db, supportedInfo, 1700000000u64);
test.assertString(initial["status"], "untested", "supported ROM starts untested");
test.assertString(initial["mapper_name"], "NROM", "mapper name recorded");
test.assertString(initial["save_support"], "supported", "save support recorded");
test.assertString(initial["achievement_support"], "supported", "bundled achievement support recorded");
test.assertInt(initial["content_crc32"], toInt(supportedInfo.contentCrc32), "content CRC recorded");
var observed << compatibility.recordSession(db, supportedInfo, 120u64, true, true, 1700000100u64);
test.assertString(observed["status"], "playable", "successful session becomes playable");
test.assertString(observed["video_status"], "passed", "video observation recorded");
test.assertString(observed["audio_status"], "enabled", "audio observation recorded");
test.assertString(observed["input_status"], "passed", "input observation recorded");
test.assertInt(observed["test_count"], 1, "compatibility test count increments");
test.assertInt(observed["last_frame"], 120, "last tested frame recorded");
test.assertBool(compatibility.review(db, supportedInfo.digest, "issues", "Local sprite timing observation", 1700000150u64), "local compatibility review");
var reviewed << compatibility.record(db, supportedInfo.digest);
test.assertString(reviewed["status"], "issues", "local issue status recorded");
test.assertString(reviewed["known_issues"], "Local sprite timing observation", "known issue recorded");
var observedAgain << compatibility.recordSession(db, supportedInfo, 180u64, true, true, 1700000160u64);
test.assertString(observedAgain["status"], "issues", "automatic session preserves local issue review");
var unsupported << cartridge.load("fixtures/synthetic/unsupported-mapper5.nes");
var unsupportedInfo << unsupported["info"];
var unsupportedRecord << compatibility.register(db, unsupportedInfo, 1700000200u64);
test.assertString(unsupportedRecord["status"], "unsupported", "unsupported mapper recorded");
test.assertString(unsupportedRecord["save_support"], "unsupported", "unsupported mapper save status");
test.assertInt(unsupportedRecord["mapper"], 5, "unsupported mapper id recorded");
var diagnostic << mapper.diagnostics(unsupportedInfo.header.mapper, unsupportedInfo.header.submapper);
test.assertBool(!diagnostic["ok"], "unsupported mapper diagnostic");
test.assertString(diagnostic["status"], "unsupported", "mapper diagnostic status");
test.assertInt(store.compatibilityCount(db, "all"), 2, "all compatibility records");
test.assertInt(store.compatibilityCount(db, "issues"), 1, "issue compatibility records");
test.assertInt(store.compatibilityCount(db, "unsupported"), 1, "unsupported compatibility records");
test.assertInt(library.countWithCompatibility(db, 0, 3, ""), 1, "library issue compatibility filter");
test.assertInt(library.countWithCompatibility(db, 0, 4, ""), 1, "library unsupported compatibility filter");
var path << "build/compatibility-report-test.json";
test.assertBool(store.exportCompatibilityJson(db, path, 1700000300u64), "compatibility report exported");
var importedDb << store.memory();
test.assertBool(store.importCompatibilityJson(importedDb, path), "compatibility report imported");
test.assertInt(store.compatibilityCount(importedDb, "all"), 2, "imported compatibility records");
var importedSupported << store.compatibilityRecord(importedDb, supportedInfo.digest);
test.assertString(importedSupported["status"], "issues", "import preserves status");
test.assertString(importedSupported["known_issues"], "Local sprite timing observation", "import preserves known issue");
test.assertString(importedSupported["status_source"], "imported", "import source tracked");
store.close(db);
store.close(importedDb);
show("compatibility_database_test: ok");
