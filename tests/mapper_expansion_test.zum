import "../src/core/mapper.zum" as mapper;
import "../src/testing/assert.zum" as test;
var colorDreams << mapper.create(11u16, 0u8, 262144, 131072, false, "horizontal");
mapper.cpuWrite(colorDreams, 0x8000, 0x31, 262144);
test.assertInt(mapper.cpuRead(colorDreams, 0x8000, 262144).offset, 1 * 32768, "Mapper11 PRG 32K bank");
test.assertInt(mapper.ppuRead(colorDreams, 0x0100, 131072).offset, 3 * 8192 + 0x0100, "Mapper11 CHR 8K bank");
var unrom512 << mapper.create(30u16, 0u8, 1048576, 8192, false, "horizontal");
mapper.cpuWrite(unrom512, 0x8000, 0x83, 1048576);
test.assertInt(mapper.cpuRead(unrom512, 0x8000, 1048576).offset, 3 * 16384, "Mapper30 switchable low bank");
test.assertInt(mapper.cpuRead(unrom512, 0xC000, 1048576).offset, 63 * 16384, "Mapper30 fixed last bank");
test.assertString(mapper.mirroring(unrom512, "horizontal"), "single-screen-upper", "Mapper30 one-screen mirroring");
var gxrom << mapper.create(66u16, 0u8, 262144, 32768, false, "vertical");
mapper.cpuWrite(gxrom, 0x8000, 0x21, 262144);
test.assertInt(mapper.cpuRead(gxrom, 0x8000, 262144).offset, 2 * 32768, "Mapper66 PRG 32K bank");
test.assertInt(mapper.ppuRead(gxrom, 0x0010, 32768).offset, 8192 + 0x0010, "Mapper66 CHR 8K bank");
var camerica << mapper.create(71u16, 0u8, 262144, 8192, false, "horizontal");
mapper.cpuWrite(camerica, 0x9000, 0x10, 262144);
mapper.cpuWrite(camerica, 0xC000, 0x06, 262144);
test.assertInt(mapper.cpuRead(camerica, 0x8000, 262144).offset, 6 * 16384, "Mapper71 switchable low bank");
test.assertInt(mapper.cpuRead(camerica, 0xC000, 262144).offset, 15 * 16384, "Mapper71 fixed last bank");
test.assertString(mapper.mirroring(camerica, "horizontal"), "single-screen-upper", "Mapper71 one-screen mirroring");
var jaleco << mapper.create(87u16, 0u8, 32768, 32768, false, "vertical");
mapper.cpuWrite(jaleco, 0x8000, 0x02, 32768);
test.assertInt(mapper.cpuRead(jaleco, 0x8000, 32768).offset, 0, "Mapper87 NROM PRG");
test.assertInt(mapper.ppuRead(jaleco, 0x0200, 32768).offset, 8192 + 0x0200, "Mapper87 swapped CHR bank bits");
var un1rom << mapper.create(94u16, 0u8, 262144, 8192, false, "horizontal");
mapper.cpuWrite(un1rom, 0x8000, 0x14, 262144);
test.assertInt(mapper.cpuRead(un1rom, 0x8000, 262144).offset, 5 * 16384, "Mapper94 shifted PRG bank");
test.assertInt(mapper.cpuRead(un1rom, 0xC000, 262144).offset, 15 * 16384, "Mapper94 fixed last bank");
var reverse << mapper.create(180u16, 0u8, 262144, 8192, false, "horizontal");
mapper.cpuWrite(reverse, 0x8000, 0x04, 262144);
test.assertInt(mapper.cpuRead(reverse, 0x8000, 262144).offset, 0, "Mapper180 fixed first bank");
test.assertInt(mapper.cpuRead(reverse, 0xC000, 262144).offset, 4 * 16384, "Mapper180 switchable high bank");
show("mapper_expansion_test: ok");
