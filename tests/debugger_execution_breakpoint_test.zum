import "../src/core/cartridge.zum" as cartridge;
import "../src/core/console.zum" as console;
import "../src/debugger/debugger.zum" as debugger;
import "../src/testing/assert.zum" as test;
var machine << console.create(cartridge.load("fixtures/synthetic/z23-visible-frame.nes"));
var debug << debugger.create(machine);
debugger.addWriteBreakpoint(debug, 0x2000);
var executed << debugger.run(debug, 20);
test.assertBool(executed > 0, "debugger executed program");
test.assertString(debug["reason"], "write breakpoint at 8192", "PPU write breakpoint");
test.assertInt(machine["bus"]["debug"]["lastAddress"], 0x2000, "write breakpoint address");
show("debugger_execution_breakpoint_test: ok");
