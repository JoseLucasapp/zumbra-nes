import "../src/core/cartridge.zum" as cartridge;
import "../src/core/ppu.zum" as ppu;
import "../src/testing/assert.zum" as test;
var cart << cartridge.load("fixtures/synthetic/nrom-128-horizontal.nes");
var state << ppu.create(cart);
ppu.cpuWrite(state, 0, 0x80);
state["core"].scanline << 241;
state["core"].dot << 1;
ppu.tick(state);
test.assertBool((state["core"].status band 0x80) != 0, "VBlank flag set");
test.assertBool(ppu.takeNmi(state), "VBlank raises NMI");
test.assertBool(!ppu.takeNmi(state), "NMI edge consumed once");
ppu.cpuRead(state, 2);
test.assertBool((state["core"].status band 0x80) == 0, "status read clears VBlank");
state["core"].status << state["core"].status bor 0x80;
ppu.cpuWrite(state, 0, 0x00);
ppu.cpuWrite(state, 0, 0x80);
test.assertBool(ppu.takeNmi(state), "enabling NMI during VBlank creates edge");
show("ppu_vblank_nmi_test: ok");
