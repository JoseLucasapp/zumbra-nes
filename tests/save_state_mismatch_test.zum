import "../src/core/cartridge.zum" as cartridge;
import "../src/core/console.zum" as console;
import "../src/persistence/save_state.zum" as saveState;
import "../src/testing/assert.zum" as test;
var first << console.create(cartridge.load("fixtures/synthetic/z22-playable-loop.nes"));
var value << saveState.snapshot(first);
value["romDigest"] << "different";
var result << saveState.restore(first, value);
test.assertBool(!result.ok, "digest mismatch rejected");
test.assertString(result.message, "save-state ROM digest mismatch", "digest mismatch message");
show("save_state_mismatch_test: ok");
