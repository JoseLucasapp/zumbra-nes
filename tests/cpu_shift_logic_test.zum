import "../src/core/cpu6502.zum" as cpu6502;
import "../src/testing/assert.zum" as test;
import "../src/testing/cpu_fixture.zum" as fixture;
var machine << fixture.createMachine(0x8000,[0xA9u8, 0x81u8, 0x0Au8, 0x2Au8, 0x38u8, 0x6Au8, 0x4Au8, 0x09u8, 0x80u8, 0x29u8, 0xF0u8, 0x49u8, 0xFFu8, 0x24u8, 0x20u8]);
var processor << machine["cpu"];
var systemBus << machine["bus"];
fixture.writeByte(systemBus, 0x20, 0xC0);
processor.step(systemBus);
processor.step(systemBus);
test.assertInt(processor.a, 0x02, "ASL accumulator");
test.assertBool(processor.getFlag(cpu6502.FLAG_CARRY), "ASL carry");
processor.step(systemBus);
test.assertInt(processor.a, 0x05, "ROL accumulator");
processor.step(systemBus);
processor.step(systemBus);
test.assertInt(processor.a, 0x82, "ROR accumulator");
processor.step(systemBus);
test.assertInt(processor.a, 0x41, "LSR accumulator");
processor.step(systemBus);
processor.step(systemBus);
processor.step(systemBus);
test.assertInt(processor.a, 0x3F, "ORA AND EOR sequence");
processor.step(systemBus);
test.assertBool(processor.getFlag(cpu6502.FLAG_ZERO), "BIT zero");
test.assertBool(processor.getFlag(cpu6502.FLAG_OVERFLOW), "BIT overflow");
test.assertBool(processor.getFlag(cpu6502.FLAG_NEGATIVE), "BIT negative");
var memoryMachine << fixture.createMachine(0x8000,[0x06u8, 0x30u8, 0x26u8, 0x30u8, 0x46u8, 0x30u8, 0x66u8, 0x30u8]);
var memoryCpu << memoryMachine["cpu"];
var memoryBus << memoryMachine["bus"];
fixture.writeByte(memoryBus, 0x30, 0x81);
memoryCpu.step(memoryBus);
test.assertInt(fixture.readByte(memoryBus, 0x30), 0x02, "ASL memory writeback");
memoryCpu.step(memoryBus);
test.assertInt(fixture.readByte(memoryBus, 0x30), 0x05, "ROL memory writeback");
memoryCpu.step(memoryBus);
test.assertInt(fixture.readByte(memoryBus, 0x30), 0x02, "LSR memory writeback");
memoryCpu.step(memoryBus);
test.assertInt(fixture.readByte(memoryBus, 0x30), 0x81, "ROR memory writeback");
show("cpu_shift_logic_test: ok");
