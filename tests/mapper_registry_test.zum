import "../src/core/mapper.zum" as mapper;
import "../src/testing/assert.zum" as test;
var ids << mapper.supportedIds();
test.assertInt(sizeOf(ids), 15, "fifteen Z28 mappers");
test.assertInt(mapper.supportedCount(), sizeOf(ids), "reported mapper count matches registry");
test.assertBool(mapper.supports(0u16), "NROM");
test.assertBool(mapper.supports(1u16), "MMC1");
test.assertBool(mapper.supports(2u16), "UxROM");
test.assertBool(mapper.supports(3u16), "CNROM");
test.assertBool(mapper.supports(4u16), "MMC3");
test.assertBool(mapper.supports(7u16), "AxROM");
test.assertBool(mapper.supports(10u16), "Mapper 10");
test.assertBool(mapper.supports(227u16), "Mapper 227");
test.assertBool(mapper.supports(11u16), "Mapper 11");
test.assertBool(mapper.supports(30u16), "Mapper 30");
test.assertBool(mapper.supports(66u16), "Mapper 66");
test.assertBool(mapper.supports(71u16), "Mapper 71");
test.assertBool(mapper.supports(87u16), "Mapper 87");
test.assertBool(mapper.supports(94u16), "Mapper 94");
test.assertBool(mapper.supports(180u16), "Mapper 180");
test.assertBool(!mapper.supports(5u16), "unsupported mapper rejected");
show("mapper_registry_test: ok");
