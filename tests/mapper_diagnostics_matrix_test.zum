import "../src/core/mapper.zum" as mapper;
import "../src/testing/assert.zum" as test;
var ids << mapper.supportedIds();
test.assertInt(sizeOf(ids), 15, "supported mapper count");
test.assertInt(mapper.supportedCount(), 15, "supportedCount");
test.assertBool(mapper.supports(11u16), "Mapper11 supported");
test.assertBool(mapper.supports(30u16), "Mapper30 supported");
test.assertBool(mapper.supports(66u16), "Mapper66 supported");
test.assertBool(mapper.supports(71u16), "Mapper71 supported");
test.assertBool(mapper.supports(87u16), "Mapper87 supported");
test.assertBool(mapper.supports(94u16), "Mapper94 supported");
test.assertBool(mapper.supports(180u16), "Mapper180 supported");
test.assertString(mapper.name(11u16), "Color Dreams", "Mapper11 name");
test.assertString(mapper.name(30u16), "UNROM 512", "Mapper30 name");
test.assertString(mapper.name(66u16), "GxROM", "Mapper66 name");
test.assertString(mapper.name(71u16), "Camerica/Codemasters", "Mapper71 name");
test.assertString(mapper.name(87u16), "Jaleco JF-13", "Mapper87 name");
test.assertString(mapper.name(94u16), "UN1ROM", "Mapper94 name");
test.assertString(mapper.name(180u16), "UNROM reverse", "Mapper180 name");
var unsupported << mapper.compatibility(5u16);
test.assertBool(!unsupported["ok"], "Mapper5 still unsupported");
test.assertString(unsupported["message"], "Incompatible ROM: mapper 5. Supported: 0 (NROM), 1 (MMC1), 2 (UxROM), 3 (CNROM), 4 (MMC3), 7 (AxROM), 10 (MMC4), 11 (Color Dreams), 30 (UNROM 512), 66 (GxROM), 71 (Camerica), 87 (Jaleco), 94 (UN1ROM), 180 (UNROM reverse), 227 (multicart)", "unsupported mapper message");
var descriptor << mapper.descriptor(mapper.create(66u16, 0u8, 262144, 32768, false, "vertical"));
test.assertInt(descriptor["prgBanks32"], 8, "descriptor PRG 32K banks");
test.assertInt(descriptor["chrBanks8"], 4, "descriptor CHR 8K banks");
show("mapper_diagnostics_matrix_test: ok");
