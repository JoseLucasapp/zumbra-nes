import "../src/core/mapper.zum" as mapper;
import "../src/testing/assert.zum" as test;
test.assertBool(mapper.supports(0u16), "Mapper 0 supported");
test.assertBool(!mapper.supports(1u16), "Mapper 1 deferred");
var first16 << mapper.cpuRead(0u16, 0x8000, 16384);
var mirror16 << mapper.cpuRead(0u16, 0xC000, 16384);
test.assertBool(first16.mapped, "NROM-128 lower bank mapped");
test.assertInt(first16.offset, 0, "NROM-128 lower offset");
test.assertInt(mirror16.offset, 0, "NROM-128 upper mirror");
var upper32 << mapper.cpuRead(0u16, 0xFFFF, 32768);
test.assertInt(upper32.offset, 32767, "NROM-256 upper offset");
var chrWrite << mapper.ppuWrite(0u16, 0x0010, 8192, true);
test.assertBool(chrWrite.writable, "CHR RAM writable");
show("mapper0_test: ok");
