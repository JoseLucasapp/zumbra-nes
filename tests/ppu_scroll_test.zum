import "../src/core/cartridge.zum" as cartridge;
import "../src/core/ppu.zum" as ppu;
import "../src/testing/assert.zum" as test;
var cart << cartridge.load("fixtures/synthetic/nrom-256-chr-ram.nes");
var state << ppu.create(cart);
ppu.write(state, 0x0010, 0x80);
ppu.write(state, 0x2001, 0x01);
ppu.write(state, 0x3F01, 0x19);
ppu.cpuWrite(state, 5, 8);
ppu.cpuWrite(state, 5, 0);
ppu.cpuWrite(state, 1, 0x0A);
state["core"].scanline << 0;
state["core"].dot << 1;
ppu.tick(state);
test.assertInt(toInt(state["framebuffer"][0]), 0x19, "horizontal scroll selects next tile");
show("ppu_scroll_test: ok");
