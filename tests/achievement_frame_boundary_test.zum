import "../src/achievements/catalog.zum" as catalog;
import "../src/achievements/engine.zum" as achievements;
import "../src/core/cartridge.zum" as cartridge;
import "../src/core/console.zum" as console;
import "../src/persistence/store.zum" as store;
import "../src/testing/assert.zum" as test;
var db << store.memory();
var cart << cartridge.load("fixtures/synthetic/z22-playable-loop.nes");
var machine << console.create(cart);
console.runFrame(machine, 200000);
store.seedAchievements(db, cart["info"].digest, catalog.defaults());
var unlocked << achievements.evaluate(db, cart["info"].digest, machine, 1, 0, 0, 1u64);
test.assertInt(sizeOf(unlocked), 1, "one frame only unlocks first-frame");
test.assertString(unlocked[0]["id"], "first-frame", "first frame achievement id");
store.close(db);
show("achievement_frame_boundary_test: ok");
