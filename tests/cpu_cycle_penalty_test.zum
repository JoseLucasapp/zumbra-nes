import "../src/testing/assert.zum" as test;
import "../src/testing/cpu_fixture.zum" as fixture;
var readMachine << fixture.createMachine(0x8000,[0xA2u8, 0x01u8, 0xBDu8, 0xFFu8, 0x5Fu8]);
var readCpu << readMachine["cpu"];
var readBus << readMachine["bus"];
fixture.writeByte(readBus, 0x6000, 0x42);
readCpu.step(readBus);
var readCycles << readCpu.step(readBus);
test.assertInt(readCycles, 5, "absolute X read page penalty");
test.assertInt(readCpu.a, 0x42, "absolute X crossed read");
var storeMachine << fixture.createMachine(0x8000,[0xA2u8, 0x01u8, 0xA9u8, 0x77u8, 0x9Du8, 0xFFu8, 0x5Fu8]);
var storeCpu << storeMachine["cpu"];
var storeBus << storeMachine["bus"];
storeCpu.step(storeBus);
storeCpu.step(storeBus);
var storeCycles << storeCpu.step(storeBus);
test.assertInt(storeCycles, 5, "absolute X store fixed cycles");
test.assertInt(fixture.readByte(storeBus, 0x6000), 0x77, "absolute X crossed store");
var indirectMachine << fixture.createMachine(0x8000,[0xA0u8, 0x01u8, 0xB1u8, 0x20u8]);
var indirectCpu << indirectMachine["cpu"];
var indirectBus << indirectMachine["bus"];
fixture.writeByte(indirectBus, 0x20, 0xFF);
fixture.writeByte(indirectBus, 0x21, 0x5F);
fixture.writeByte(indirectBus, 0x6000, 0x55);
indirectCpu.step(indirectBus);
var indirectCycles << indirectCpu.step(indirectBus);
test.assertInt(indirectCycles, 6, "indirect indexed page penalty");
test.assertInt(indirectCpu.a, 0x55, "indirect indexed crossed read");
show("cpu_cycle_penalty_test: ok");
