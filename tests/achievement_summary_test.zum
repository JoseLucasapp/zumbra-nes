import "../src/achievements/offline.zum" as offline;
import "../src/achievements/engine.zum" as engine;
import "../src/core/cartridge.zum" as cartridge;
import "../src/core/console.zum" as console;
import "../src/persistence/store.zum" as store;
import "../src/testing/assert.zum" as test;
var db << store.memory();
var cart << cartridge.load("fixtures/synthetic/nrom-128-horizontal.nes");
var machine << console.create(cart);
var digest << cart["info"].digest;
offline.install(db, cart["info"], 1u64);
engine.evaluate(db, digest, machine, 1, 1, 0, 2u64);
var summary << offline.summary(db, digest);
test.assertInt(summary["total"], 5, "total achievements");
test.assertInt(summary["unlocked"], 2, "first frame and input unlocked");
test.assertInt(summary["locked"], 3, "remaining locked");
test.assertInt(summary["percent"], 40, "completion percent");
test.assertInt(sizeOf(store.unlockedAchievements(db, digest)), 2, "unlocked query");
test.assertInt(sizeOf(store.lockedAchievements(db, digest)), 3, "locked query");
store.close(db);
show("achievement_summary_test: ok");
