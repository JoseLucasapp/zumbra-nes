import "../src/core/cartridge.zum" as cartridge;
import "../src/core/console.zum" as console;
import "../src/testing/assert.zum" as test;
var cart << cartridge.load("fixtures/synthetic/nrom-128-horizontal.nes");
var machine << console.create(cart);
test.assertU64(machine["core"].cpuCycles, 7u64, "reset CPU cycles");
test.assertU64(machine["core"].ppuCycles, 21u64, "reset PPU cycles");
test.assertU64(machine["core"].apuCycles, 7u64, "reset APU cycles");
console.stepInstruction(machine);
console.stepInstruction(machine);
test.assertInt(machine["cpu"].a, 1, "CPU instruction integration");
test.assertU64(machine["core"].cpuCycles, 11u64, "CPU scheduler cycles");
test.assertU64(machine["core"].ppuCycles, 33u64, "three PPU clocks per CPU cycle");
test.assertU64(machine["core"].apuCycles, 11u64, "one APU clock per CPU cycle");
show("console_sync_test: ok");
