import "../src/core/mapper.zum" as mapper;
import "../src/testing/assert.zum" as test;
var state << mapper.create(4u16, 0u8, 131072, 65536, true, "vertical");
mapper.cpuWrite(state, 0x8000, 0x06, 131072);
mapper.cpuWrite(state, 0x8001, 0x03, 131072);
mapper.cpuWrite(state, 0x8000, 0x07, 131072);
mapper.cpuWrite(state, 0x8001, 0x04, 131072);
test.assertInt(mapper.cpuRead(state, 0x8000, 131072).offset, 3 * 8192, "MMC3 R6 PRG bank");
test.assertInt(mapper.cpuRead(state, 0xA000, 131072).offset, 4 * 8192, "MMC3 R7 PRG bank");
test.assertInt(mapper.cpuRead(state, 0xC000, 131072).offset, 14 * 8192, "MMC3 second-last fixed bank");
mapper.cpuWrite(state, 0x8000, 0x00, 131072);
mapper.cpuWrite(state, 0x8001, 0x04, 131072);
test.assertInt(mapper.ppuRead(state, 0x0000, 65536).offset, 4 * 1024, "MMC3 2K CHR bank first half");
test.assertInt(mapper.ppuRead(state, 0x0400, 65536).offset, 5 * 1024, "MMC3 2K CHR bank second half");
mapper.cpuWrite(state, 0xA000, 1, 131072);
test.assertString(mapper.mirroring(state, "vertical"), "horizontal", "MMC3 mirroring");
mapper.cpuWrite(state, 0xC000, 2, 131072);
mapper.cpuWrite(state, 0xC001, 0, 131072);
mapper.cpuWrite(state, 0xE001, 0, 131072);
mapper.clockScanline(state);
mapper.clockScanline(state);
mapper.clockScanline(state);
test.assertBool(mapper.irqLine(state), "MMC3 IRQ after countdown");
mapper.cpuWrite(state, 0xE000, 0, 131072);
test.assertBool(!mapper.irqLine(state), "MMC3 IRQ acknowledge");
show("mapper4_test: ok");
