import "../src/core/cpu6502.zum" as cpu6502;
import "../src/testing/assert.zum" as test;
import "../src/testing/cpu_fixture.zum" as fixture;
var machine << fixture.createMachine(0x8000,[0xA9u8, 0x50u8, 0x69u8, 0x50u8, 0x69u8, 0x70u8, 0x38u8, 0xE9u8, 0x01u8, 0xE9u8, 0x20u8]);
var processor << machine["cpu"];
var systemBus << machine["bus"];
processor.step(systemBus);
processor.step(systemBus);
test.assertInt(processor.a, 0xA0, "ADC result");
test.assertBool(processor.getFlag(cpu6502.FLAG_OVERFLOW), "ADC overflow");
test.assertBool(processor.getFlag(cpu6502.FLAG_NEGATIVE), "ADC negative");
test.assertBool(!processor.getFlag(cpu6502.FLAG_CARRY), "ADC no carry");
processor.step(systemBus);
test.assertInt(processor.a, 0x10, "ADC wrapped result");
test.assertBool(processor.getFlag(cpu6502.FLAG_CARRY), "ADC carry");
test.assertBool(!processor.getFlag(cpu6502.FLAG_OVERFLOW), "ADC no signed overflow");
processor.step(systemBus);
processor.step(systemBus);
test.assertInt(processor.a, 0x0F, "SBC without borrow");
test.assertBool(processor.getFlag(cpu6502.FLAG_CARRY), "SBC no borrow flag");
processor.step(systemBus);
test.assertInt(processor.a, 0xEF, "SBC borrow result");
test.assertBool(!processor.getFlag(cpu6502.FLAG_CARRY), "SBC borrow flag");
test.assertBool(processor.getFlag(cpu6502.FLAG_NEGATIVE), "SBC negative");
show("cpu_arithmetic_test: ok");
