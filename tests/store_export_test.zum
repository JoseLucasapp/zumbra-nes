import "../src/persistence/store.zum" as store;
import "../src/testing/assert.zum" as test;
var path << "build/z22-export-test.json";
var db << store.memory();
store.saveSetting(db, "scale", 4);
store.exportJson(db, path);
test.assertBool(fileExists(path), "export file exists");
var imported << store.readImport(path);
test.assertInt(sizeOf(imported["settings"]), 1, "exported settings readable");
store.close(db);
show("store_export_test: ok");
