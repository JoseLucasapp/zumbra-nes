import "../src/core/cartridge.zum" as cartridge;
import "../src/core/ppu.zum" as ppu;
import "../src/testing/assert.zum" as test;
var cart << cartridge.load("fixtures/synthetic/nrom-256-chr-ram.nes");
var state << ppu.create(cart);
ppu.write(state, 0x0001, 0x80);
ppu.write(state, 0x0010, 0x80);
ppu.write(state, 0x2000, 0x00);
ppu.write(state, 0x3F01, 0x11);
ppu.write(state, 0x3F11, 0x30);
state["oam"][0] << 0u8;
state["oam"][1] << 1u8;
state["oam"][2] << 0u8;
state["oam"][3] << 0u8;
ppu.cpuWrite(state, 1, 0x1E);
state["core"].scanline << 1;
state["core"].dot << 1;
ppu.tick(state);
test.assertInt(toInt(state["framebuffer"][256]), 0x30, "sprite pixel wins priority");
test.assertBool((state["core"].status band 0x40) != 0, "sprite zero hit");
show("ppu_sprite_test: ok");
