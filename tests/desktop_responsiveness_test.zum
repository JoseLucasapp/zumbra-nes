import "../src/core/cartridge.zum" as cartridge;
import "../src/core/console.zum" as console;
import "../src/testing/assert.zum" as test;
var machine << console.create(cartridge.load("fixtures/synthetic/visible-frame.nes"));
var first << console.runFrameSlice(machine, 8);
test.assertBool(first["executed"] <= 8, "slice respects instruction budget");
test.assertBool(!first["frameComplete"], "small slice returns before frame completion");
var total << first["executed"];
var complete << false;
while (!complete and total < 200000) {
    var slice << console.runFrameSlice(machine, 512);
    total << total + slice["executed"];
    complete << slice["frameComplete"];
}
test.assertBool(complete, "cooperative slices eventually complete a frame");
test.assertU64(machine["core"].frames, 1u64, "sliced frame increments frame counter");
console.clearFrameComplete(machine);
test.assertBool(!console.frameComplete(machine), "frame flag can be cleared between desktop slices");
show("desktop_responsiveness_test: ok");
