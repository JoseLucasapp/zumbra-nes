import "../src/core/cartridge.zum" as cartridge;
import "../src/core/ppu.zum" as ppu;
import "../src/testing/assert.zum" as test;
var horizontalCart << cartridge.load("fixtures/synthetic/nrom-128-horizontal.nes");
var horizontal << ppu.create(horizontalCart);
ppu.write(horizontal, 0x2000, 0x31);
test.assertInt(ppu.read(horizontal, 0x2400), 0x31, "horizontal table 0/1 mirror");
ppu.write(horizontal, 0x2800, 0x42);
test.assertInt(ppu.read(horizontal, 0x2C00), 0x42, "horizontal table 2/3 mirror");
test.assertInt(ppu.read(horizontal, 0x2000), 0x31, "horizontal second physical table");
ppu.write(horizontal, 0x3F10, 0x2A);
test.assertInt(ppu.read(horizontal, 0x3F00), 0x2A, "universal palette mirror");
test.assertBool(!ppu.write(horizontal, 0x0010, 0xAA), "CHR ROM is read only");
var verticalCart << cartridge.load("fixtures/synthetic/nrom-256-chr-ram.nes");
var vertical << ppu.create(verticalCart);
ppu.write(vertical, 0x2000, 0x11);
test.assertInt(ppu.read(vertical, 0x2800), 0x11, "vertical table 0/2 mirror");
ppu.write(vertical, 0x2400, 0x22);
test.assertInt(ppu.read(vertical, 0x2C00), 0x22, "vertical table 1/3 mirror");
test.assertBool(ppu.write(vertical, 0x0010, 0xAA), "CHR RAM is writable");
test.assertInt(ppu.read(vertical, 0x0010), 0xAA, "CHR RAM readback");
show("ppu_memory_test: ok");
