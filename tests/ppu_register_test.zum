import "../src/core/cartridge.zum" as cartridge;
import "../src/core/ppu.zum" as ppu;
import "../src/testing/assert.zum" as test;
var cart << cartridge.load("fixtures/synthetic/nrom-256-chr-ram.nes");
var state << ppu.create(cart);
ppu.cpuWrite(state, 0, 0x84);
ppu.cpuWrite(state, 5, 0x2B);
ppu.cpuWrite(state, 5, 0x45);
test.assertInt(state["core"].control, 0x84, "PPUCTRL stored");
test.assertInt(state["core"].fineX, 3, "fine X scroll");
test.assertInt(state["core"].scrollX, 0x2B, "scroll X");
test.assertInt(state["core"].scrollY, 0x45, "scroll Y");
test.assertBool(!state["core"].writeToggle, "second scroll write resets latch");
ppu.cpuWrite(state, 6, 0x3F);
ppu.cpuWrite(state, 6, 0x00);
ppu.cpuWrite(state, 7, 0x2C);
test.assertInt(ppu.read(state, 0x3F00), 0x2C, "PPUDATA palette write");
test.assertInt(state["core"].v, 0x3F20, "PPUDATA increment by 32");
ppu.cpuWrite(state, 3, 0xFE);
ppu.cpuWrite(state, 4, 0x77);
ppu.cpuWrite(state, 4, 0x88);
test.assertInt(toInt(state["oam"][0xFE]), 0x77, "OAMDATA first write");
test.assertInt(toInt(state["oam"][0xFF]), 0x88, "OAMDATA second write");
test.assertInt(state["core"].oamAddress, 0, "OAMADDR wraps");
state["core"].status << 0xE0;
ppu.cpuWrite(state, 5, 0x10);
var status << ppu.cpuRead(state, 2);
test.assertBool((status band 0xE0) == 0xE0, "PPUSTATUS flags");
test.assertBool((state["core"].status band 0x80) == 0, "status read clears VBlank");
test.assertBool(!state["core"].writeToggle, "status read resets write latch");
show("ppu_register_test: ok");
