fct intSetting(db, key, fallback) {
    var fallbackText << toString(fallback);
    var value << setting(db, key, fallbackText);
    intSettingValue(value, fallback);
}
fct boolSetting(db, key, fallback) {
    var fallbackText << "0";
    if (fallback) {
        fallbackText << "1";
    }
    var value << setting(db, key, fallbackText);
    if (value == "1" or value == "true") {
        return true;
    }
    if (value == "0" or value == "false") {
        return false;
    }
    return fallback;
}
pub fct saveSettings(db, value) {
    saveSetting(db, "scale", value.scale);
    saveSetting(db, "vsync", value.vsync);
    saveSetting(db, "fullscreen", value.fullscreen);
    saveSetting(db, "volume", value.volume);
    saveSetting(db, "muted", value.muted);
    saveSetting(db, "showFps", value.showFps);
    saveSetting(db, "unlimited", value.unlimited);
    saveSetting(db, "p1A", value.p1A);
    saveSetting(db, "p1B", value.p1B);
    saveSetting(db, "p1Select", value.p1Select);
    saveSetting(db, "p1Start", value.p1Start);
    saveSetting(db, "p1Up", value.p1Up);
    saveSetting(db, "p1Down", value.p1Down);
    saveSetting(db, "p1Left", value.p1Left);
    saveSetting(db, "p1Right", value.p1Right);
    saveSetting(db, "p2A", value.p2A);
    saveSetting(db, "p2B", value.p2B);
    saveSetting(db, "p2Select", value.p2Select);
    saveSetting(db, "p2Start", value.p2Start);
    saveSetting(db, "p2Up", value.p2Up);
    saveSetting(db, "p2Down", value.p2Down);
    saveSetting(db, "p2Left", value.p2Left);
    saveSetting(db, "p2Right", value.p2Right);
    true;
}
pub fct loadSettings(db) {
    var defaults << settings.defaults();
    var scale << intSetting(db, "scale", defaults.scale);
    var vsync << boolSetting(db, "vsync", defaults.vsync);
    var fullscreen << boolSetting(db, "fullscreen", defaults.fullscreen);
    var volume << intSetting(db, "volume", defaults.volume);
    var muted << boolSetting(db, "muted", defaults.muted);
    var showFps << boolSetting(db, "showFps", defaults.showFps);
    var unlimited << boolSetting(db, "unlimited", defaults.unlimited);
    var p1A << intSetting(db, "p1A", defaults.p1A);
    var p1B << intSetting(db, "p1B", defaults.p1B);
    var p1Select << intSetting(db, "p1Select", defaults.p1Select);
    var p1Start << intSetting(db, "p1Start", defaults.p1Start);
    var p1Up << intSetting(db, "p1Up", defaults.p1Up);
    var p1Down << intSetting(db, "p1Down", defaults.p1Down);
    var p1Left << intSetting(db, "p1Left", defaults.p1Left);
    var p1Right << intSetting(db, "p1Right", defaults.p1Right);
    var p2A << intSetting(db, "p2A", defaults.p2A);
    var p2B << intSetting(db, "p2B", defaults.p2B);
    var p2Select << intSetting(db, "p2Select", defaults.p2Select);
    var p2Start << intSetting(db, "p2Start", defaults.p2Start);
    var p2Up << intSetting(db, "p2Up", defaults.p2Up);
    var p2Down << intSetting(db, "p2Down", defaults.p2Down);
    var p2Left << intSetting(db, "p2Left", defaults.p2Left);
    var p2Right << intSetting(db, "p2Right", defaults.p2Right);
    settings.create(scale, vsync, fullscreen, volume, muted, showFps, unlimited, p1A, p1B, p1Select, p1Start, p1Up, p1Down, p1Left, p1Right, p2A, p2B, p2Select, p2Start, p2Up, p2Down, p2Left, p2Right);
}
pub fct recordRom(db, info, openedAt) {
    database.exec(db, "INSERT INTO rom_library(digest, path, title, mapper, last_opened, created_at) VALUES (:digest, :path, :title, :mapper, :opened, :opened) ON CONFLICT(digest) DO UPDATE SET path = excluded.path, title = excluded.title, mapper = excluded.mapper, last_opened = excluded.last_opened", {
        "digest": info.digest, "path": info.sourcePath, "title": info.sourcePath, "mapper": info.header.mapper, "opened": openedAt
    });
}
pub fct recentRoms(db, limit) {
    database.query(db, "SELECT digest, path, title, mapper, last_opened, play_seconds, sessions FROM rom_library ORDER BY last_opened DESC LIMIT :limit", {
        "limit": limit
    });
}

/// Upserts one local ROM compatibility record without touching play history.
pub fct recordCompatibility(db, info, mapperName, status, statusSource, videoStatus, audioStatus, inputStatus, saveSupport, achievementSupport, knownIssues, timestamp) {
    var sql << "INSERT INTO rom_compatibility(rom_digest, image_crc32, content_crc32, mapper, submapper, mapper_name, rom_format, status, status_source, video_status, audio_status, input_status, save_support, achievement_support, known_issues, created_at, updated_at) ";
    sql << sql + "VALUES (:digest, :imageCrc, :contentCrc, :mapper, :submapper, :mapperName, :format, :status, :source, :video, :audio, :input, :save, :achievements, :issues, :created, :updated) ";
    sql << sql + "ON CONFLICT(rom_digest) DO UPDATE SET image_crc32 = excluded.image_crc32, content_crc32 = excluded.content_crc32, mapper = excluded.mapper, submapper = excluded.submapper, mapper_name = excluded.mapper_name, rom_format = excluded.rom_format, status = CASE WHEN rom_compatibility.status IN ('perfect','playable','issues') AND excluded.status = 'untested' THEN rom_compatibility.status ELSE excluded.status END, status_source = CASE WHEN rom_compatibility.status IN ('perfect','playable','issues') AND excluded.status = 'untested' THEN rom_compatibility.status_source ELSE excluded.status_source END, save_support = excluded.save_support, achievement_support = excluded.achievement_support, known_issues = CASE WHEN rom_compatibility.known_issues != '' AND excluded.known_issues = '' THEN rom_compatibility.known_issues ELSE excluded.known_issues END, updated_at = excluded.updated_at";
    database.exec(db, sql, {
        "digest": info.digest, "imageCrc": info.imageCrc32, "contentCrc": info.contentCrc32, "mapper": info.header.mapper, "submapper": info.header.submapper, "mapperName": mapperName, "format": info.header.format, "status": status, "source": statusSource, "video": videoStatus, "audio": audioStatus, "input": inputStatus, "save": saveSupport, "achievements": achievementSupport, "issues": knownIssues, "created": timestamp, "updated": timestamp
    });
    true;
}

/// Marks one successful local gameplay session as an emulator compatibility observation.
pub fct recordCompatibilitySession(db, digest, status, videoStatus, audioStatus, inputStatus, testedAt, frame) {
    database.exec(db, "UPDATE rom_compatibility SET status = CASE WHEN status IN ('perfect','issues','unsupported') THEN status ELSE :status END, status_source = CASE WHEN status IN ('perfect','issues','unsupported') THEN status_source ELSE 'automatic-session' END, video_status = :video, audio_status = :audio, input_status = :input, last_tested = :tested, test_count = test_count + 1, last_frame = :frame, updated_at = :tested WHERE rom_digest = :digest", {
        "status": status, "video": videoStatus, "audio": audioStatus, "input": inputStatus, "tested": testedAt, "frame": frame, "digest": digest
    });
    true;
}

/// Applies a local/manual compatibility review while retaining automatic observations.
pub fct reviewCompatibility(db, digest, status, knownIssues, timestamp) {
    database.exec(db, "UPDATE rom_compatibility SET status = :status, status_source = 'local-review', known_issues = :issues, updated_at = :updated WHERE rom_digest = :digest", {
        "status": status, "issues": knownIssues, "updated": timestamp, "digest": digest
    });
    true;
}

/// Returns one compatibility record with a stable shape for VM/native callers.
pub fct compatibilityRecord(db, digest) {
    var rows << database.query(db, "SELECT rom_digest, image_crc32, content_crc32, mapper, submapper, mapper_name, rom_format, status, status_source, video_status, audio_status, input_status, save_support, achievement_support, known_issues, last_tested, test_count, last_frame, created_at, updated_at FROM rom_compatibility WHERE rom_digest = :digest LIMIT 1", {
        "digest": digest
    });
    if (sizeOf(rows) == 0) {
        return {
            "rom_digest": digest, "image_crc32": 0, "content_crc32": 0, "mapper": 0, "submapper": 0, "mapper_name": "", "rom_format": "", "status": "untested", "status_source": "none", "video_status": "unknown", "audio_status": "unknown", "input_status": "unknown", "save_support": "unknown", "achievement_support": "none", "known_issues": "", "last_tested": 0, "test_count": 0, "last_frame": 0, "created_at": 0, "updated_at": 0
        };
    }
    return rows[0];
}
pub fct compatibilityRows(db) {
    database.query(db, "SELECT rom_digest, image_crc32, content_crc32, mapper, submapper, mapper_name, rom_format, status, status_source, video_status, audio_status, input_status, save_support, achievement_support, known_issues, last_tested, test_count, last_frame, created_at, updated_at FROM rom_compatibility ORDER BY updated_at DESC, rom_digest", {
    });
}
pub fct compatibilityCount(db, status) {
    var rows << database.query(db, "SELECT COUNT(*) AS total FROM rom_compatibility", {
    });
    if (status != "all") {
        rows << database.query(db, "SELECT COUNT(*) AS total FROM rom_compatibility WHERE status = :status", {
            "status": status
        });
    }
    if (sizeOf(rows) == 0) {
        return 0;
    }
    return toInt(rows[0]["total"]);
}

/// Standalone compatibility-report payload; achievement/save backups remain separate.
pub fct compatibilitySnapshot(db, generatedAt) {
    return {
        "format": "zumbra-nes-compatibility", "version": 1, "generated_at": generatedAt, "records": compatibilityRows(db)
    };
}
pub fct exportCompatibilityJson(db, path, generatedAt) {
    data.writeJson(path, compatibilitySnapshot(db, generatedAt), true);
    return fileExists(path);
}
pub fct importCompatibilitySnapshot(db, snapshot) {
    if (snapshot["format"] != "zumbra-nes-compatibility" or toInt(snapshot["version"]) != 1) {
        return false;
    }
    var rows << snapshot["records"];
    var index << 0;
    while (index < sizeOf(rows)) {
        var row << rows[index];
        var sql << "INSERT INTO rom_compatibility(rom_digest, image_crc32, content_crc32, mapper, submapper, mapper_name, rom_format, status, status_source, video_status, audio_status, input_status, save_support, achievement_support, known_issues, last_tested, test_count, last_frame, created_at, updated_at) ";
        sql << sql + "VALUES (:rom_digest, :image_crc32, :content_crc32, :mapper, :submapper, :mapper_name, :rom_format, :status, 'imported', :video_status, :audio_status, :input_status, :save_support, :achievement_support, :known_issues, :last_tested, :test_count, :last_frame, :created_at, :updated_at) ";
        sql << sql + "ON CONFLICT(rom_digest) DO UPDATE SET image_crc32 = excluded.image_crc32, content_crc32 = excluded.content_crc32, mapper = excluded.mapper, submapper = excluded.submapper, mapper_name = excluded.mapper_name, rom_format = excluded.rom_format, status = excluded.status, status_source = 'imported', video_status = excluded.video_status, audio_status = excluded.audio_status, input_status = excluded.input_status, save_support = excluded.save_support, achievement_support = excluded.achievement_support, known_issues = excluded.known_issues, last_tested = excluded.last_tested, test_count = excluded.test_count, last_frame = excluded.last_frame, updated_at = excluded.updated_at";
        database.exec(db, sql, {
            "rom_digest": row["rom_digest"], "image_crc32": row["image_crc32"], "content_crc32": row["content_crc32"], "mapper": row["mapper"], "submapper": row["submapper"], "mapper_name": row["mapper_name"], "rom_format": row["rom_format"], "status": row["status"], "video_status": row["video_status"], "audio_status": row["audio_status"], "input_status": row["input_status"], "save_support": row["save_support"], "achievement_support": row["achievement_support"], "known_issues": row["known_issues"], "last_tested": row["last_tested"], "test_count": row["test_count"], "last_frame": row["last_frame"], "created_at": row["created_at"], "updated_at": row["updated_at"]
        });
        index << index + 1;
    }
    return true;
}
pub fct importCompatibilityJson(db, path) {
    if (!fileExists(path)) {
        return false;
    }
    return importCompatibilitySnapshot(db, data.readJson(path));
}
fct libraryFilterSql(filter) {
    if (filter == "known") {
        return " AND COALESCE(progress.total, 0) > 0";
    }
    if (filter == "in-progress") {
        return " AND COALESCE(progress.total, 0) > 0 AND COALESCE(progress.unlocked, 0) > 0 AND COALESCE(progress.unlocked, 0) < COALESCE(progress.total, 0)";
    }
    if (filter == "completed") {
        return " AND COALESCE(progress.total, 0) > 0 AND COALESCE(progress.unlocked, 0) = COALESCE(progress.total, 0)";
    }
    if (filter == "no-pack") {
        return " AND COALESCE(progress.total, 0) = 0";
    }
    return "";
}
fct librarySortSql(sort) {
    if (sort == "title") {
        return " ORDER BY display_title COLLATE NOCASE ASC, r.last_opened DESC";
    }
    if (sort == "progress") {
        return " ORDER BY achievement_percent DESC, achievement_unlocked DESC, r.last_opened DESC";
    }
    if (sort == "playtime") {
        return " ORDER BY r.play_seconds DESC, r.last_opened DESC";
    }
    if (sort == "sessions") {
        return " ORDER BY r.sessions DESC, r.last_opened DESC";
    }
    return " ORDER BY r.last_opened DESC";
}
fct libraryFromSql() {
    var sql << " FROM rom_library r LEFT JOIN achievement_game_metadata meta ON meta.game_digest = r.digest ";
    sql << sql + "LEFT JOIN rom_compatibility compat ON compat.rom_digest = r.digest ";
    sql << sql + "LEFT JOIN (SELECT game_digest, COUNT(*) AS total, SUM(CASE WHEN unlocked = 1 THEN 1 ELSE 0 END) AS unlocked FROM achievement_progress GROUP BY game_digest) progress ON progress.game_digest = r.digest ";
    return sql;
}
fct libraryCompatibilityFilterSql(filter) {
    if (filter == "perfect") {
        return " AND COALESCE(compat.status, 'untested') = 'perfect'";
    }
    if (filter == "playable") {
        return " AND COALESCE(compat.status, 'untested') = 'playable'";
    }
    if (filter == "issues") {
        return " AND COALESCE(compat.status, 'untested') = 'issues'";
    }
    if (filter == "unsupported") {
        return " AND COALESCE(compat.status, 'untested') = 'unsupported'";
    }
    if (filter == "untested") {
        return " AND COALESCE(compat.status, 'untested') = 'untested'";
    }
    return "";
}
fct libraryWhereSql(filter, compatibilityFilter) {
    var sql << " WHERE (LOWER(CASE WHEN COALESCE(meta.source, 'none') != 'none' THEN meta.title ELSE r.title END) LIKE LOWER(:search) OR LOWER(r.path) LIKE LOWER(:search))";
    sql << sql + libraryFilterSql(filter);
    sql << sql + libraryCompatibilityFilterSql(compatibilityFilter);
    return sql;
}
fct librarySelectSql() {
    var sql << "SELECT r.digest, r.path, CASE WHEN COALESCE(meta.source, 'none') != 'none' THEN meta.title ELSE r.title END AS display_title, r.title AS library_title, r.mapper, r.last_opened, r.play_seconds, r.sessions, ";
    sql << sql + "COALESCE(meta.source, 'none') AS pack_source, COALESCE(meta.pack_version, 0) AS pack_version, COALESCE(progress.total, 0) AS achievement_total, COALESCE(progress.unlocked, 0) AS achievement_unlocked, ";
    sql << sql + "CASE WHEN COALESCE(progress.total, 0) > 0 THEN (COALESCE(progress.unlocked, 0) * 100) / progress.total ELSE 0 END AS achievement_percent, ";
    sql << sql + "COALESCE(compat.status, 'untested') AS compatibility_status, COALESCE(compat.status_source, 'none') AS compatibility_source, COALESCE(compat.mapper_name, '') AS mapper_name, COALESCE(compat.submapper, 0) AS submapper, COALESCE(compat.rom_format, '') AS rom_format, COALESCE(compat.image_crc32, 0) AS image_crc32, COALESCE(compat.content_crc32, 0) AS content_crc32, COALESCE(compat.video_status, 'unknown') AS video_status, COALESCE(compat.audio_status, 'unknown') AS audio_status, COALESCE(compat.input_status, 'unknown') AS input_status, COALESCE(compat.save_support, 'unknown') AS save_support, COALESCE(compat.achievement_support, 'none') AS achievement_support, COALESCE(compat.known_issues, '') AS known_issues, COALESCE(compat.last_tested, 0) AS last_tested, COALESCE(compat.test_count, 0) AS compatibility_tests, COALESCE(compat.last_frame, 0) AS compatibility_last_frame";
    return sql;
} /// Returns the local game library with achievement progress, search, filtering and sorting.
pub fct libraryRowsCompat(db, filter, compatibilityFilter, sort, search, limit, offset) {
    var sql << librarySelectSql() + libraryFromSql() + libraryWhereSql(filter, compatibilityFilter) + librarySortSql(sort) + " LIMIT :limit OFFSET :offset";
    return database.query(db, sql, {
        "search": "%" + search + "%", "limit": limit, "offset": offset
    });
}
pub fct libraryRows(db, filter, sort, search, limit, offset) {
    return libraryRowsCompat(db, filter, "all", sort, search, limit, offset);
} /// Returns the number of local library entries matching the current search/filter.
pub fct libraryCountCompat(db, filter, compatibilityFilter, search) {
    var sql << "SELECT COUNT(*) AS total" + libraryFromSql() + libraryWhereSql(filter, compatibilityFilter);
    var rows << database.query(db, sql, {
        "search": "%" + search + "%"
    });
    if (sizeOf(rows) == 0) {
        return 0;
    }
    return toInt(rows[0]["total"]);
}
pub fct libraryCount(db, filter, search) {
    return libraryCountCompat(db, filter, "all", search);
} /// Returns one local library entry with achievement and play statistics.
pub fct libraryGame(db, digest) {
    var sql << librarySelectSql() + libraryFromSql() + " WHERE r.digest = :digest LIMIT 1";
    var rows << database.query(db, sql, {
        "digest": digest
    });
    if (sizeOf(rows) == 0) {
        return {
            "digest": digest, "path": "", "display_title": "UNKNOWN ROM", "library_title": "", "mapper": 0, "last_opened": 0, "play_seconds": 0, "sessions": 0, "pack_source": "none", "pack_version": 0, "achievement_total": 0, "achievement_unlocked": 0, "achievement_percent": 0, "compatibility_status": "untested", "compatibility_source": "none", "mapper_name": "", "submapper": 0, "rom_format": "", "image_crc32": 0, "content_crc32": 0, "video_status": "unknown", "audio_status": "unknown", "input_status": "unknown", "save_support": "unknown", "achievement_support": "none", "known_issues": "", "last_tested": 0, "compatibility_tests": 0, "compatibility_last_frame": 0
        };
    }
    return rows[0];
} /// Returns achievement rows for the library detail screen.
pub fct libraryAchievementRows(db, digest, filter) {
    var condition << "";
    if (filter == "locked") {
        condition << " AND p.unlocked = 0";
    }
    if (filter == "unlocked") {
        condition << " AND p.unlocked = 1";
    }
    var sql << "SELECT d.achievement_id AS id, d.title, d.description, d.target, p.progress, p.unlocked, p.unlocked_at FROM achievement_definitions d JOIN achievement_progress p ON p.game_digest = d.game_digest AND p.achievement_id = d.achievement_id WHERE d.game_digest = :digest" + condition + " ORDER BY p.unlocked DESC, p.unlocked_at DESC, d.achievement_id";
    return database.query(db, sql, {
        "digest": digest
    });
} /// Returns recent completed sessions for one game, newest first.
pub fct librarySessionRows(db, digest, limit) {
    return database.query(db, "SELECT started_at, ended_at, seconds, frames FROM play_sessions WHERE rom_digest = :digest AND ended_at IS NOT NULL ORDER BY started_at DESC LIMIT :limit", {
        "digest": digest, "limit": limit
    });
}
pub fct mostRecentPath(db) {
    var rows << recentRoms(db, 1);
    if (sizeOf(rows) == 0) {
        return "";
    }
    rows[0]["path"];
}
pub fct beginSession(db, digest, startedAt) {
    var result << database.exec(db, "INSERT INTO play_sessions(rom_digest, started_at) VALUES (:digest, :started)", {
        "digest": digest, "started": startedAt
    });
    result["lastInsertId"];
}
pub fct finishSession(db, sessionId, digest, endedAt, seconds, frames) {
    database.exec(db, "UPDATE play_sessions SET ended_at = :ended, seconds = :seconds, frames = :frames WHERE id = :id", {
        "ended": endedAt, "seconds": seconds, "frames": frames, "id": sessionId
    });
    database.exec(db, "UPDATE rom_library SET play_seconds = play_seconds + :seconds, sessions = sessions + 1, last_opened = :ended WHERE digest = :digest", {
        "seconds": seconds, "ended": endedAt, "digest": digest
    });
    true;
}
pub fct achievementGameMetadata(db, digest) {
    database.query(db, "SELECT game_digest, title, source, pack_version, created_at, updated_at FROM achievement_game_metadata WHERE game_digest = :digest", {
        "digest": digest
    });
}
pub fct clearAchievementsForGame(db, digest) {
    database.exec(db, "DELETE FROM achievement_events WHERE game_digest = :digest", {
        "digest": digest
    });
    database.exec(db, "DELETE FROM achievement_progress WHERE game_digest = :digest", {
        "digest": digest
    });
    database.exec(db, "DELETE FROM achievement_definitions WHERE game_digest = :digest", {
        "digest": digest
    });
    true;
}
pub fct registerAchievementGame(db, digest, title, source, packVersion, timestamp) {
    database.exec(db, "INSERT INTO achievement_game_metadata(game_digest, title, source, pack_version, created_at, updated_at) VALUES (:digest, :title, :source, :packVersion, :created, :updated) ON CONFLICT(game_digest) DO UPDATE SET title = excluded.title, source = excluded.source, pack_version = excluded.pack_version, updated_at = excluded.updated_at", {
        "digest": digest, "title": title, "source": source, "packVersion": packVersion, "created": timestamp, "updated": timestamp
    });
    true;
}
pub fct seedAchievements(db, digest, definitions) {
    var index << 0;
    while (index < sizeOf(definitions)) {
        var item << definitions[index];
        var definitionSql << "INSERT INTO achievement_definitions(game_digest, achievement_id, title, description, rule_type, address, target) VALUES (:digest, :id, :title, :description, :type, :address, :target) ";
        definitionSql << definitionSql + "ON CONFLICT(game_digest, achievement_id) DO UPDATE SET title = excluded.title, description = excluded.description, rule_type = excluded.rule_type, address = excluded.address, target = excluded.target";
        database.exec(db, definitionSql, {
            "digest": digest, "id": item["id"], "title": item["title"], "description": item["description"], "type": item["type"], "address": item["address"], "target": item["target"]
        });
        database.exec(db, "INSERT OR IGNORE INTO achievement_progress(game_digest, achievement_id) VALUES (:digest, :id)", {
            "digest": digest, "id": item["id"]
        });
        index << index + 1;
    }
    true;
}
pub fct achievementRows(db, digest) {
    database.query(db, "SELECT d.achievement_id AS id, d.title, d.description, d.rule_type AS type, d.address, d.target, p.progress, p.unlocked, p.unlocked_at FROM achievement_definitions d JOIN achievement_progress p ON p.game_digest = d.game_digest AND p.achievement_id = d.achievement_id WHERE d.game_digest = :digest ORDER BY d.achievement_id", {
        "digest": digest
    });
}
pub fct unlockedAchievements(db, digest) {
    database.query(db, "SELECT d.achievement_id AS id, d.title, d.description, p.progress, p.unlocked_at FROM achievement_definitions d JOIN achievement_progress p ON p.game_digest = d.game_digest AND p.achievement_id = d.achievement_id WHERE d.game_digest = :digest AND p.unlocked = 1 ORDER BY p.unlocked_at DESC, d.achievement_id", {
        "digest": digest
    });
}
pub fct lockedAchievements(db, digest) {
    database.query(db, "SELECT d.achievement_id AS id, d.title, d.description, d.target, p.progress FROM achievement_definitions d JOIN achievement_progress p ON p.game_digest = d.game_digest AND p.achievement_id = d.achievement_id WHERE d.game_digest = :digest AND p.unlocked = 0 ORDER BY d.achievement_id", {
        "digest": digest
    });
}
pub fct achievementSummary(db, digest) {
    var rows << database.query(db, "SELECT COUNT(*) AS total, COUNT(CASE WHEN unlocked = 1 THEN 1 END) AS unlocked FROM achievement_progress WHERE game_digest = :digest", {
        "digest": digest
    });
    if (sizeOf(rows) == 0) {
        return {
            "digest": digest, "total": 0, "unlocked": 0, "locked": 0, "percent": 0
        };
    }
    var total << toInt(rows[0]["total"]);
    var unlocked << toInt(rows[0]["unlocked"]);
    var percent << 0;
    if (total > 0) {
        percent <<(unlocked * 100) / total;
    }
    return {
        "digest": digest, "total": total, "unlocked": unlocked, "locked": total - unlocked, "percent": percent
    };
}
pub fct updateAchievement(db, digest, id, progress, unlocked, unlockedAt) {
    database.exec(db, "UPDATE achievement_progress SET progress = CASE WHEN progress > :progress THEN progress ELSE :progress END, unlocked = CASE WHEN unlocked = 1 THEN 1 ELSE :unlocked END, unlocked_at = CASE WHEN unlocked_at > 0 THEN unlocked_at ELSE :unlockedAt END WHERE game_digest = :digest AND achievement_id = :id", {
        "progress": progress, "unlocked": unlocked, "unlockedAt": unlockedAt, "digest": digest, "id": id
    });
}
pub fct recordAchievementEvent(db, digest, id, title, description, unlockedAt) {
    database.exec(db, "INSERT INTO achievement_events(game_digest, achievement_id, title, description, unlocked_at) VALUES (:digest, :id, :title, :description, :unlockedAt)", {
        "digest": digest, "id": id, "title": title, "description": description, "unlockedAt": unlockedAt
    });
    true;
}
pub fct achievementEvents(db, digest, limit) {
    database.query(db, "SELECT game_digest, achievement_id, title, description, unlocked_at FROM achievement_events WHERE game_digest = :digest ORDER BY unlocked_at DESC, id DESC LIMIT :limit", {
        "digest": digest, "limit": limit
    });
}
pub fct achievementGameRows(db) {
    database.query(db, "SELECT game_digest, title, source, pack_version, created_at, updated_at FROM achievement_game_metadata ORDER BY updated_at DESC", {
    });
}

/// Records one file-backed save-state slot in the local library.
pub fct recordSaveState(db, digest, slot, path, updatedAt, frame) {
    database.exec(db, "INSERT INTO save_states(game_digest, slot, path, updated_at, frame) VALUES (:digest, :slot, :path, :updated, :frame) ON CONFLICT(game_digest, slot) DO UPDATE SET path = excluded.path, updated_at = excluded.updated_at, frame = excluded.frame", {
        "digest": digest, "slot": slot, "path": path, "updated": updatedAt, "frame": frame
    });
    true;
}
pub fct saveStateRows(db, digest) {
    database.query(db, "SELECT game_digest, slot, path, updated_at, frame FROM save_states WHERE game_digest = :digest ORDER BY slot", {
        "digest": digest
    });
}
pub fct snapshot(db) {
    {
        "settings": database.query(db, "SELECT key, value FROM settings ORDER BY key", {
        }), "roms": database.query(db, "SELECT * FROM rom_library ORDER BY last_opened DESC", {
        }), "achievementGames": database.query(db, "SELECT * FROM achievement_game_metadata ORDER BY game_digest", {
        }), "achievementDefinitions": database.query(db, "SELECT * FROM achievement_definitions ORDER BY game_digest, achievement_id", {
        }), "achievements": database.query(db, "SELECT * FROM achievement_progress ORDER BY game_digest, achievement_id", {
        }), "achievementEvents": database.query(db, "SELECT * FROM achievement_events ORDER BY game_digest, unlocked_at, id", {
        }), "saveStates": database.query(db, "SELECT * FROM save_states ORDER BY game_digest, slot", {
        })
    };
}
pub fct exportJson(db, path) {
    data.writeJson(path, snapshot(db), true);
}
pub fct readImport(path) {
    data.readJson(path);
}

/// Imports an exported snapshot into the current database.
pub fct importSnapshot(db, snapshot) {
    var settingRows << snapshot["settings"];
    var index << 0;
    while (index < sizeOf(settingRows)) {
        saveSetting(db, settingRows[index]["key"], settingRows[index]["value"]);
        index << index + 1;
    }
    var romRows << snapshot["roms"];
    index << 0;
    while (index < sizeOf(romRows)) {
        var row << romRows[index];
        var importRomSql << "INSERT INTO rom_library(digest, path, title, mapper, last_opened, play_seconds, sessions, created_at) VALUES (:digest, :path, :title, :mapper, :last_opened, :play_seconds, :sessions, :created_at) ";
        importRomSql << importRomSql + "ON CONFLICT(digest) DO UPDATE SET path = excluded.path, title = excluded.title, mapper = excluded.mapper, last_opened = excluded.last_opened, play_seconds = excluded.play_seconds, sessions = excluded.sessions";
        database.exec(db, importRomSql, row);
        index << index + 1;
    }
    var gameRows << snapshot["achievementGames"];
    index << 0;
    while (index < sizeOf(gameRows)) {
        var gameRow << gameRows[index];
        registerAchievementGame(db, gameRow["game_digest"], gameRow["title"], gameRow["source"], gameRow["pack_version"], gameRow["updated_at"]);
        index << index + 1;
    }
    var definitionRows << snapshot["achievementDefinitions"];
    index << 0;
    while (index < sizeOf(definitionRows)) {
        var definition << definitionRows[index];
        database.exec(db, "INSERT INTO achievement_definitions(game_digest, achievement_id, title, description, rule_type, address, target) VALUES (:game_digest, :achievement_id, :title, :description, :rule_type, :address, :target) ON CONFLICT(game_digest, achievement_id) DO UPDATE SET title = excluded.title, description = excluded.description, rule_type = excluded.rule_type, address = excluded.address, target = excluded.target", definition);
        database.exec(db, "INSERT OR IGNORE INTO achievement_progress(game_digest, achievement_id) VALUES (:game_digest, :achievement_id)", definition);
        index << index + 1;
    }
    var achievementRowsValue << snapshot["achievements"];
    index << 0;
    while (index < sizeOf(achievementRowsValue)) {
        var progress << achievementRowsValue[index];
        database.exec(db, "INSERT INTO achievement_progress(game_digest, achievement_id, progress, unlocked, unlocked_at) VALUES (:game_digest, :achievement_id, :progress, :unlocked, :unlocked_at) ON CONFLICT(game_digest, achievement_id) DO UPDATE SET progress = excluded.progress, unlocked = excluded.unlocked, unlocked_at = excluded.unlocked_at", progress);
        index << index + 1;
    }
    var eventRows << snapshot["achievementEvents"];
    index << 0;
    while (index < sizeOf(eventRows)) {
        var eventRow << eventRows[index];
        recordAchievementEvent(db, eventRow["game_digest"], eventRow["achievement_id"], eventRow["title"], eventRow["description"], eventRow["unlocked_at"]);
        index << index + 1;
    }
    var stateRows << snapshot["saveStates"];
    index << 0;
    while (index < sizeOf(stateRows)) {
        var stateRow << stateRows[index];
        recordSaveState(db, stateRow["game_digest"], stateRow["slot"], stateRow["path"], stateRow["updated_at"], stateRow["frame"]);
        index << index + 1;
    }
    true;
}
pub fct importJson(db, path) {
    importSnapshot(db, readImport(path));
}
