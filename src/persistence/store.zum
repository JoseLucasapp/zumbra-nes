import "../stdlib/database.zum" as database;
import "../stdlib/data.zum" as data;
import "../frontend/settings.zum" as settings;
fct migrations() {
    var coreSql << "CREATE TABLE IF NOT EXISTS settings (key TEXT PRIMARY KEY, value TEXT NOT NULL); ";
    coreSql << coreSql + "CREATE TABLE IF NOT EXISTS rom_library (digest TEXT PRIMARY KEY, path TEXT NOT NULL, title TEXT NOT NULL, mapper INTEGER NOT NULL, last_opened INTEGER NOT NULL, play_seconds INTEGER NOT NULL DEFAULT 0, sessions INTEGER NOT NULL DEFAULT 0, created_at INTEGER NOT NULL); ";
    coreSql << coreSql + "CREATE TABLE IF NOT EXISTS play_sessions (id INTEGER PRIMARY KEY AUTOINCREMENT, rom_digest TEXT NOT NULL, started_at INTEGER NOT NULL, ended_at INTEGER, seconds INTEGER NOT NULL DEFAULT 0, frames INTEGER NOT NULL DEFAULT 0);";
    var achievementSql << "CREATE TABLE IF NOT EXISTS achievement_definitions (game_digest TEXT NOT NULL, achievement_id TEXT NOT NULL, title TEXT NOT NULL, description TEXT NOT NULL, rule_type TEXT NOT NULL, address INTEGER NOT NULL DEFAULT 0, target INTEGER NOT NULL DEFAULT 0, PRIMARY KEY(game_digest, achievement_id)); ";
    achievementSql << achievementSql + "CREATE TABLE IF NOT EXISTS achievement_progress (game_digest TEXT NOT NULL, achievement_id TEXT NOT NULL, progress INTEGER NOT NULL DEFAULT 0, unlocked INTEGER NOT NULL DEFAULT 0, unlocked_at INTEGER NOT NULL DEFAULT 0, PRIMARY KEY(game_digest, achievement_id));";
    var indexSql << "CREATE INDEX IF NOT EXISTS rom_library_recent_idx ON rom_library(last_opened DESC); ";
    indexSql << indexSql + "CREATE INDEX IF NOT EXISTS play_sessions_rom_idx ON play_sessions(rom_digest, started_at DESC); ";
    indexSql << indexSql + "CREATE INDEX IF NOT EXISTS achievement_progress_game_idx ON achievement_progress(game_digest, unlocked, achievement_id);";
    var stateSql << "CREATE TABLE IF NOT EXISTS save_states (game_digest TEXT NOT NULL, slot INTEGER NOT NULL, path TEXT NOT NULL, updated_at INTEGER NOT NULL, frame INTEGER NOT NULL DEFAULT 0, PRIMARY KEY(game_digest, slot)); ";
    stateSql << stateSql + "CREATE INDEX IF NOT EXISTS save_states_game_idx ON save_states(game_digest, updated_at DESC);";
    var localAchievementSql << "CREATE TABLE IF NOT EXISTS achievement_game_metadata (game_digest TEXT PRIMARY KEY, title TEXT NOT NULL, source TEXT NOT NULL, pack_version INTEGER NOT NULL DEFAULT 1, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL); ";
    localAchievementSql << localAchievementSql + "CREATE TABLE IF NOT EXISTS achievement_events (id INTEGER PRIMARY KEY AUTOINCREMENT, game_digest TEXT NOT NULL, achievement_id TEXT NOT NULL, title TEXT NOT NULL, description TEXT NOT NULL, unlocked_at INTEGER NOT NULL); ";
    localAchievementSql << localAchievementSql + "CREATE INDEX IF NOT EXISTS achievement_events_game_idx ON achievement_events(game_digest, unlocked_at DESC);";
    var libraryUiSql << "CREATE INDEX IF NOT EXISTS rom_library_title_idx ON rom_library(title COLLATE NOCASE); ";
    libraryUiSql << libraryUiSql + "CREATE INDEX IF NOT EXISTS rom_library_playtime_idx ON rom_library(play_seconds DESC, last_opened DESC); ";
    libraryUiSql << libraryUiSql + "CREATE INDEX IF NOT EXISTS rom_library_sessions_idx ON rom_library(sessions DESC, last_opened DESC);";
    var compatibilitySql << "CREATE TABLE IF NOT EXISTS rom_compatibility (rom_digest TEXT PRIMARY KEY, image_crc32 INTEGER NOT NULL DEFAULT 0, content_crc32 INTEGER NOT NULL DEFAULT 0, mapper INTEGER NOT NULL, submapper INTEGER NOT NULL DEFAULT 0, mapper_name TEXT NOT NULL DEFAULT '', rom_format TEXT NOT NULL DEFAULT '', status TEXT NOT NULL DEFAULT 'untested', status_source TEXT NOT NULL DEFAULT 'automatic', video_status TEXT NOT NULL DEFAULT 'unknown', audio_status TEXT NOT NULL DEFAULT 'unknown', input_status TEXT NOT NULL DEFAULT 'unknown', save_support TEXT NOT NULL DEFAULT 'unknown', achievement_support TEXT NOT NULL DEFAULT 'none', known_issues TEXT NOT NULL DEFAULT '', last_tested INTEGER NOT NULL DEFAULT 0, test_count INTEGER NOT NULL DEFAULT 0, last_frame INTEGER NOT NULL DEFAULT 0, created_at INTEGER NOT NULL, updated_at INTEGER NOT NULL); ";
    compatibilitySql << compatibilitySql + "CREATE INDEX IF NOT EXISTS rom_compatibility_status_idx ON rom_compatibility(status, updated_at DESC); ";
    compatibilitySql << compatibilitySql + "CREATE INDEX IF NOT EXISTS rom_compatibility_mapper_idx ON rom_compatibility(mapper, status); ";
    compatibilitySql << compatibilitySql + "CREATE INDEX IF NOT EXISTS rom_compatibility_tested_idx ON rom_compatibility(last_tested DESC); ";
    compatibilitySql << compatibilitySql + "INSERT OR IGNORE INTO rom_compatibility(rom_digest, mapper, mapper_name, status, status_source, video_status, audio_status, input_status, save_support, achievement_support, known_issues, created_at, updated_at) SELECT r.digest, r.mapper, 'Mapper ' || r.mapper, CASE WHEN r.mapper IN (0,1,2,3,4,7,10,11,30,66,71,87,94,180,227) THEN 'untested' ELSE 'unsupported' END, 'migration', 'unknown', 'unknown', 'unknown', CASE WHEN r.mapper IN (0,1,2,3,4,7,10,11,30,66,71,87,94,180,227) THEN 'supported' ELSE 'unsupported' END, CASE WHEN EXISTS (SELECT 1 FROM achievement_progress p WHERE p.game_digest = r.digest) THEN 'supported' ELSE 'none' END, CASE WHEN r.mapper IN (0,1,2,3,4,7,10,11,30,66,71,87,94,180,227) THEN '' ELSE 'Mapper is not implemented by this emulator build' END, r.created_at, r.last_opened FROM rom_library r;";
    [{
        "version": 1, "name": "core", "sql": coreSql
    }, {
        "version": 2, "name": "achievements", "sql": achievementSql
    }, {
        "version": 3, "name": "indexes", "sql": indexSql
    }, {
        "version": 4, "name": "save_states", "sql": stateSql
    }, {
        "version": 5, "name": "local_achievements", "sql": localAchievementSql
    }, {
        "version": 6, "name": "game_library_ui", "sql": libraryUiSql
    }, {
        "version": 7, "name": "rom_compatibility", "sql": compatibilitySql
    }];
}

/// Opens the local store and applies all local emulator migrations.
pub fct open(path) {
    var db << database.open(path);
    // Small progress writes run during gameplay. WAL + NORMAL synchronous
    // keeps those commits off the audio-critical path without weakening SQLite
    // durability beyond the normal WAL trade-off.
    // journal_mode returns a result row ("wal"), so it must go through
    // sqliteQuery/database.query. sqliteExec intentionally rejects row-producing
    // statements in Zumbra 0.14.5. Using query for both PRAGMAs keeps the
    // initialization path safe across interpreter and native C11 backends.
    database.query(db, "PRAGMA journal_mode=WAL", {
    });
    database.query(db, "PRAGMA synchronous=NORMAL", {
    });
    database.migrate(db, migrations());
    db;
}
pub fct memory() {
    var db << database.memory();
    database.migrate(db, migrations());
    db;
}
pub fct close(db) {
    database.close(db);
}
pub fct integrity(db) {
    database.integrity(db);
}
pub fct schemaVersion(db) {
    database.schemaVersion(db);
}
pub fct saveSetting(db, key, value) {
    database.exec(db, "INSERT INTO settings(key, value) VALUES (:key, :value) ON CONFLICT(key) DO UPDATE SET value = excluded.value", {
        "key": key, "value": value
    });
}
pub fct setting(db, key, fallback) {
    var rows << database.query(db, "SELECT value FROM settings WHERE key = :key", {
        "key": key
    });
    if (sizeOf(rows) == 0) {
        return fallback;
    }
    rows[0]["value"];
}
