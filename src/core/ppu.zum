import "constants.zum" as constants;
import "mapper.zum" as mapper;
/// One decoded pixel before final background/sprite priority selection.
pub struct Pixel {
    color: int;
    opaque: bool;
    behindBackground: bool;
    spriteZero: bool;
}

/// CPU-visible and timing state for the Ricoh 2C02 PPU.
pub struct PpuCore {
    control: int;
    mask: int;
    status: int;
    oamAddress: int;
    v: int;
    t: int;
    fineX: int;
    writeToggle: bool;
    readBuffer: int;
    openBus: int;
    scrollX: int;
    scrollY: int;
    scanline: int;
    dot: int;
    cycles: u64;
    frame: u64;
    frameComplete: bool;
    nmiLine: bool;
    nmiPending: bool;
    oddFrame: bool;
    spritesOnLine: int;
}
fct renderingEnabled(core) {
    (core.mask band 0x18) != 0;
}
fct updateNmi(core) {
    var next <<((core.status band 0x80) != 0) and((core.control band 0x80) != 0);
    if (next and!core.nmiLine) {
        core.nmiPending << true;
    }
    core.nmiLine << next;
}
fct paletteOffset(address) {
    var offset <<(address - 0x3F00) band 0x1F;
    if (offset == 0x10 or offset == 0x14 or offset == 0x18 or offset == 0x1C) {
        offset << offset - 0x10;
    }
    offset;
}
fct nametableOffsetForMode(address, mode) {
    var normalized <<(address - 0x2000) band 0x0FFF;
    var table << normalized / 0x0400;
    var within << normalized band 0x03FF;
    if (mode == "four-screen") {
        return(table * 0x0400) + within;
    }
    if (mode == "vertical") {
        return((table band 0x01) * 0x0400) + within;
    }
    if (mode == "single-screen-lower") {
        return within;
    }
    if (mode == "single-screen-upper") {
        return 0x0400 + within;
    }
    return((table shr 1) * 0x0400) + within;
}
fct nametableOffset(state, address) {
    var cart << state["cart"];
    var info << cart["info"];
    var mode << mapper.mirroring(state["mapper"], info.header.mirroring);
    nametableOffsetForMode(address, mode);
}

/// Creates a power-on PPU package with VRAM, palette, OAM and framebuffer.
pub fct createWithMapper(cart, mapperState) {
    var info << cart["info"];
    var vramBytes << constants.NAMETABLE_BYTES;
    if (info.header.fourScreen) {
        vramBytes << constants.FOUR_SCREEN_NAMETABLE_BYTES;
    }
    {
        "core": PpuCore(0, 0, 0, 0, 0, 0, 0, false, 0, 0, 0, 0,-1, 0, 0u64, 0u64, false, false, false, false, 0), "cart": cart, "mapper": mapperState, "vram": bytes(vramBytes), "palette": bytes(constants.PALETTE_BYTES), "oam": bytes(constants.OAM_BYTES), "framebuffer": bytes(constants.FRAMEBUFFER_BYTES), "backgroundOpaque": bytes(constants.PPU_WIDTH), "lineSprites": bytes(8), "lineSpriteCount": 0, "renderOutput": true, "fastTiming": false
    };
}

/// Creates a standalone PPU and owns a mapper state for isolated tests.
pub fct create(cart) {
    var info << cart["info"];
    var mapperState << mapper.create(info.header.mapper, info.header.submapper, sizeOf(cart["prgRom"]), sizeOf(cart["chrMemory"]), info.header.battery, info.header.mirroring);
    createWithMapper(cart, mapperState);
}

/// Reads the complete PPU address space after mirroring.
pub fct read(state, address) {
    var normalized << address band 0x3FFF;
    if (normalized < 0x2000) {
        var cart << state["cart"];
        var info << cart["info"];
        var offset << mapper.ppuReadOffset(state["mapper"], normalized, sizeOf(cart["chrMemory"]));
        if (offset >= 0) {
            return toInt(cart["chrMemory"][offset]);
        }
        return 0;
    }
    if (normalized < 0x3F00) {
        return toInt(state["vram"][nametableOffset(state, normalized)]);
    }
    toInt(state["palette"][paletteOffset(normalized)]) band 0x3F;
}

/// Writes CHR RAM, nametable RAM or palette RAM after mirroring.
pub fct write(state, address, value) {
    var normalized << address band 0x3FFF;
    var byteValue << u8(value band 0xFF);
    if (normalized < 0x2000) {
        var cart << state["cart"];
        var info << cart["info"];
        var offset << mapper.ppuReadOffset(state["mapper"], normalized, sizeOf(cart["chrMemory"]));
        if (!mapper.ppuWriteWritable(state["mapper"], offset, info.chrIsRam)) {
            return false;
        }
        cart["chrMemory"][offset] << byteValue;
        return true;
    }
    if (normalized < 0x3F00) {
        state["vram"][nametableOffset(state, normalized)] << byteValue;
        return true;
    }
    state["palette"][paletteOffset(normalized)] << u8(value band 0x3F);
    true;
}
fct incrementV(core) {
    if ((core.control band 0x04) != 0) {
        core.v <<(core.v + 32) band 0x7FFF;
    } else {
        core.v <<(core.v + 1) band 0x7FFF;
    }
}

/// Reads one of the eight CPU-visible PPU registers.
pub fct cpuRead(state, register) {
    var core << state["core"];
    var index << register band 0x07;
    var value << core.openBus;
    if (index == 2) {
        value <<(core.status band 0xE0) bor(core.openBus band 0x1F);
        core.status << core.status band 0x7F;
        core.writeToggle << false;
        updateNmi(core);
    } else {
        if (index == 4) {
            value << toInt(state["oam"][core.oamAddress]);
        } else {
            if (index == 7) {
                var address << core.v band 0x3FFF;
                var memoryValue << read(state, address);
                if (address >= 0x3F00) {
                    value << memoryValue;
                    core.readBuffer << read(state,(address - 0x1000) band 0x3FFF);
                } else {
                    value << core.readBuffer;
                    core.readBuffer << memoryValue;
                }
                incrementV(core);
            }
        }
    }
    core.openBus << value band 0xFF;
    value band 0xFF;
}

/// Writes one of the eight CPU-visible PPU registers.
pub fct cpuWrite(state, register, value) {
    var core << state["core"];
    var index << register band 0x07;
    var byteValue << toInt(value) band 0xFF;
    core.openBus << byteValue;
    if (index == 0) {
        core.control << byteValue;
        core.t <<(core.t band 0x73FF) bor((byteValue band 0x03) shl 10);
        updateNmi(core);
        return true;
    }
    if (index == 1) {
        core.mask << byteValue;
        return true;
    }
    if (index == 3) {
        core.oamAddress << byteValue;
        return true;
    }
    if (index == 4) {
        state["oam"][core.oamAddress] << u8(byteValue);
        core.oamAddress <<(core.oamAddress + 1) band 0xFF;
        return true;
    }
    if (index == 5) {
        if (!core.writeToggle) {
            core.fineX << byteValue band 0x07;
            core.t <<(core.t band 0x7FE0) bor(byteValue shr 3);
            core.scrollX << byteValue;
            core.writeToggle << true;
        } else {
            core.t <<(core.t band 0x0C1F) bor((byteValue band 0x07) shl 12) bor((byteValue band 0xF8) shl 2);
            core.scrollY << byteValue;
            core.writeToggle << false;
        }
        return true;
    }
    if (index == 6) {
        if (!core.writeToggle) {
            core.t <<(core.t band 0x00FF) bor((byteValue band 0x3F) shl 8);
            core.writeToggle << true;
        } else {
            core.t <<(core.t band 0x7F00) bor byteValue;
            core.v << core.t;
            core.writeToggle << false;
        }
        return true;
    }
    if (index == 7) {
        write(state, core.v, byteValue);
        incrementV(core);
        return true;
    }
    true;
}
fct patternByte(state, address) {
    var cart << state["cart"];
    var memory << cart["chrMemory"];
    var offset << mapper.ppuReadOffset(state["mapper"], address, sizeOf(memory));
    if (offset < 0) {
        return 0;
    }
    toInt(memory[offset]);
}
fct paletteByte(memory, address) {
    toInt(memory[paletteOffset(address)]) band 0x3F;
}
fct clearBackgroundLine(state, y, color) {
    var framebuffer << state["framebuffer"];
    var opaque << state["backgroundOpaque"];
    var base << y * constants.PPU_WIDTH;
    var x << 0;
    while (x < constants.PPU_WIDTH) {
        framebuffer[base + x] << u8(color);
        opaque[x] << 0u8;
        x << x + 1;
    }
}
fct renderBackgroundLine(state, y) {
    var core << state["core"];
    var framebuffer << state["framebuffer"];
    var opaque << state["backgroundOpaque"];
    var paletteMemory << state["palette"];
    var universal << paletteByte(paletteMemory, 0x3F00);
    if ((core.mask band 0x08) == 0) {
        clearBackgroundLine(state, y, universal);
        return;
    }
    var cart << state["cart"];
    var info << cart["info"];
    var mode << mapper.mirroring(state["mapper"], info.header.mirroring);
    var vram << state["vram"];
    var baseX <<(core.control band 0x01) * 256;
    var baseY <<((core.control shr 1) band 0x01) * 240;
    var worldY <<(baseY + core.scrollY + y) % 480;
    var tableY << worldY / 240;
    var localY << worldY % 240;
    var tileY << localY / 8;
    var finePixelY << localY band 0x07;
    var patternBase << 0;
    if ((core.control band 0x10) != 0) {
        patternBase << 0x1000;
    }
    var cachedTable <<-1;
    var cachedTileX <<-1;
    var low << 0;
    var high << 0;
    var paletteNumber << 0;
    var rowBase << y * constants.PPU_WIDTH;
    var x << 0;
    while (x < constants.PPU_WIDTH) {
        if (x < 8 and(core.mask band 0x02) == 0) {
            framebuffer[rowBase + x] << u8(universal);
            opaque[x] << 0u8;
        } else {
            var worldX <<(baseX + core.scrollX + x) % 512;
            var tableX << worldX / 256;
            var table <<(tableY * 2) + tableX;
            var localX << worldX % 256;
            var tileX << localX / 8;
            var finePixelX << localX band 0x07;
            if (table != cachedTable or tileX != cachedTileX) {
                cachedTable << table;
                cachedTileX << tileX;
                var nametableBase << 0x2000 +(table * 0x0400);
                var tile << toInt(vram[nametableOffsetForMode(nametableBase +(tileY * 32) + tileX, mode)]);
                var attribute << toInt(vram[nametableOffsetForMode(nametableBase + 0x03C0 +((tileY / 4) * 8) +(tileX / 4), mode)]);
                var quadrantShift <<((tileY band 0x02) * 2) +(tileX band 0x02);
                paletteNumber <<(attribute shr quadrantShift) band 0x03;
                var patternAddress << patternBase +(tile * 16) + finePixelY;
                low << patternByte(state, patternAddress);
                high << patternByte(state, patternAddress + 8);
            }
            var bit << 7 - finePixelX;
            var patternPixel <<((low shr bit) band 0x01) bor(((high shr bit) band 0x01) shl 1);
            if (patternPixel == 0) {
                framebuffer[rowBase + x] << u8(universal);
                opaque[x] << 0u8;
            } else {
                framebuffer[rowBase + x] << u8(paletteByte(paletteMemory, 0x3F00 +(paletteNumber * 4) + patternPixel));
                opaque[x] << 1u8;
            }
        }
        x << x + 1;
    }
}
fct evaluateSprites(state, y) {
    var core << state["core"];
    var height << 8;
    if ((core.control band 0x20) != 0) {
        height << 16;
    }
    var count << 0;
    var stored << 0;
    var sprite << 0;
    var lineSprites << state["lineSprites"];
    while (sprite < 64) {
        var top << toInt(state["oam"][sprite * 4]) + 1;
        if (y >= top and y < top + height) {
            count << count + 1;
            if (stored < 8) {
                lineSprites[stored] << u8(sprite);
                stored << stored + 1;
            }
        }
        sprite << sprite + 1;
    }
    state["lineSpriteCount"] << stored;
    core.spritesOnLine << count;
    if (count > 8) {
        core.status << core.status bor 0x20;
    }
}
fct renderSpritesLine(state, y) {
    var core << state["core"];
    if ((core.mask band 0x10) == 0) {
        return;
    }
    var spriteHeight << 8;
    if ((core.control band 0x20) != 0) {
        spriteHeight << 16;
    }
    var framebuffer << state["framebuffer"];
    var backgroundOpaque << state["backgroundOpaque"];
    var paletteMemory << state["palette"];
    var oam << state["oam"];
    var lineSprites << state["lineSprites"];
    var slot << state["lineSpriteCount"] - 1;
    var rowBase << y * constants.PPU_WIDTH;
    while (slot >= 0) {
        var sprite << toInt(lineSprites[slot]);
        var offset << sprite * 4;
        var top << toInt(oam[offset]) + 1;
        var row << y - top;
        var tile << toInt(oam[offset + 1]);
        var attributes << toInt(oam[offset + 2]);
        var left << toInt(oam[offset + 3]);
        var pixelY << row;
        if ((attributes band 0x80) != 0) {
            pixelY << spriteHeight - 1 - pixelY;
        }
        var patternBase << 0;
        if (spriteHeight == 16) {
            patternBase <<(tile band 0x01) * 0x1000;
            tile << tile band 0xFE;
            if (pixelY >= 8) {
                tile << tile + 1;
                pixelY << pixelY - 8;
            }
        } else {
            if ((core.control band 0x08) != 0) {
                patternBase << 0x1000;
            }
        }
        var address << patternBase +(tile * 16) + pixelY;
        var low << patternByte(state, address);
        var high << patternByte(state, address + 8);
        var outputPixel << 0;
        while (outputPixel < 8) {
            var x << left + outputPixel;
            if (x >= 0 and x < constants.PPU_WIDTH and!(x < 8 and(core.mask band 0x04) == 0)) {
                var sourcePixel << outputPixel;
                if ((attributes band 0x40) != 0) {
                    sourcePixel << 7 - sourcePixel;
                }
                var bit << 7 - sourcePixel;
                var patternPixel <<((low shr bit) band 0x01) bor(((high shr bit) band 0x01) shl 1);
                if (patternPixel != 0) {
                    var backgroundVisible << toInt(backgroundOpaque[x]) != 0;
                    if (backgroundVisible and sprite == 0 and x < 255) {
                        core.status << core.status bor 0x40;
                    }
                    if (!backgroundVisible or(attributes band 0x20) == 0) {
                        var paletteNumber << attributes band 0x03;
                        framebuffer[rowBase + x] << u8(paletteByte(paletteMemory, 0x3F10 +(paletteNumber * 4) + patternPixel));
                    }
                }
            }
            outputPixel << outputPixel + 1;
        }
        slot << slot - 1;
    }
}
fct renderScanline(state, y) {
    evaluateSprites(state, y);
    renderBackgroundLine(state, y);
    renderSpritesLine(state, y);
}

/// Converts a linear dot position to the PPU core scanline/dot fields.
fct setCorePosition(core, position) {
    core.scanline <<(position / constants.PPU_DOTS_PER_SCANLINE) - 1;
    core.dot << position % constants.PPU_DOTS_PER_SCANLINE;
}

/// Returns the next PPU event that must be observed by the fast desktop path.
fct nextFastEventPosition(state, current) {
    var core << state["core"];
    var dotsPerFrame << constants.PPU_DOTS_PER_SCANLINE * 262;
    var best << dotsPerFrame;
    var clearAt << 1;
    var vblankAt <<(242 * constants.PPU_DOTS_PER_SCANLINE) + 1;
    if (current < clearAt and clearAt < best) {
        best << clearAt;
    }
    if (current < vblankAt and vblankAt < best) {
        best << vblankAt;
    }
    var baseLine <<(current / constants.PPU_DOTS_PER_SCANLINE) - 1;
    if (baseLine < 0) {
        baseLine << 0;
    }
    if (baseLine < 240) {
        var renderLine << baseLine;
        var renderAt <<((renderLine + 1) * constants.PPU_DOTS_PER_SCANLINE) + 1;
        if (renderAt <= current) {
            renderLine << renderLine + 1;
            renderAt <<((renderLine + 1) * constants.PPU_DOTS_PER_SCANLINE) + 1;
        }
        if (renderLine < 240 and renderAt < best) {
            best << renderAt;
        }
        var irqLine << baseLine;
        var irqAt <<((irqLine + 1) * constants.PPU_DOTS_PER_SCANLINE) + 260;
        if (irqAt <= current) {
            irqLine << irqLine + 1;
            irqAt <<((irqLine + 1) * constants.PPU_DOTS_PER_SCANLINE) + 260;
        }
        if (irqLine < 240 and irqAt < best) {
            best << irqAt;
        }
    }
    return best;
}

/// Applies the visible PPU event reached by the fast desktop path.
fct applyFastEvent(state, position) {
    var core << state["core"];
    setCorePosition(core, position);
    if (core.scanline ==-1 and core.dot == 1) {
        core.status << core.status band 0x1F;
        core.nmiPending << false;
        updateNmi(core);
        return;
    }
    if (core.scanline >= 0 and core.scanline < 240) {
        if (core.dot == 1 and state["renderOutput"]) {
            renderScanline(state, core.scanline);
        }
        if (core.dot == 260 and renderingEnabled(core)) {
            mapper.clockScanline(state["mapper"]);
        }
        return;
    }
    if (core.scanline == 241 and core.dot == 1) {
        core.status << core.status bor 0x80;
        updateNmi(core);
        return;
    }
}

/// Advances PPU timing in scanline-sized jumps for the desktop fast path.
///
/// Unlike the older snapshot path, this still renders visible scanlines and
/// clocks mapper IRQ/latch points at stable positions. This avoids slideshow
/// frameskip and reduces the lower-screen flicker observed in MMC4/MMC games.
pub fct tickFast(state, dots) {
    var core << state["core"];
    var remaining << dots;
    var dotsPerFrame << constants.PPU_DOTS_PER_SCANLINE * 262;
    var current <<((core.scanline + 1) * constants.PPU_DOTS_PER_SCANLINE) + core.dot;
    while (remaining > 0) {
        var nextEvent << nextFastEventPosition(state, current);
        var delta << nextEvent - current;
        if (delta <= 0) {
            delta << 1;
        }
        if (delta > remaining) {
            delta << remaining;
        }
        current << current + delta;
        core.cycles << u64(core.cycles + u64(delta));
        remaining << remaining - delta;
        if (current >= dotsPerFrame) {
            current << current - dotsPerFrame;
            core.frame << u64(core.frame + 1u64);
            core.frameComplete << true;
            core.oddFrame <<!core.oddFrame;
        }
        setCorePosition(core, current);
        if (remaining > 0 or current == nextEvent) {
            applyFastEvent(state, current);
        }
    }
    return core.frameComplete;
}

/// Advances one PPU dot and returns true when a new frame completes.
pub fct tick(state) {
    if (state["fastTiming"]) {
        return tickFast(state, 1);
    }
    var core << state["core"];
    if (core.scanline ==-1 and core.dot == 1) {
        core.status << core.status band 0x1F;
        core.nmiPending << false;
        updateNmi(core);
    }
    if (core.scanline >= 0 and core.scanline < 240) {
        if (state["renderOutput"]) {
            if (core.dot == 0) {
                evaluateSprites(state, core.scanline);
            }
            if (core.dot == 1) {
                renderScanline(state, core.scanline);
            }
        }
        if (core.dot == 260 and renderingEnabled(core)) {
            mapper.clockScanline(state["mapper"]);
        }
    }
    if (core.scanline == 241 and core.dot == 1) {
        core.status << core.status bor 0x80;
        updateNmi(core);
    }
    core.cycles << u64(core.cycles + 1u64);
    if (core.scanline ==-1 and core.dot == 339 and core.oddFrame and renderingEnabled(core)) {
        core.dot << 0;
        core.scanline << 0;
        return false;
    }
    core.dot << core.dot + 1;
    if (core.dot >= constants.PPU_DOTS_PER_SCANLINE) {
        core.dot << 0;
        core.scanline << core.scanline + 1;
        if (core.scanline >= 261) {
            core.scanline <<-1;
            core.frame << u64(core.frame + 1u64);
            core.frameComplete << true;
            core.oddFrame <<!core.oddFrame;
            return true;
        }
    }
    false;
}

/// Enables or disables expensive visible scanline rendering while keeping timing/NMI progression.
pub fct setRenderOutput(state, enabled) {
    state["renderOutput"] << enabled;
    true;
}

/// Enables coarse PPU timing for the desktop fast path.
///
/// The full tick() path remains the test/reference implementation. When fast
/// timing is active, the frontend renders a whole snapshot explicitly after the
/// frame edge instead of paying per-dot renderer overhead during CPU stepping.
pub fct setFastTiming(state, enabled) {
    state["fastTiming"] << enabled;
    true;
}

/// Renders the current PPU state into the framebuffer once, after fast timing
/// has advanced to the frame boundary. This trades cycle-level scroll effects
/// for desktop playability while preserving the reference renderer for tests.
pub fct renderFrameSnapshot(state) {
    var y << 0;
    while (y < constants.PPU_HEIGHT) {
        renderScanline(state, y);
        y << y + 1;
    }
    return true;
}

/// Returns and clears the edge-triggered PPU NMI request.
pub fct takeNmi(state) {
    var core << state["core"];
    var pending << core.nmiPending;
    core.nmiPending << false;
    pending;
}

/// Writes one OAM byte and increments OAMADDR, as used by $4014 DMA.
pub fct oamDmaWrite(state, value) {
    var core << state["core"];
    state["oam"][core.oamAddress] << u8(toInt(value) band 0xFF);
    core.oamAddress <<(core.oamAddress + 1) band 0xFF;
}

/// Clears the frame-complete edge after the frontend consumes it.
pub fct clearFrameComplete(state) {
    state["core"].frameComplete << false;
}

/// Returns a stable digest of the 256x240 palette-index framebuffer.
pub fct frameDigest(state) {
    sha256(state["framebuffer"]);
}
