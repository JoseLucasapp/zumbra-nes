                if (target.pageCrossed) {
                    resultCycles << resultCycles + 1;
                }
                resultCycles;
            }
            case 0xBD {
                var target << self.addressAbsoluteX(systemBus);
                var value << self.read(systemBus, target.address);
                self.a << value;
                self.setZeroNegative(self.a);
                var resultCycles << 4;
                if (target.pageCrossed) {
                    resultCycles << resultCycles + 1;
                }
                resultCycles;
            }
            case 0xBE {
                var target << self.addressAbsoluteY(systemBus);
                var value << self.read(systemBus, target.address);
                self.x << value;
                self.setZeroNegative(self.x);
                var resultCycles << 4;
                if (target.pageCrossed) {
                    resultCycles << resultCycles + 1;
                }
                resultCycles;
            }
            case 0xC0 {
                var value << self.fetchByte(systemBus);
                self.compare(self.y, value);
                2;
            }
            case 0xC1 {
                var target << self.addressIndexedIndirect(systemBus);
                var value << self.read(systemBus, target.address);
                self.compare(self.a, value);
                6;
            }
            case 0xC4 {
                var target << self.addressZeroPage(systemBus);
                var value << self.read(systemBus, target.address);
                self.compare(self.y, value);
                3;
            }
            case 0xC5 {
                var target << self.addressZeroPage(systemBus);
                var value << self.read(systemBus, target.address);
                self.compare(self.a, value);
                3;
            }
            case 0xC6 {
                var target << self.addressZeroPage(systemBus);
                var value << self.read(systemBus, target.address);
                value <<(value - 1) band 0xFF;
                self.write(systemBus, target.address, value);
                self.setZeroNegative(value);
                5;
            }
            case 0xC8 {
                self.y <<(self.y + 1) band 0xFF;
                self.setZeroNegative(self.y);
                2;
            }
            case 0xC9 {
                var value << self.fetchByte(systemBus);
                self.compare(self.a, value);
                2;
            }
            case 0xCA {
                self.x <<(self.x - 1) band 0xFF;
                self.setZeroNegative(self.x);
                2;
            }
            case 0xCC {
                var target << self.addressAbsolute(systemBus);
                var value << self.read(systemBus, target.address);
                self.compare(self.y, value);
                4;
            }
            case 0xCD {
                var target << self.addressAbsolute(systemBus);
                var value << self.read(systemBus, target.address);
                self.compare(self.a, value);
                4;
            }
            case 0xCE {
                var target << self.addressAbsolute(systemBus);
                var value << self.read(systemBus, target.address);
                value <<(value - 1) band 0xFF;
                self.write(systemBus, target.address, value);
                self.setZeroNegative(value);
                6;
            }
            case 0xD0 {
                self.branch(systemBus,!self.getFlag(FLAG_ZERO));
            }
            case 0xD1 {
                var target << self.addressIndirectIndexed(systemBus);
                var value << self.read(systemBus, target.address);
                self.compare(self.a, value);
                var resultCycles << 5;
                if (target.pageCrossed) {
                    resultCycles << resultCycles + 1;
                }
                resultCycles;
            }
            case 0xD5 {
                var target << self.addressZeroPageX(systemBus);
                var value << self.read(systemBus, target.address);
                self.compare(self.a, value);
                4;
            }
            case 0xD6 {
                var target << self.addressZeroPageX(systemBus);
                var value << self.read(systemBus, target.address);
                value <<(value - 1) band 0xFF;
                self.write(systemBus, target.address, value);
                self.setZeroNegative(value);
                6;
            }
            case 0xD8 {
                self.setFlag(FLAG_DECIMAL, false);
                2;
            }
            case 0xD9 {
                var target << self.addressAbsoluteY(systemBus);
                var value << self.read(systemBus, target.address);
                self.compare(self.a, value);
                var resultCycles << 4;
                if (target.pageCrossed) {
                    resultCycles << resultCycles + 1;
                }
                resultCycles;
            }
            case 0xDD {
                var target << self.addressAbsoluteX(systemBus);
                var value << self.read(systemBus, target.address);
                self.compare(self.a, value);
                var resultCycles << 4;
                if (target.pageCrossed) {
                    resultCycles << resultCycles + 1;
                }
                resultCycles;
            }
            case 0xDE {
                var target << self.addressAbsoluteX(systemBus);
                var value << self.read(systemBus, target.address);
                value <<(value - 1) band 0xFF;
                self.write(systemBus, target.address, value);
                self.setZeroNegative(value);
                7;
            }
            case 0xE0 {
                var value << self.fetchByte(systemBus);
                self.compare(self.x, value);
                2;
            }
            case 0xE1 {
                var target << self.addressIndexedIndirect(systemBus);
                var value << self.read(systemBus, target.address);
                self.sbc(value);
                6;
            }
            case 0xE4 {
                var target << self.addressZeroPage(systemBus);
                var value << self.read(systemBus, target.address);
                self.compare(self.x, value);
                3;
            }
            case 0xE5 {
                var target << self.addressZeroPage(systemBus);
                var value << self.read(systemBus, target.address);
                self.sbc(value);
                3;
            }
            case 0xE6 {
                var target << self.addressZeroPage(systemBus);
                var value << self.read(systemBus, target.address);
                value <<(value + 1) band 0xFF;
                self.write(systemBus, target.address, value);
                self.setZeroNegative(value);
                5;
            }
            case 0xE8 {
                self.x <<(self.x + 1) band 0xFF;
                self.setZeroNegative(self.x);
                2;
            }
            case 0xE9 {
                var value << self.fetchByte(systemBus);
                self.sbc(value);
                2;
            }
            case 0xEA {
                2;
            }
            case 0xEC {
                var target << self.addressAbsolute(systemBus);
                var value << self.read(systemBus, target.address);
                self.compare(self.x, value);
                4;
            }
            case 0xED {
                var target << self.addressAbsolute(systemBus);
                var value << self.read(systemBus, target.address);
                self.sbc(value);
                4;
            }
            case 0xEE {
                var target << self.addressAbsolute(systemBus);
                var value << self.read(systemBus, target.address);
                value <<(value + 1) band 0xFF;
                self.write(systemBus, target.address, value);
                self.setZeroNegative(value);
                6;
            }
            case 0xF0 {
                self.branch(systemBus, self.getFlag(FLAG_ZERO));
            }
            case 0xF1 {
                var target << self.addressIndirectIndexed(systemBus);
                var value << self.read(systemBus, target.address);
                self.sbc(value);
                var resultCycles << 5;
                if (target.pageCrossed) {
                    resultCycles << resultCycles + 1;
                }
                resultCycles;
            }
            case 0xF5 {
                var target << self.addressZeroPageX(systemBus);
                var value << self.read(systemBus, target.address);
                self.sbc(value);
                4;
            }
            case 0xF6 {
                var target << self.addressZeroPageX(systemBus);
                var value << self.read(systemBus, target.address);
                value <<(value + 1) band 0xFF;
                self.write(systemBus, target.address, value);
                self.setZeroNegative(value);
                6;
            }
            case 0xF8 {
                self.setFlag(FLAG_DECIMAL, true);
                2;
            }
            case 0xF9 {
                var target << self.addressAbsoluteY(systemBus);
                var value << self.read(systemBus, target.address);
                self.sbc(value);
                var resultCycles << 4;
                if (target.pageCrossed) {
                    resultCycles << resultCycles + 1;
                }
                resultCycles;
            }
            case 0xFD {
                var target << self.addressAbsoluteX(systemBus);
                var value << self.read(systemBus, target.address);
                self.sbc(value);
                var resultCycles << 4;
                if (target.pageCrossed) {
                    resultCycles << resultCycles + 1;
                }
                resultCycles;
            }
            case 0xFE {
                var target << self.addressAbsoluteX(systemBus);
                var value << self.read(systemBus, target.address);
                value <<(value + 1) band 0xFF;
                self.write(systemBus, target.address, value);
                self.setZeroNegative(value);
                7;
            } else {
                self.halted << true;
                panic("illegal or unsupported 6502 opcode: " + toString(opcode));
            }
        };
        self.cycles << self.cycles + used;
        self.instructions << self.instructions + 1;
        used;
    }
}

/// Creates and resets a CPU against the supplied Z19 bus.
pub fct create(systemBus) {
    var processor << Cpu6502(0, 0, 0, 0xFD, 0, FLAG_INTERRUPT bor FLAG_UNUSED, 0, 0, 0, false, false, false);
    processor.reset(systemBus);
    processor;
}

/// Executes at most `instructionLimit` instructions and returns the number run.
pub fct run(processor, systemBus, instructionLimit) {
    var executed << 0;
    while (executed < instructionLimit and!processor.halted) {
        processor.step(systemBus);
        executed << executed + 1;
    }
    executed;
}
