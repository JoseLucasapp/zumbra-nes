}
pub fct isOfficialOpcode(opcode) {
    opcodeInfo(opcode).official;
}
pub fct officialOpcodeCount() {
    OFFICIAL_OPCODE_COUNT;
}

/// Complete Ricoh 2A03 CPU state. Decimal arithmetic is intentionally disabled.
pub struct Cpu6502 {
    a: int;
    x: int;
    y: int;
    sp: int;
    pc: int;
    status: int;
    cycles: int;
    instructions: int;
    lastOpcode: int;
    halted: bool;
    irqLine: bool;
    nmiPending: bool;
    fct getFlag(mask) {
        (self.status band mask) != 0;
    }
    fct setFlag(mask, enabled) {
        if (enabled) {
            self.status <<(self.status bor mask) band 0xFF;
        } else {
            self.status << self.status band(mask bxor 0xFF) band 0xFF;
        }
        self.status <<(self.status bor FLAG_UNUSED) band 0xFF;
    }
    fct setZeroNegative(value) {
        self.setFlag(FLAG_ZERO, value == 0);
        self.setFlag(FLAG_NEGATIVE,(value band 0x80) != 0);
    }
    fct read(systemBus, address) {
        toInt(bus.read(systemBus, address band 0xFFFF));
    }
    fct write(systemBus, address, value) {
        bus.write(systemBus, address band 0xFFFF, u8(value band 0xFF));
    }
    fct fetchByte(systemBus) {
        var value << self.read(systemBus, self.pc);
        self.pc <<(self.pc + 1) band 0xFFFF;
        value;
    }
    fct fetchWord(systemBus) {
        var low << self.fetchByte(systemBus);
        var high << self.fetchByte(systemBus);
        low bor(high shl 8);
    }
    fct readWord(systemBus, address) {
        var low << self.read(systemBus, address);
        var high << self.read(systemBus,(address + 1) band 0xFFFF);
        low bor(high shl 8);
    }
    fct readWordBug(systemBus, address) {
        var low << self.read(systemBus, address);
        var highAddress <<(address + 1) band 0xFFFF;
        if ((address band 0x00FF) == 0x00FF) {
            highAddress << address band 0xFF00;
        }
        var high << self.read(systemBus, highAddress);
        low bor(high shl 8);
    }
    fct pushByte(systemBus, value) {
        self.write(systemBus, STACK_BASE + self.sp, value);
        self.sp <<(self.sp - 1) band 0xFF;
    }
    fct popByte(systemBus) {
        self.sp <<(self.sp + 1) band 0xFF;
        self.read(systemBus, STACK_BASE + self.sp);
    }
    fct pushWord(systemBus, value) {
        self.pushByte(systemBus,(value shr 8) band 0xFF);
        self.pushByte(systemBus, value band 0xFF);
    }
    fct popWord(systemBus) {
        var low << self.popByte(systemBus);
        var high << self.popByte(systemBus);
        low bor(high shl 8);
    }
    fct addressZeroPage(systemBus) {
        AddressResult(self.fetchByte(systemBus), false);
    }
    fct addressZeroPageX(systemBus) {
        AddressResult((self.fetchByte(systemBus) + self.x) band 0xFF, false);
    }
    fct addressZeroPageY(systemBus) {
        AddressResult((self.fetchByte(systemBus) + self.y) band 0xFF, false);
    }
    fct addressAbsolute(systemBus) {
        AddressResult(self.fetchWord(systemBus), false);
    }
    fct addressAbsoluteX(systemBus) {
        var base << self.fetchWord(systemBus);
        var address <<(base + self.x) band 0xFFFF;
        AddressResult(address,(base band 0xFF00) !=(address band 0xFF00));
    }
    fct addressAbsoluteY(systemBus) {
        var base << self.fetchWord(systemBus);
        var address <<(base + self.y) band 0xFFFF;
        AddressResult(address,(base band 0xFF00) !=(address band 0xFF00));
    }
    fct addressIndexedIndirect(systemBus) {
        var pointer <<(self.fetchByte(systemBus) + self.x) band 0xFF;
        var low << self.read(systemBus, pointer);
        var high << self.read(systemBus,(pointer + 1) band 0xFF);
        AddressResult(low bor(high shl 8), false);
    }
    fct addressIndirectIndexed(systemBus) {
        var pointer << self.fetchByte(systemBus);
        var low << self.read(systemBus, pointer);
        var high << self.read(systemBus,(pointer + 1) band 0xFF);
        var base << low bor(high shl 8);
        var address <<(base + self.y) band 0xFFFF;
        AddressResult(address,(base band 0xFF00) !=(address band 0xFF00));
    }
    fct branch(systemBus, condition) {
        var offset << self.fetchByte(systemBus);
        if (!condition) {
            return 2;
        }
        var previous << self.pc;
        if (offset < 0x80) {
            self.pc <<(self.pc + offset) band 0xFFFF;
        } else {
            self.pc <<(self.pc -(256 - offset)) band 0xFFFF;
        }
        if ((previous band 0xFF00) !=(self.pc band 0xFF00)) {
            return 4;
        }
        3;
    }
    fct adc(value) {
        var carryIn << 0;
        if (self.getFlag(FLAG_CARRY)) {
            carryIn << 1;
        }
        var previous << self.a;
        var sum << previous + value + carryIn;
        var result << sum band 0xFF;
        self.setFlag(FLAG_CARRY, sum > 255);
        self.setFlag(FLAG_OVERFLOW,(((previous bxor value) bxor 0xFF) band(previous bxor result) band 0x80) != 0);
        self.a << result;
        self.setZeroNegative(self.a);
    }
    fct sbc(value) {
        self.adc(value bxor 0xFF);
    }
    fct compare(registerValue, value) {
        var result <<(registerValue - value) band 0xFF;
        self.setFlag(FLAG_CARRY, registerValue >= value);
        self.setZeroNegative(result);
    }
