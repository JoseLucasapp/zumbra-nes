import "bus.zum" as bus;
/// Carry flag.
pub const FLAG_CARRY << 0x01;
/// Zero flag.
pub const FLAG_ZERO << 0x02;
/// Interrupt-disable flag.
pub const FLAG_INTERRUPT << 0x04;
/// Decimal flag. The NES 2A03 stores it but ADC/SBC remain binary.
pub const FLAG_DECIMAL << 0x08;
/// Break marker used only in values pushed to the stack.
pub const FLAG_BREAK << 0x10;
/// Unused status bit, kept set by the CPU core.
pub const FLAG_UNUSED << 0x20;
/// Overflow flag.
pub const FLAG_OVERFLOW << 0x40;
/// Negative flag.
pub const FLAG_NEGATIVE << 0x80;
pub const VECTOR_NMI << 0xFFFA;
pub const VECTOR_RESET << 0xFFFC;
pub const VECTOR_IRQ << 0xFFFE;
pub const STACK_BASE << 0x0100;
pub const OFFICIAL_OPCODE_COUNT << 151;
/// Address calculation result used by indexed modes.
pub struct AddressResult {
    address: int;
    pageCrossed: bool;
}

/// Stable metadata for one opcode in the official NMOS 6502 table.
pub struct OpcodeInfo {
    opcode: int;
    mnemonic: string;
    mode: string;
    bytes: int;
    cycles: int;
    pageCrossPenalty: bool;
    official: bool;
}

/// Returns metadata for an official opcode or an explicit illegal marker.
pub fct opcodeInfo(opcode) {
    match (opcode) {
        case 0x00 {
            OpcodeInfo(opcode, "BRK", "implied", 1, 7, false, true);
        }
        case 0x01 {
            OpcodeInfo(opcode, "ORA", "indexed-indirect", 2, 6, false, true);
        }
        case 0x05 {
            OpcodeInfo(opcode, "ORA", "zero-page", 2, 3, false, true);
        }
        case 0x06 {
            OpcodeInfo(opcode, "ASL", "zero-page", 2, 5, false, true);
        }
        case 0x08 {
            OpcodeInfo(opcode, "PHP", "implied", 1, 3, false, true);
        }
        case 0x09 {
            OpcodeInfo(opcode, "ORA", "immediate", 2, 2, false, true);
        }
        case 0x0A {
            OpcodeInfo(opcode, "ASL", "accumulator", 1, 2, false, true);
        }
        case 0x0D {
            OpcodeInfo(opcode, "ORA", "absolute", 3, 4, false, true);
        }
        case 0x0E {
            OpcodeInfo(opcode, "ASL", "absolute", 3, 6, false, true);
        }
        case 0x10 {
            OpcodeInfo(opcode, "BPL", "relative", 2, 2, true, true);
        }
        case 0x11 {
            OpcodeInfo(opcode, "ORA", "indirect-indexed", 2, 5, true, true);
        }
        case 0x15 {
            OpcodeInfo(opcode, "ORA", "zero-page-x", 2, 4, false, true);
        }
        case 0x16 {
            OpcodeInfo(opcode, "ASL", "zero-page-x", 2, 6, false, true);
        }
        case 0x18 {
            OpcodeInfo(opcode, "CLC", "implied", 1, 2, false, true);
        }
        case 0x19 {
            OpcodeInfo(opcode, "ORA", "absolute-y", 3, 4, true, true);
        }
        case 0x1D {
            OpcodeInfo(opcode, "ORA", "absolute-x", 3, 4, true, true);
        }
        case 0x1E {
            OpcodeInfo(opcode, "ASL", "absolute-x", 3, 7, false, true);
        }
        case 0x20 {
            OpcodeInfo(opcode, "JSR", "absolute", 3, 6, false, true);
        }
        case 0x21 {
            OpcodeInfo(opcode, "AND", "indexed-indirect", 2, 6, false, true);
        }
        case 0x24 {
            OpcodeInfo(opcode, "BIT", "zero-page", 2, 3, false, true);
        }
        case 0x25 {
            OpcodeInfo(opcode, "AND", "zero-page", 2, 3, false, true);
        }
        case 0x26 {
            OpcodeInfo(opcode, "ROL", "zero-page", 2, 5, false, true);
        }
        case 0x28 {
            OpcodeInfo(opcode, "PLP", "implied", 1, 4, false, true);
        }
        case 0x29 {
            OpcodeInfo(opcode, "AND", "immediate", 2, 2, false, true);
        }
        case 0x2A {
            OpcodeInfo(opcode, "ROL", "accumulator", 1, 2, false, true);
        }
        case 0x2C {
            OpcodeInfo(opcode, "BIT", "absolute", 3, 4, false, true);
        }
        case 0x2D {
            OpcodeInfo(opcode, "AND", "absolute", 3, 4, false, true);
        }
        case 0x2E {
            OpcodeInfo(opcode, "ROL", "absolute", 3, 6, false, true);
        }
        case 0x30 {
