import "apu.zum" as apu;
import "constants.zum" as constants;
import "controller.zum" as controller;
import "mapper.zum" as mapper;
import "ppu.zum" as ppu;
/// Builds the complete Z21 CPU bus around one validated cartridge.
pub fct create(cart) {
    var info << cart["info"];
    var mapperState << mapper.create(info.header.mapper, info.header.submapper, sizeOf(cart["prgRom"]), sizeOf(cart["chrMemory"]), info.header.battery, info.header.mirroring);
    var prgRamBytes << info.header.prgRamBytes;
    if (prgRamBytes < constants.PRG_RAM_BYTES) {
        prgRamBytes << constants.PRG_RAM_BYTES;
    }
    var audioEnabled << true;
    if (info.header.mapper == 227) {
        audioEnabled << false;
    }
    {
        "ram": bytes(constants.CPU_RAM_BYTES), "apuIo": bytes(constants.APU_IO_BYTES), "prgRam": bytes(prgRamBytes), "prgRamDirty": false, "cart": cart, "mapper": mapperState, "ppu": ppu.createWithMapper(cart, mapperState), "apu": apu.create(), "audioEnabled": audioEnabled, "fastPpu": false, "controller1": controller.create(), "controller2": controller.create(), "dmaPending": false, "dmaPage": 0, "openBus": 0u8, "debugEnabled": false, "debug": {
            "enabled": false, "readBreakpoints":[], "writeBreakpoints":[], "triggered": false, "lastAddress":-1, "lastKind": ""
        }
    };
}
fct addressIn(values, address) {
    var index << 0;
    while (index < sizeOf(values)) {
        if (values[index] == address) {
            return true;
        }
        index << index + 1;
    }
    false;
}
fct recordDebugAccess(state, kind, address) {
    if (!state["debugEnabled"]) {
        return;
    }
    var debug << state["debug"];
    var values << debug["readBreakpoints"];
    if (kind == "write") {
        values << debug["writeBreakpoints"];
    }
    if (addressIn(values, address)) {
        debug["triggered"] << true;
        debug["lastAddress"] << address;
        debug["lastKind"] << kind;
    }
}

/// Reads one CPU-visible byte, including PPU, APU and controller side effects.
pub fct read(state, address) {
    var normalized << address band 0xFFFF;
    recordDebugAccess(state, "read", normalized);
    var value << toInt(state["openBus"]);
    if (normalized <= 0x1FFF) {
        value << toInt(state["ram"][normalized band 0x07FF]);
    } else {
        if (normalized <= 0x3FFF) {
            value << ppu.cpuRead(state["ppu"], normalized band 0x0007);
        } else {
            if (normalized == 0x4015) {
                value << apu.cpuReadStatus(state["apu"]);
            } else {
                if (normalized == 0x4016) {
                    value <<(value band 0xE0) bor state["controller1"].read();
                } else {
                    if (normalized == 0x4017) {
                        value <<(value band 0xE0) bor state["controller2"].read();
                    } else {
                        if (normalized >= 0x4000 and normalized <= 0x401F) {
                            value << toInt(state["apuIo"][normalized - 0x4000]);
                        } else {
                            if (normalized >= 0x6000 and normalized <= 0x7FFF) {
                                if (mapper.prgRamEnabled(state["mapper"])) {
                                    value << toInt(state["prgRam"][(normalized - 0x6000) % sizeOf(state["prgRam"])]);
                                }
                            } else {
                                if (normalized >= 0x8000) {
                                    var cart << state["cart"];
                                    var info << cart["info"];
                                    var offset << mapper.cpuReadOffset(state["mapper"], normalized, sizeOf(cart["prgRom"]));
                                    if (offset >= 0) {
                                        value << toInt(cart["prgRom"][offset]);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    state["openBus"] << u8(value band 0xFF);
    value band 0xFF;
}

/// Writes one CPU-visible byte and routes all Z21 hardware registers.
pub fct write(state, address, value) {
    var normalized << address band 0xFFFF;
    recordDebugAccess(state, "write", normalized);
    var byteValue << toInt(value) band 0xFF;
    state["openBus"] << u8(byteValue);
    if (normalized <= 0x1FFF) {
        state["ram"][normalized band 0x07FF] << u8(byteValue);
        return true;
    }
    if (normalized <= 0x3FFF) {
        return ppu.cpuWrite(state["ppu"], normalized band 0x0007, byteValue) == true;
    }
    if (normalized >= 0x4000 and normalized <= 0x4013) {
        state["apuIo"][normalized - 0x4000] << u8(byteValue);
        return apu.cpuWrite(state["apu"], normalized, byteValue) == true;
    }
    if (normalized == 0x4014) {
        state["apuIo"][0x14] << u8(byteValue);
        state["dmaPage"] << byteValue;
        state["dmaPending"] << true;
        return true;
    }
    if (normalized == 0x4015) {
        state["apuIo"][0x15] << u8(byteValue);
        return apu.cpuWrite(state["apu"], normalized, byteValue) == true;
    }
    if (normalized == 0x4016) {
        state["apuIo"][0x16] << u8(byteValue);
        state["controller1"].writeStrobe(byteValue);
        state["controller2"].writeStrobe(byteValue);
        return true;
    }
    if (normalized == 0x4017) {
        state["apuIo"][0x17] << u8(byteValue);
        return apu.cpuWrite(state["apu"], normalized, byteValue) == true;
    }
    if (normalized >= 0x4018 and normalized <= 0x401F) {
        state["apuIo"][normalized - 0x4000] << u8(byteValue);
        return true;
    }
    if (normalized >= 0x6000 and normalized <= 0x7FFF) {
        if (mapper.prgRamWritable(state["mapper"])) {
            state["prgRam"][(normalized - 0x6000) % sizeOf(state["prgRam"])] << u8(byteValue);
            state["prgRamDirty"] << true;
            return true;
        }
        return false;
    }
    if (normalized >= 0x8000) {
        var cart << state["cart"];
        mapper.cpuWrite(state["mapper"], normalized, byteValue, sizeOf(cart["prgRom"]));
        return true;
    }
    false;
}

/// Reads one PPU address through the attached PPU memory map.
pub fct ppuRead(state, address) {
    ppu.read(state["ppu"], address);
}

/// Writes one PPU address through the attached PPU memory map.
pub fct ppuWrite(state, address, value) {
    ppu.write(state["ppu"], address, toInt(value));
}

/// Updates one controller's complete eight-button state.
pub fct setController(state, port, buttons) {
    if (port == 1) {
        state["controller1"].setButtons(buttons);
        return true;
    }
    if (port == 2) {
        state["controller2"].setButtons(buttons);
        return true;
    }
    false;
}

/// Copies a full CPU page into PPU OAM and returns the 513/514-cycle CPU stall.
pub fct performDma(state, cpuCycle) {
    if (!state["dmaPending"]) {
        return 0;
    }
    var base << state["dmaPage"] shl 8;
    var index << 0;
    while (index < 256) {
        ppu.oamDmaWrite(state["ppu"], read(state, base + index));
        index << index + 1;
    }
    state["dmaPending"] << false;
    if ((cpuCycle band 0x01) == 0) {
        return 513;
    }
    514;
}

/// Returns whether a sprite/background VBlank transition requested NMI.
pub fct takePpuNmi(state) {
    ppu.takeNmi(state["ppu"]);
}

/// Returns the combined APU IRQ line.
pub fct apuIrq(state) {
    apu.irqLine(state["apu"]) or mapper.irqLine(state["mapper"]);
} /// Side-effect-free CPU bus read used by the debugger and disassembler.
pub fct peek(state, address) {
    var normalized << address band 0xFFFF;
    if (normalized <= 0x1FFF) {
        return toInt(state["ram"][normalized band 0x07FF]);
    }
    if (normalized >= 0x6000 and normalized <= 0x7FFF) {
        if (mapper.prgRamEnabled(state["mapper"])) {
            return toInt(state["prgRam"][(normalized - 0x6000) % sizeOf(state["prgRam"])]);
        }
        return toInt(state["openBus"]);
    }
    if (normalized >= 0x8000) {
        var cart << state["cart"];
        var offset << mapper.cpuReadOffset(state["mapper"], normalized, sizeOf(cart["prgRom"]));
        if (offset >= 0) {
            return toInt(cart["prgRom"][offset]);
        }
    }
    toInt(state["openBus"]);
}
pub fct clearPrgRamDirty(state) {
    state["prgRamDirty"] << false;
}
pub fct prgRamDirty(state) {
    state["prgRamDirty"];
}
