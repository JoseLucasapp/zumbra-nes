import "constants.zum" as constants;
fct lengthValue(index) {
    match (index band 0x1F) {
        case 0 {
            10;
        }
        case 1 {
            254;
        }
        case 2 {
            20;
        }
        case 3 {
            2;
        }
        case 4 {
            40;
        }
        case 5 {
            4;
        }
        case 6 {
            80;
        }
        case 7 {
            6;
        }
        case 8 {
            160;
        }
        case 9 {
            8;
        }
        case 10 {
            60;
        }
        case 11 {
            10;
        }
        case 12 {
            14;
        }
        case 13 {
            12;
        }
        case 14 {
            26;
        }
        case 15 {
            14;
        }
        case 16 {
            12;
        }
        case 17 {
            16;
        }
        case 18 {
            24;
        }
        case 19 {
            18;
        }
        case 20 {
            48;
        }
        case 21 {
            20;
        }
        case 22 {
            96;
        }
        case 23 {
            22;
        }
        case 24 {
            192;
        }
        case 25 {
            24;
        }
        case 26 {
            72;
        }
        case 27 {
            26;
        }
        case 28 {
            16;
        }
        case 29 {
            28;
        }
        case 30 {
            32;
        } else {
            30;
        }
    };
}
fct noisePeriod(index) {
    match (index band 0x0F) {
        case 0 {
            4;
        }
        case 1 {
            8;
        }
        case 2 {
            16;
        }
        case 3 {
            32;
        }
        case 4 {
            64;
        }
        case 5 {
            96;
        }
        case 6 {
            128;
        }
        case 7 {
            160;
        }
        case 8 {
            202;
        }
        case 9 {
            254;
        }
        case 10 {
            380;
        }
        case 11 {
            508;
        }
        case 12 {
            762;
        }
        case 13 {
            1016;
        }
        case 14 {
            2034;
        } else {
            4068;
        }
    };
}
fct dmcPeriod(index) {
    match (index band 0x0F) {
        case 0 {
            428;
        }
        case 1 {
            380;
        }
        case 2 {
            340;
        }
        case 3 {
            320;
        }
        case 4 {
            286;
        }
        case 5 {
            254;
        }
        case 6 {
            226;
        }
        case 7 {
            214;
        }
        case 8 {
            190;
        }
        case 9 {
            160;
        }
        case 10 {
            142;
        }
        case 11 {
            128;
        }
        case 12 {
            106;
        }
        case 13 {
            84;
        }
        case 14 {
            72;
        } else {
            54;
        }
    };
}
fct dutyBit(duty, sequence) {
    var pattern << match (duty band 0x03) {
        case 0 {
            0x02;
        }
        case 1 {
            0x06;
        }
        case 2 {
            0x1E;
        } else {
            0xF9;
        }
    };
    (pattern shr(sequence band 0x07)) band 0x01;
}
fct triangleValue(sequence) {
    var position << sequence band 0x1F;
    if (position < 16) {
        return 15 - position;
    }
    position - 16;
}

/// Shared envelope generator used by pulse and noise channels.
pub struct Envelope {
    start: bool;
    loop: bool;
    constantVolume: bool;
    volume: int;
    divider: int;
    decay: int;
    fct restart() {
        self.start << true;
    }
    fct clock() {
        if (self.start) {
            self.start << false;
            self.decay << 15;
            self.divider << self.volume;
            return;
        }
        if (self.divider > 0) {
            self.divider << self.divider - 1;
            return;
        }
        self.divider << self.volume;
        if (self.decay > 0) {
            self.decay << self.decay - 1;
        } else {
            if (self.loop) {
                self.decay << 15;
            }
        }
    }
    fct output() {
        if (self.constantVolume) {
            return self.volume;
        }
        self.decay;
    }
}

/// One of the two NES pulse channels.
pub struct PulseChannel {
    enabled: bool;
    channelOne: bool;
    duty: int;
    sequence: int;
    timerPeriod: int;
    timerCounter: int;
    lengthCounter: int;
    envelope: Envelope;
    sweepEnabled: bool;
    sweepPeriod: int;
    sweepNegate: bool;
    sweepShift: int;
    sweepReload: bool;
    sweepDivider: int;
    fct writeControl(value) {
        self.duty <<(value shr 6) band 0x03;
        self.envelope.loop <<(value band 0x20) != 0;
        self.envelope.constantVolume <<(value band 0x10) != 0;
        self.envelope.volume << value band 0x0F;
    }
    fct writeSweep(value) {
        self.sweepEnabled <<(value band 0x80) != 0;
        self.sweepPeriod <<((value shr 4) band 0x07) + 1;
        self.sweepNegate <<(value band 0x08) != 0;
        self.sweepShift << value band 0x07;
        self.sweepReload << true;
    }
    fct writeTimerLow(value) {
        self.timerPeriod <<(self.timerPeriod band 0x0700) bor(value band 0xFF);
    }
    fct writeTimerHigh(value) {
        self.timerPeriod <<(self.timerPeriod band 0x00FF) bor((value band 0x07) shl 8);
        if (self.enabled) {
            self.lengthCounter << lengthValue((value shr 3) band 0x1F);
        }
        self.sequence << 0;
        self.envelope.restart();
    }
    fct sweepTarget() {
        var delta << self.timerPeriod shr self.sweepShift;
        if (self.sweepNegate) {
            if (self.channelOne) {
                return self.timerPeriod - delta - 1;
            }
            return self.timerPeriod - delta;
        }
        self.timerPeriod + delta;
    }
    fct sweepMuted() {
        self.timerPeriod < 8 or self.sweepTarget() > 0x07FF or self.sweepTarget() < 0;
    }
    fct tickTimer() {
        if (self.timerCounter == 0) {
            self.timerCounter << self.timerPeriod;
            self.sequence <<(self.sequence + 1) band 0x07;
        } else {
            self.timerCounter << self.timerCounter - 1;
        }
    }
    fct quarterFrame() {
        self.envelope.clock();
    }
    fct halfFrame() {
        if (!self.envelope.loop and self.lengthCounter > 0) {
            self.lengthCounter << self.lengthCounter - 1;
        }
        if (self.sweepDivider == 0) {
            if (self.sweepEnabled and self.sweepShift > 0 and!self.sweepMuted()) {
                self.timerPeriod << self.sweepTarget();
            }
            self.sweepDivider << self.sweepPeriod;
        } else {
            self.sweepDivider << self.sweepDivider - 1;
        }
        if (self.sweepReload) {
            self.sweepReload << false;
            self.sweepDivider << self.sweepPeriod;
        }
    }
    fct output() {
        if (!self.enabled or self.lengthCounter == 0 or self.sweepMuted()) {
            return 0;
        }
        if (dutyBit(self.duty, self.sequence) == 0) {
            return 0;
        }
        self.envelope.output();
    }
}

/// Triangle channel with linear and length counters.
pub struct TriangleChannel {
    enabled: bool;
    sequence: int;
    timerPeriod: int;
    timerCounter: int;
    lengthCounter: int;
    linearCounter: int;
    linearReload: int;
    controlFlag: bool;
    reloadFlag: bool;
    fct writeControl(value) {
        self.controlFlag <<(value band 0x80) != 0;
        self.linearReload << value band 0x7F;
    }
    fct writeTimerLow(value) {
        self.timerPeriod <<(self.timerPeriod band 0x0700) bor(value band 0xFF);
    }
    fct writeTimerHigh(value) {
        self.timerPeriod <<(self.timerPeriod band 0x00FF) bor((value band 0x07) shl 8);
        if (self.enabled) {
            self.lengthCounter << lengthValue((value shr 3) band 0x1F);
        }
        self.reloadFlag << true;
    }
    fct tickTimer() {
        if (self.timerCounter == 0) {
            self.timerCounter << self.timerPeriod;
            if (self.enabled and self.lengthCounter > 0 and self.linearCounter > 0 and self.timerPeriod > 1) {
                self.sequence <<(self.sequence + 1) band 0x1F;
            }
        } else {
            self.timerCounter << self.timerCounter - 1;
        }
    }
    fct quarterFrame() {
        if (self.reloadFlag) {
            self.linearCounter << self.linearReload;
        } else {
            if (self.linearCounter > 0) {
                self.linearCounter << self.linearCounter - 1;
            }
        }
        if (!self.controlFlag) {
            self.reloadFlag << false;
        }
    }
    fct halfFrame() {
        if (!self.controlFlag and self.lengthCounter > 0) {
            self.lengthCounter << self.lengthCounter - 1;
        }
    }
    fct output() {
        if (!self.enabled or self.lengthCounter == 0 or self.linearCounter == 0 or self.timerPeriod < 2) {
            return 0;
        }
        triangleValue(self.sequence);
    }
}

/// Noise channel with the hardware-style 15-bit LFSR.
pub struct NoiseChannel {
    enabled: bool;
    mode: bool;
    shiftRegister: int;
    timerPeriod: int;
    timerCounter: int;
    lengthCounter: int;
    envelope: Envelope;
    fct writeControl(value) {
        self.envelope.loop <<(value band 0x20) != 0;
        self.envelope.constantVolume <<(value band 0x10) != 0;
        self.envelope.volume << value band 0x0F;
    }
    fct writePeriod(value) {
        self.mode <<(value band 0x80) != 0;
        self.timerPeriod << noisePeriod(value band 0x0F);
    }
    fct writeLength(value) {
        if (self.enabled) {
            self.lengthCounter << lengthValue((value shr 3) band 0x1F);
        }
        self.envelope.restart();
    }
    fct tickTimer() {
        if (self.timerCounter == 0) {
            self.timerCounter << self.timerPeriod;
            var tap << 1;
            if (self.mode) {
                tap << 6;
            }
            var feedback <<(self.shiftRegister band 0x01) bxor((self.shiftRegister shr tap) band 0x01);
            self.shiftRegister <<(self.shiftRegister shr 1) bor(feedback shl 14);
        } else {
            self.timerCounter << self.timerCounter - 1;
        }
    }
    fct quarterFrame() {
        self.envelope.clock();
    }
    fct halfFrame() {
        if (!self.envelope.loop and self.lengthCounter > 0) {
            self.lengthCounter << self.lengthCounter - 1;
        }
    }
    fct output() {
        if (!self.enabled or self.lengthCounter == 0 or(self.shiftRegister band 0x01) != 0) {
            return 0;
        }
        self.envelope.output();
    }
}

/// Delta modulation channel state. Memory fetches are supplied by the console bus.
pub struct DmcChannel {
    enabled: bool;
    irqEnabled: bool;
    loop: bool;
    irq: bool;
    timerPeriod: int;
    timerCounter: int;
    outputLevel: int;
    sampleAddress: int;
    sampleLength: int;
    currentAddress: int;
    bytesRemaining: int;
    sampleBuffer: int;
    sampleBufferEmpty: bool;
    shiftRegister: int;
    bitsRemaining: int;
    silence: bool;
    fct restart() {
        self.currentAddress << self.sampleAddress;
        self.bytesRemaining << self.sampleLength;
    }
    fct writeControl(value) {
        self.irqEnabled <<(value band 0x80) != 0;
        self.loop <<(value band 0x40) != 0;
        self.timerPeriod << dmcPeriod(value band 0x0F);
        if (!self.irqEnabled) {
            self.irq << false;
        }
    }
    fct tickTimer() {
        if (self.timerCounter == 0) {
            self.timerCounter << self.timerPeriod;
            if (!self.silence) {
                if ((self.shiftRegister band 0x01) != 0) {
                    if (self.outputLevel <= 125) {
                        self.outputLevel << self.outputLevel + 2;
                    }
                } else {
                    if (self.outputLevel >= 2) {
                        self.outputLevel << self.outputLevel - 2;
                    }
                }
            }
            self.shiftRegister << self.shiftRegister shr 1;
            self.bitsRemaining << self.bitsRemaining - 1;
            if (self.bitsRemaining == 0) {
                self.bitsRemaining << 8;
                if (self.sampleBufferEmpty) {
                    self.silence << true;
                } else {
                    self.silence << false;
                    self.shiftRegister << self.sampleBuffer;
                    self.sampleBufferEmpty << true;
                }
            }
        } else {
            self.timerCounter << self.timerCounter - 1;
        }
    }
}

/// Global APU frame sequencer, interrupt and sample-clock state.
pub struct ApuCore {
    cycle: u64;
    frameCycle: int;
    fiveStep: bool;
    irqInhibit: bool;
    frameIrq: bool;
    sampleDivider: int;
    sampleCount: u64;
    sampleWrite: int;
}

/// Creates a reset APU package and deterministic PCM ring buffer.
pub fct create() {
    var core << ApuCore(0u64, 0, false, false, false, 0, 0u64, 0);
    var pulse1 << PulseChannel(false, true, 0, 0, 0, 0, 0, Envelope(false, false, false, 0, 0, 0), false, 1, false, 0, false, 0);
    var pulse2 << PulseChannel(false, false, 0, 0, 0, 0, 0, Envelope(false, false, false, 0, 0, 0), false, 1, false, 0, false, 0);
    var triangle << TriangleChannel(false, 0, 0, 0, 0, 0, 0, false, false);
    var noise << NoiseChannel(false, false, 1, 4, 0, 0, Envelope(false, false, false, 0, 0, 0));
    var dmc << DmcChannel(false, false, false, false, 428, 0, 0, 0xC000, 1, 0xC000, 0, 0, true, 0, 8, true);
    {
        "core": core, "pulse1": pulse1, "pulse2": pulse2, "triangle": triangle, "noise": noise, "dmc": dmc, "samples": bytes(constants.AUDIO_BUFFER_BYTES)
    };
}
fct quarterFrame(state) {
    state["pulse1"].quarterFrame();
    state["pulse2"].quarterFrame();
    state["triangle"].quarterFrame();
    state["noise"].quarterFrame();
}
fct halfFrame(state) {
    state["pulse1"].halfFrame();
    state["pulse2"].halfFrame();
    state["triangle"].halfFrame();
    state["noise"].halfFrame();
}
fct clockFrameSequencer(state) {
    var core << state["core"];
    core.frameCycle << core.frameCycle + 1;
    if (!core.fiveStep) {
        if (core.frameCycle == 3729 or core.frameCycle == 11186) {
            quarterFrame(state);
        }
        if (core.frameCycle == 7457) {
            quarterFrame(state);
            halfFrame(state);
        }
        if (core.frameCycle >= 14915) {
            quarterFrame(state);
            halfFrame(state);
            if (!core.irqInhibit) {
                core.frameIrq << true;
            }
            core.frameCycle << 0;
        }
    } else {
        if (core.frameCycle == 3729 or core.frameCycle == 11186) {
            quarterFrame(state);
        }
        if (core.frameCycle == 7457 or core.frameCycle >= 18641) {
            quarterFrame(state);
            halfFrame(state);
            if (core.frameCycle >= 18641) {
                core.frameCycle << 0;
            }
        }
    }
}
fct mixSample(state) {
    var pulse << state["pulse1"].output() + state["pulse2"].output();
    var triangle << state["triangle"].output();
    var noise << state["noise"].output();
    var dmc << state["dmc"].outputLevel;
    var mixed << 32 +(pulse * 3) +(triangle * 2) +(noise * 2) + dmc;
    if (mixed < 0) {
        mixed << 0;
    }
    if (mixed > 255) {
        mixed << 255;
    }
    mixed;
}
fct writeSample(state) {
    var core << state["core"];
    state["samples"][core.sampleWrite] << u8(mixSample(state));
    core.sampleWrite <<(core.sampleWrite + 1) % constants.AUDIO_BUFFER_BYTES;
    core.sampleCount << u64(core.sampleCount + 1u64);
}

/// Advances the APU by one CPU cycle.
pub fct tick(state) {
    var core << state["core"];
    core.cycle << u64(core.cycle + 1u64);
    state["triangle"].tickTimer();
    state["dmc"].tickTimer();
    if ((core.cycle % 2u64) == 0u64) {
        state["pulse1"].tickTimer();
        state["pulse2"].tickTimer();
        state["noise"].tickTimer();
    }
    clockFrameSequencer(state);
    core.sampleDivider << core.sampleDivider + 1;
    if (core.sampleDivider >= 40) {
        core.sampleDivider << 0;
        writeSample(state);
    }
}

/// Writes an APU register in the CPU-visible $4000-$4017 range.
pub fct cpuWrite(state, address, value) {
    var byteValue << toInt(value) band 0xFF;
    if (address == 0x4000) {
        state["pulse1"].writeControl(byteValue);
        return true;
    }
    if (address == 0x4001) {
        state["pulse1"].writeSweep(byteValue);
        return true;
    }
    if (address == 0x4002) {
        state["pulse1"].writeTimerLow(byteValue);
        return true;
    }
    if (address == 0x4003) {
        state["pulse1"].writeTimerHigh(byteValue);
        return true;
    }
    if (address == 0x4004) {
        state["pulse2"].writeControl(byteValue);
        return true;
    }
    if (address == 0x4005) {
        state["pulse2"].writeSweep(byteValue);
        return true;
    }
    if (address == 0x4006) {
        state["pulse2"].writeTimerLow(byteValue);
        return true;
    }
    if (address == 0x4007) {
        state["pulse2"].writeTimerHigh(byteValue);
        return true;
    }
    if (address == 0x4008) {
        state["triangle"].writeControl(byteValue);
        return true;
    }
    if (address == 0x400A) {
        state["triangle"].writeTimerLow(byteValue);
        return true;
    }
    if (address == 0x400B) {
        state["triangle"].writeTimerHigh(byteValue);
        return true;
    }
    if (address == 0x400C) {
        state["noise"].writeControl(byteValue);
        return true;
    }
    if (address == 0x400E) {
        state["noise"].writePeriod(byteValue);
        return true;
    }
    if (address == 0x400F) {
        state["noise"].writeLength(byteValue);
        return true;
    }
    if (address == 0x4010) {
        state["dmc"].writeControl(byteValue);
        return true;
    }
    if (address == 0x4011) {
        state["dmc"].outputLevel << byteValue band 0x7F;
        return true;
    }
    if (address == 0x4012) {
        state["dmc"].sampleAddress << 0xC000 +(byteValue * 64);
        return true;
    }
    if (address == 0x4013) {
        state["dmc"].sampleLength <<(byteValue * 16) + 1;
        return true;
    }
    if (address == 0x4015) {
        var pulse1 << state["pulse1"];
        var pulse2 << state["pulse2"];
        var triangle << state["triangle"];
        var noise << state["noise"];
        var dmc << state["dmc"];
        pulse1.enabled <<(byteValue band 0x01) != 0;
        pulse2.enabled <<(byteValue band 0x02) != 0;
        triangle.enabled <<(byteValue band 0x04) != 0;
        noise.enabled <<(byteValue band 0x08) != 0;
        dmc.enabled <<(byteValue band 0x10) != 0;
        if (!pulse1.enabled) {
            pulse1.lengthCounter << 0;
        }
        if (!pulse2.enabled) {
            pulse2.lengthCounter << 0;
        }
        if (!triangle.enabled) {
            triangle.lengthCounter << 0;
        }
        if (!noise.enabled) {
            noise.lengthCounter << 0;
        }
        dmc.irq << false;
        if (!dmc.enabled) {
            dmc.bytesRemaining << 0;
        } else {
            if (dmc.bytesRemaining == 0) {
                dmc.restart();
            }
        }
        return true;
    }
    if (address == 0x4017) {
        var core << state["core"];
        core.fiveStep <<(byteValue band 0x80) != 0;
        core.irqInhibit <<(byteValue band 0x40) != 0;
        if (core.irqInhibit) {
            core.frameIrq << false;
        }
        core.frameCycle << 0;
        if (core.fiveStep) {
            quarterFrame(state);
            halfFrame(state);
        }
        return true;
    }
    false;
}

/// Reads $4015 status and clears the frame IRQ latch.
pub fct cpuReadStatus(state) {
    var value << 0;
    if (state["pulse1"].lengthCounter > 0) {
        value << value bor 0x01;
    }
    if (state["pulse2"].lengthCounter > 0) {
        value << value bor 0x02;
    }
    if (state["triangle"].lengthCounter > 0) {
        value << value bor 0x04;
    }
    if (state["noise"].lengthCounter > 0) {
        value << value bor 0x08;
    }
    if (state["dmc"].bytesRemaining > 0) {
        value << value bor 0x10;
    }
    if (state["core"].frameIrq) {
        value << value bor 0x40;
    }
    if (state["dmc"].irq) {
        value << value bor 0x80;
    }
    state["core"].frameIrq << false;
    value;
}

/// Returns whether either APU interrupt source is asserted.
pub fct irqLine(state) {
    state["core"].frameIrq or state["dmc"].irq;
}

/// Returns whether the DMC sample buffer requires a CPU-bus byte.
pub fct dmcNeedsByte(state) {
    var dmc << state["dmc"];
    dmc.enabled and dmc.sampleBufferEmpty and dmc.bytesRemaining > 0;
}

/// Returns the current DMC CPU-bus address.
pub fct dmcAddress(state) {
    state["dmc"].currentAddress;
}

/// Supplies one DMC sample byte fetched by the console bus.
pub fct supplyDmcByte(state, value) {
    var dmc << state["dmc"];
    if (!dmcNeedsByte(state)) {
        return false;
    }
    dmc.sampleBuffer << value band 0xFF;
    dmc.sampleBufferEmpty << false;
    dmc.currentAddress <<(dmc.currentAddress + 1) band 0xFFFF;
    if (dmc.currentAddress < 0x8000) {
        dmc.currentAddress << 0x8000;
    }
    dmc.bytesRemaining << dmc.bytesRemaining - 1;
    if (dmc.bytesRemaining == 0) {
        if (dmc.loop) {
            dmc.restart();
        } else {
            if (dmc.irqEnabled) {
                dmc.irq << true;
            }
        }
    }
    true;
}

/// Stable digest of the deterministic PCM ring buffer.
pub fct sampleDigest(state) {
    sha256(state["samples"]);
}

/// Total number of generated PCM samples.
pub fct sampleCount(state) {
    state["core"].sampleCount;
}

/// Exposes one deterministic sample for tests and headless frontends.
pub fct sampleAt(state, index) {
    toInt(state["samples"][index % constants.AUDIO_BUFFER_BYTES]);
}
