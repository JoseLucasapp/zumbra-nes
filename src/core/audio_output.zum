import "constants.zum" as constants;
import "apu.zum" as apu;
/// Cursor used by a frontend while draining the APU ring buffer.
pub struct AudioCursor {
    absolute: u64;
    resamplePhase: int;
}
pub fct createCursor() {
    AudioCursor(0u64, 0);
}

/// Copies all samples produced since the cursor, capped to one ring-buffer span.
pub fct drain(state, cursor) {
    var total << apu.sampleCount(state);
    var start << cursor.absolute;
    if (total < start) {
        start << total;
    }
    var available << total - start;
    if (available > u64(constants.AUDIO_BUFFER_BYTES)) {
        start << total - u64(constants.AUDIO_BUFFER_BYTES);
        available << u64(constants.AUDIO_BUFFER_BYTES);
    }
    var count << toInt(available);
    var output << bytes(count);
    var index << 0;
    while (index < count) {
        output[index] << u8(apu.sampleAt(state, toInt(start + u64(index))));
        index << index + 1;
    }
    cursor.absolute << total;
    output;
}
fct clampByte(value) {
    if (value < 0) {
        return 0;
    }
    if (value > 255) {
        return 255;
    }
    return value;
}

/// The frozen Zumbra 0.14.5 SDL bridge treats byte value 32 as silence and
/// expands every byte step by 1024 into signed 16-bit PCM. Feeding the APU's
/// full 0..255 mixer range directly into that bridge wraps int16 and creates
/// severe digital distortion. Compress only at the frontend boundary so the
/// deterministic/headless APU remains unchanged.
fct desktopSafeSample(value) {
    var centered << toInt(value) - 32;
    var safe << 32 +(centered / 7);
    if (safe < 0) {
        safe << 0;
    }
    if (safe > 63) {
        safe << 63;
    }
    return safe;
}

/// APU's established 40-CPU-cycle sample divider produces 1,789,773/40 Hz.
/// SDL consumes 44,100 Hz. Resample only the desktop stream with an exact
/// integer accumulator, avoiding both queue drift and changes to NES/APU timing.
fct resampleForDesktop(samples, cursor) {
    var count << sizeOf(samples);
    if (count == 0) {
        return samples;
    }
    var numerator << 1764000;
    var denominator << 1789773;
    var startPhase << cursor.resamplePhase;
    var outputCount <<(startPhase +(count * numerator)) / denominator;
    var output << bytes(outputCount);
    var phase << startPhase;
    var sourceIndex << 0;
    var outputIndex << 0;
    while (sourceIndex < count) {
        phase << phase + numerator;
        if (phase >= denominator) {
            phase << phase - denominator;
            output[outputIndex] << u8(desktopSafeSample(samples[sourceIndex]));
            outputIndex << outputIndex + 1;
        }
        sourceIndex << sourceIndex + 1;
    }
    cursor.resamplePhase << phase;
    return output;
}

/// Drains audio for the live desktop path with a small cleanup filter.
/// The APU itself is untouched; filtering, safe-range conversion and 44.1 kHz
/// resampling happen only at the SDL boundary.
pub fct drainClean(state, cursor) {
    var raw << drain(state, cursor);
    var count << sizeOf(raw);
    if (count == 0) {
        return raw;
    }
    var filtered << bytes(count);
    if (count <= 2) {
        var smallIndex << 0;
        while (smallIndex < count) {
            filtered[smallIndex] << raw[smallIndex];
            smallIndex << smallIndex + 1;
        }
        return resampleForDesktop(filtered, cursor);
    }
    filtered[0] << raw[0];
    var index << 1;
    while (index < count - 1) {
        var previous << toInt(raw[index - 1]);
        var current << toInt(raw[index]);
        var next << toInt(raw[index + 1]);
        var sample <<(previous + current + current + next) / 4;
        filtered[index] << u8(clampByte(sample));
        index << index + 1;
    }
    filtered[count - 1] << raw[count - 1];
    if (count > 8) {
        filtered[0] << u8((toInt(filtered[0]) + toInt(filtered[1])) / 2);
        filtered[1] << u8((toInt(filtered[0]) + toInt(filtered[1]) + toInt(filtered[2])) / 3);
        filtered[count - 2] << u8((toInt(filtered[count - 3]) + toInt(filtered[count - 2]) + toInt(filtered[count - 1])) / 3);
        filtered[count - 1] << u8((toInt(filtered[count - 2]) + toInt(filtered[count - 1])) / 2);
    }
    return resampleForDesktop(filtered, cursor);
}
