/// Canonical 64-color NES palette stored as RGB triplets.
var COLORS0 <<[84, 84, 84, 0, 30, 116, 8, 16, 144, 48, 0, 136, 68, 0, 100, 92, 0, 48, 84, 4, 0, 60, 24, 0, 32, 42, 0, 8, 58, 0, 0, 64, 0, 0, 60, 0, 0, 50, 60, 0, 0, 0, 0, 0, 0, 0, 0, 0];
var COLORS1 <<[152, 150, 152, 8, 76, 196, 48, 50, 236, 92, 30, 228, 136, 20, 176, 160, 20, 100, 152, 34, 32, 120, 60, 0, 84, 90, 0, 40, 114, 0, 8, 124, 0, 0, 118, 40, 0, 102, 120, 0, 0, 0, 0, 0, 0, 0, 0, 0];
var COLORS2 <<[236, 238, 236, 76, 154, 236, 120, 124, 236, 176, 98, 236, 228, 84, 236, 236, 88, 180, 236, 106, 100, 212, 136, 32, 160, 170, 0, 116, 196, 0, 76, 208, 32, 56, 204, 108, 56, 180, 204, 60, 60, 60, 0, 0, 0, 0, 0, 0];
var COLORS3 <<[236, 238, 236, 168, 204, 236, 188, 188, 236, 212, 178, 236, 236, 174, 236, 236, 174, 212, 236, 180, 176, 228, 196, 144, 204, 210, 120, 180, 222, 120, 168, 226, 144, 152, 226, 180, 160, 214, 228, 160, 162, 160, 0, 0, 0, 0, 0, 0];
fct component(index) {
    if (index < 48) {
        return COLORS0[index];
    }
    if (index < 96) {
        return COLORS1[index - 48];
    }
    if (index < 144) {
        return COLORS2[index - 96];
    }
    COLORS3[index - 144];
}

/// Allocates one reusable byte-ordered RGBA output buffer for a framebuffer.
pub fct rgbaBuffer(framebuffer) {
    bytes(sizeOf(framebuffer) * 4);
}

/// Converts PPU palette indices into an existing byte-ordered RGBA pixel buffer.
pub fct writeRgba(framebuffer, output) {
    var index << 0;
    while (index < sizeOf(framebuffer)) {
        var color << toInt(framebuffer[index]) band 0x3F;
        var source << color * 3;
        var destination << index * 4;
        output[destination] << u8(component(source));
        output[destination + 1] << u8(component(source + 1));
        output[destination + 2] << u8(component(source + 2));
        output[destination + 3] << 255u8;
        index << index + 1;
    }
    output;
}

/// Converts PPU palette indices into byte-ordered RGBA pixels.
pub fct rgba(framebuffer) {
    writeRgba(framebuffer, rgbaBuffer(framebuffer));
}

/// Returns one RGB triplet for diagnostics and tests.
pub fct color(index) {
    var normalized <<(toInt(index) band 0x3F) * 3;
    [component(normalized), component(normalized + 1), component(normalized + 2)];
}
