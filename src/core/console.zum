import "apu.zum" as apu;
import "bus.zum" as bus;
import "cpu6502.zum" as cpu6502;
import "ppu.zum" as ppu;
/// Master scheduler and hardware accounting for one NES console.
pub struct ConsoleCore {
    cpuCycles: u64;
    ppuCycles: u64;
    apuCycles: u64;
    instructions: u64;
    dmaCycles: u64;
    dmcStallCycles: u64;
    frames: u64;
    running: bool;
}
fct updateInterruptLines(machine) {
    var processor << machine["cpu"];
    var systemBus << machine["bus"];
    if (bus.takePpuNmi(systemBus)) {
        processor.requestNmi();
    }
    if (bus.apuIrq(systemBus)) {
        processor.requestIrq();
    } else {
        processor.clearIrq();
    }
}
fct tickHardware(machine) {
    var core << machine["core"];
    var systemBus << machine["bus"];
    if (systemBus["audioEnabled"]) {
        apu.tick(systemBus["apu"]);
        core.apuCycles << u64(core.apuCycles + 1u64);
    }
    var ppuIndex << 0;
    while (ppuIndex < 3) {
        ppu.tick(systemBus["ppu"]);
        core.ppuCycles << u64(core.ppuCycles + 1u64);
        ppuIndex << ppuIndex + 1;
    }
    core.cpuCycles << u64(core.cpuCycles + 1u64);
    core.frames << systemBus["ppu"]["core"].frame;
    updateInterruptLines(machine);
}
fct serviceDmc(machine) {
    var core << machine["core"];
    var processor << machine["cpu"];
    var systemBus << machine["bus"];
    if (!systemBus["audioEnabled"]) {
        return 0;
    }
    var apuState << systemBus["apu"];
    if (!apu.dmcNeedsByte(apuState)) {
        return 0;
    }
    var value << bus.read(systemBus, apu.dmcAddress(apuState));
    apu.supplyDmcByte(apuState, value);
    var stall << 0;
    while (stall < 4) {
        tickHardware(machine);
        stall << stall + 1;
    }
    processor.cycles << processor.cycles + 4;
    core.dmcStallCycles << u64(core.dmcStallCycles + 4u64);
    4;
}
fct runHardwareCyclesInternal(machine, count, serviceDmcFetches) {
    var index << 0;
    while (index < count) {
        tickHardware(machine);
        if (serviceDmcFetches) {
            serviceDmc(machine);
        }
        index << index + 1;
    }
}

/// Creates a complete Z21 console and clocks the seven reset cycles.
pub fct create(cart) {
    var systemBus << bus.create(cart);
    var processor << cpu6502.create(systemBus);
    var machine << {
        "core": ConsoleCore(0u64, 0u64, 0u64, 0u64, 0u64, 0u64, 0u64, true), "bus": systemBus, "cpu": processor
    };
    runHardwareCyclesInternal(machine, 7, true);
    machine;
}

/// Runs one CPU instruction and all associated PPU/APU/DMA/DMC cycles.
pub fct stepInstruction(machine) {
    var core << machine["core"];
    if (!core.running or machine["cpu"].halted) {
        return 0;
    }
    updateInterruptLines(machine);
    var used << machine["cpu"].step(machine["bus"]);
    runHardwareCyclesInternal(machine, used, true);
    var dmaStall << bus.performDma(machine["bus"], toInt(core.cpuCycles));
    if (dmaStall > 0) {
        machine["cpu"].cycles << machine["cpu"].cycles + dmaStall;
        core.dmaCycles << u64(core.dmaCycles + u64(dmaStall));
        runHardwareCyclesInternal(machine, dmaStall, true);
    }
    core.instructions << u64(machine["cpu"].instructions);
    used + dmaStall;
}

/// Advances hardware clocks without executing CPU instructions.
pub fct runHardwareCycles(machine, count) {
    runHardwareCyclesInternal(machine, count, true);
    machine["core"].cpuCycles;
}

/// Runs up to `instructionLimit` instructions for the current frame without blocking the host event loop.
pub fct runFrameSlice(machine, instructionLimit) {
    var ppuState << machine["bus"]["ppu"];
    if (ppuState["core"].frameComplete) {
        ppu.clearFrameComplete(ppuState);
    }
    var executed << 0;
    while (!ppuState["core"].frameComplete and executed < instructionLimit and!machine["cpu"].halted) {
        stepInstruction(machine);
        executed << executed + 1;
    }
    {
        "executed": executed, "frameComplete": ppuState["core"].frameComplete
    };
}

/// Runs a desktop hot-loop slice without allocating a result dictionary per micro-slice.
/// Positive return value: frame not complete. Negative return value: frame complete.
pub fct runFrameSliceCode(machine, instructionLimit) {
    var ppuState << machine["bus"]["ppu"];
    if (ppuState["core"].frameComplete) {
        ppu.clearFrameComplete(ppuState);
    }
    var executed << 0;
    while (!ppuState["core"].frameComplete and executed < instructionLimit and!machine["cpu"].halted) {
        stepInstruction(machine);
        executed << executed + 1;
    }
    if (ppuState["core"].frameComplete) {
        return 0 - executed;
    }
    executed;
}

/// Enables or disables expensive visible PPU rendering while preserving PPU timing.
pub fct setVideoOutput(machine, enabled) {
    ppu.setRenderOutput(machine["bus"]["ppu"], enabled);
    true;
}

/// Returns whether the PPU has completed the currently rendered frame.
pub fct frameComplete(machine) {
    machine["bus"]["ppu"]["core"].frameComplete;
}

/// Clears the current PPU frame-complete flag before starting another frame.
pub fct clearFrameComplete(machine) {
    ppu.clearFrameComplete(machine["bus"]["ppu"]);
    true;
}

/// Runs instructions until the current PPU frame completes.
pub fct runFrame(machine, instructionLimit) {
    ppu.clearFrameComplete(machine["bus"]["ppu"]);
    var executed << 0;
    while (!frameComplete(machine) and executed < instructionLimit and!machine["cpu"].halted) {
        var slice << runFrameSlice(machine, 512);
        executed << executed + slice["executed"];
    }
    if (!frameComplete(machine)) {
        panic("console frame did not complete before the instruction limit");
    }
    executed;
}

/// Sets one controller's full button mask.
pub fct setController(machine, port, buttons) {
    bus.setController(machine["bus"], port, buttons);
}

/// Returns the current framebuffer digest.
pub fct frameDigest(machine) {
    ppu.frameDigest(machine["bus"]["ppu"]);
}

/// Returns the current audio-ring digest.
pub fct audioDigest(machine) {
    apu.sampleDigest(machine["bus"]["apu"]);
}

/// Stops future instruction execution while leaving state inspectable.
pub fct stop(machine) {
    machine["core"].running << false;
}
