/// External interrupt and lifecycle contract shared with the CPU core.
pub struct CpuPort {
    resetPending: bool;
    nmiPending: bool;
    irqPending: bool;
    halted: bool;
}

/// Observable Ricoh 2C02 timing state.
pub struct PpuPort {
    scanline: int;
    dot: int;
    frame: u64;
    frameComplete: bool;
    nmiPending: bool;
}

/// Observable APU timing, IRQ and sample state.
pub struct ApuPort {
    sampleClock: u64;
    frameCounter: int;
    frameIrq: bool;
    dmcIrq: bool;
}

/// Observable serial controller state.
pub struct ControllerPort {
    buttons: int;
    latched: int;
    index: int;
    strobe: bool;
}

/// Observable OAM DMA transaction state.
pub struct DmaPort {
    pending: bool;
    page: int;
    cycles: int;
}
pub fct createCpuPort() {
    CpuPort(true, false, false, false);
}
pub fct createPpuPort() {
    PpuPort(-1, 0, 0u64, false, false);
}
pub fct createApuPort() {
    ApuPort(0u64, 0, false, false);
}
pub fct createControllerPort() {
    ControllerPort(0, 0, 0, false);
}
pub fct createDmaPort() {
    DmaPort(false, 0, 0);
}
