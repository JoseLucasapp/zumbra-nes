import "catalog.zum" as catalog;
import "../persistence/store.zum" as store;
import "../compatibility/local.zum" as compatibility;
/// Installs the deterministic offline achievement pack for one local ROM digest.
pub fct install(db, info, timestamp) {
    compatibility.register(db, info, timestamp);
    var pack << catalog.packForInfo(info);
    var current << store.achievementGameMetadata(db, info.digest);
    var replacePack << sizeOf(current) == 0;
    if (!replacePack) {
        replacePack << current[0]["source"] != pack["id"] or toInt(current[0]["pack_version"]) != toInt(pack["version"]);
    }
    if (replacePack) {
        store.clearAchievementsForGame(db, info.digest);
    }
    store.registerAchievementGame(db, info.digest, pack["title"], pack["id"], pack["version"], timestamp);
    store.seedAchievements(db, info.digest, pack["definitions"]);
    store.achievementSummary(db, info.digest);
}

/// Default manual backup path for local achievement and library data.
pub fct backupPath() {
    return "zumbra-nes-achievements-export.json";
}

/// Exports the local offline achievement database snapshot to a JSON file.
pub fct exportBackup(db, path) {
    store.exportJson(db, path);
    return fileExists(path);
}

/// Imports a local offline achievement database snapshot from a JSON file.
pub fct importBackup(db, path) {
    store.importJson(db, path);
    true;
}

/// Returns a compact local-only achievement summary for a ROM digest.
pub fct summary(db, digest) {
    store.achievementSummary(db, digest);
}

/// Returns all local achievement definitions/progress for the current ROM.
pub fct rows(db, digest) {
    store.achievementRows(db, digest);
}
