/// Pure-Zumbra bridge over the official desktop/media runtime introduced in Zumbra 0.14.3.
pub const COMMAND_OPEN << 0;
pub const COMMAND_PAUSE << 1;
pub const COMMAND_RESET << 2;
pub const COMMAND_FULLSCREEN << 3;
pub const COMMAND_MUTE << 4;
pub const COMMAND_FRAME << 5;
pub const COMMAND_LIBRARY << 6;
pub const COMMAND_ACHIEVEMENTS << 7;
pub const COMMAND_CONTROLS << 8;
pub const COMMAND_FASTER << 9;
pub const COMMAND_VOLUME_DOWN << 10;
pub const COMMAND_VOLUME_UP << 11;
pub const COMMAND_EXPORT << 12;
pub const COMMAND_IMPORT << 13;
pub const COMMAND_CLOSE << 14;
pub const COMMAND_SCALE_DOWN << 15;
pub const COMMAND_SCALE_UP << 16;
pub const COMMAND_FPS << 17;
pub const COMMAND_VSYNC << 18;
pub const COMMAND_SAVE_STATE << 19;
pub const COMMAND_LOAD_STATE << 20;
pub const COMMAND_DEBUGGER << 21;
pub const COMMAND_STEP_INSTRUCTION << 22;
pub const COMMAND_SLOT_0 << 23;
pub const COMMAND_SLOT_1 << 24;
pub const COMMAND_SLOT_2 << 25;
pub const COMMAND_SLOT_3 << 26;
pub const COMMAND_SLOT_4 << 27;
pub const COMMAND_SLOT_5 << 28;
pub const COMMAND_SLOT_6 << 29;
pub const COMMAND_SLOT_7 << 30;
pub const COMMAND_SLOT_8 << 31;
pub const COMMAND_SLOT_9 << 32;
fct commandStates() {
    var values <<[];
    var index << 0;
    while (index < 33) {
        addToArrayEnd(values, false);
        index << index + 1;
    }
    return values;
}

/// Creates the official Zumbra desktop application and window.
pub fct create(title, scale, vsync, fullscreen, requestedHeadless) {
    var backend << "auto";
    if (requestedHeadless) {
        backend << "headless";
    }
    var app << desktopApp({
        "name": "Zumbra NES", "version": "0.5.63", "identifier": "dev.zumbra.nes", "backend": backend, "quitOnLastWindow": true, "closeOnRequest": true
    });
    var window << desktopWindow(app, {
        "title": title, "width": 256 * scale, "height": 240 * scale, "resizable": true, "highDPI": true, "fullscreen": fullscreen
    });
    desktopWindowSetVSync(window, vsync);
    return {
        "app": app, "window": window, "closed": false, "commands": commandStates(), "volume": 80, "muted": false, "headless": desktopBackend(app) == "headless"
    };
}
pub fct headless(context) {
    return context["headless"];
}
pub fct valid(context) {
    return desktopWindowOpen(context["window"]);
}
pub fct error(context) {
    context;
    return "desktop runtime initialization failed";
}
pub fct destroy(context) {
    desktopWindowClose(context["window"]);
    desktopClose(context["app"]);
    return true;
}
pub fct poll(context) {
    var event << desktopPoll(context["app"], 0);
    if (toString(event) == "null") {
        return false;
    } // Do not index untyped desktop event payloads in the release frontend.
    // On the real SDL backend some window events arrive as non-dictionary runtime
    // values; reading event["type"] aborts with "field access requires a struct or
    // enum type" before the menu or ROM can open. The close condition is still
    // handled by desktopWindowOpen() in shouldClose() and by Esc in desktop.zum.
    return true;
}

/// Drains a bounded batch of pending desktop events so the WM never marks the emulator as hung.
pub fct pollAll(context, maxEvents) {
    var handled << 0;
    while (handled < maxEvents and poll(context)) {
        handled << handled + 1;
    }
    return handled;
}
pub fct shouldClose(context) {
    return context["closed"] or!desktopWindowOpen(context["window"]);
}
pub fct keyDown(context, scancode) {
    return desktopKeyDown(context["app"], scancode);
}
pub fct gamepadButton(context, player, button) {
    return desktopGamepadButton(context["app"], player, button);
}
pub fct commandPressed(context, command, scancode) {
    var current << keyDown(context, scancode);
    var previous << context["commands"][command];
    context["commands"][command] << current;
    return current and!previous;
}
pub fct present(context, pixels) {
    desktopWindowPresentRGBA(context["window"], pixels, 256, 240);
    return true;
}
pub fct queueAudio(context, samples) {
    desktopAudioQueue(context["app"], samples, context["volume"], context["muted"]);
    return true;
}
pub fct audioQueued(context) {
    return desktopAudioQueued(context["app"]);
}
pub fct setVolume(context, volume) {
    context["volume"] << volume;
    return true;
}
pub fct setScale(context, scale) {
    desktopWindowSetSize(context["window"], 256 * scale, 240 * scale);
    return true;
}
pub fct setVsync(context, vsync) {
    desktopWindowSetVSync(context["window"], vsync);
    return true;
}
pub fct setMuted(context, muted) {
    context["muted"] << muted;
    return true;
}
pub fct setFullscreen(context, fullscreen) {
    desktopWindowSetFullscreen(context["window"], fullscreen);
    return true;
}
pub fct setStatus(context, status) {
    desktopWindowSetTitle(context["window"], "Zumbra NES — " + status);
    return true;
}
pub fct notify(context, title, message) {
    // Keep notifications on the stable window-title path. The platform
    // notification bridge is not required for emulation and should never be able
    // to crash the emulator shell.
    desktopWindowSetTitle(context["window"], "Zumbra NES — " + title + ": " + message);
    return true;
}
pub fct ticks(context) {
    context;
    return profileNowNs() / 1000000u64;
}
pub fct delay(context, milliseconds) {
    context;
    sleepMs(milliseconds);
    return true;
}
pub fct unixSeconds() {
    return unixTimeSeconds();
}
pub fct initialRom() {
    var args << processArgs();
    if (sizeOf(args) > 1) {
        return args[1];
    }
    return "";
}
pub fct dataPath(context) {
    context;
    // Avoid desktopPaths() in the safety build. The live SDL backend can
    // return a platform-specific value that is not safe for string-field indexing
    // in native mode. Use the current project directory until the desktop bridge
    // exposes a typed path object.
    return ".";
}
pub fct pickRom(context) {
    var selected << desktopPickFile(context["app"], {
        "title": "Open NES/Famicom ROM", "multiple": false
    });
    if (sizeOf(selected) == 0) {
        return "";
    }
    return selected[0];
}
pub fct showPanel(context, title, body) {
    body;
    // The release shell must not open experimental panels or platform
    // notifications at startup. Keep the command non-fatal and expose the current
    // section in the title bar only.
    desktopWindowSetTitle(context["window"], "Zumbra NES — " + title);
    return true;
}
pub fct firstKeyDown(context) {
    var code << 0;
    while (code < 512) {
        if (keyDown(context, code)) {
            return code;
        }
        code << code + 1;
    }
    return-1;
}
pub fct captureKey(context, prompt) {
    notify(context, "Remapping", prompt);
    while (firstKeyDown(context) >= 0) {
        poll(context);
        sleepMs(10);
    }
    while (!shouldClose(context)) {
        poll(context);
        var code << firstKeyDown(context);
        if (code == 41) {
            return-1;
        }
        if (code >= 0) {
            while (keyDown(context, code)) {
                poll(context);
                sleepMs(10);
            }
            return code;
        }
        sleepMs(10);
    }
    return-1;
}
