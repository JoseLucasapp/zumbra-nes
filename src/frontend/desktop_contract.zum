/// UI-neutral state rendered by desktop frontends.
pub struct DesktopFrontendState {
    title: string;
    romLoaded: bool;
    paused: bool;
    status: string;
}

/// Creates the initial desktop frontend contract without initializing SDL.
pub fct createState() {
    DesktopFrontendState("Zumbra NES", false, true, "frontend ready");
}
