import "../core/bus.zum" as bus;
import "../core/cartridge.zum" as cartridge;
import "../core/clock.zum" as clock;
import "../core/cpu6502.zum" as cpu6502;
/// Stable diagnostic report produced without opening a window.
pub struct DiagnosticReport {
    sourcePath: string;
    format: string;
    mapper: u16;
    prgBytes: int;
    chrBytes: int;
    digest: string;
    resetVector: u16;
    cpuA: int;
    cpuX: int;
    cpuY: int;
    cpuSp: int;
    cpuPc: int;
    cpuStatus: int;
    cpuInstructions: int;
    cpuCoreCycles: int;
    cpuClockCycles: u64;
    ppuCycles: u64;
}

/// Runs deterministic cartridge, bus, CPU and clock diagnostics.
pub fct run(cart) {
    var info << cart["info"];
    var systemBus << bus.create(cart);
    var processor << cpu6502.create(systemBus);
    var scheduler << clock.create();
    scheduler.stepCpu(7u64);
    var executed << 0;
    while (executed < 2) {
        var used << processor.step(systemBus);
        scheduler.stepCpu(u64(used));
        executed << executed + 1;
    }
    var resetLow << bus.read(systemBus, 0xFFFC);
    var resetHigh << bus.read(systemBus, 0xFFFD);
    var resetVector << u16(resetLow) bor(u16(resetHigh) shl 8);
    DiagnosticReport(info.sourcePath, info.header.format, info.header.mapper, sizeOf(cart["prgRom"]), sizeOf(cart["chrMemory"]), info.digest, resetVector, processor.a, processor.x, processor.y, processor.sp, processor.pc, processor.status, processor.instructions, processor.cycles, scheduler.cpuCycles, scheduler.ppuCycles);
}

/// Prints the headless report in a stable VM/native format.
pub fct printReport(report) {
    show("Zumbra NES Z20 CPU 6502");
    show(report.sourcePath);
    show(report.format);
    show(report.mapper);
    show(report.prgBytes);
    show(report.chrBytes);
    show(report.digest);
    show(report.resetVector);
    show(report.cpuA);
    show(report.cpuX);
    show(report.cpuY);
    show(report.cpuSp);
    show(report.cpuPc);
    show(report.cpuStatus);
    show(report.cpuInstructions);
    show(report.cpuCoreCycles);
    show(report.cpuClockCycles);
    show(report.ppuCycles);
}

/// Loads a ROM and executes the deterministic headless frontend.
pub fct runFile(path) {
    var cart << cartridge.load(path);
    var report << run(cart);
    printReport(report);
    report;
}
