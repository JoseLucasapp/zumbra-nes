import "../core/cartridge.zum" as cartridge;
import "../core/console.zum" as console;
import "../core/audio_output.zum" as audioOutput;
import "../core/mapper.zum" as mapper;
import "../core/palette.zum" as palette;
import "../stdlib/data.zum" as jsondata;
import "native_bridge.zum" as native;
fct introRect(output, x, y, width, height, red, green, blue) {
    var yy << y;
    while (yy < y + height) {
        var xx << x;
        while (xx < x + width) {
            if (xx >= 0 and xx < 256 and yy >= 0 and yy < 240) {
                var destination <<(yy * 256 + xx) * 4;
                output[destination] << u8(red);
                output[destination + 1] << u8(green);
                output[destination + 2] << u8(blue);
                output[destination + 3] << 255u8;
            }
            xx << xx + 1;
        }
        yy << yy + 1;
    }
    return true;
}
fct fontRows(code) {
    if (code == 32) {
        return[0, 0, 0, 0, 0, 0, 0];
    }
    if (code == 45) {
        return[0, 0, 0, 31, 0, 0, 0];
    }
    if (code == 46) {
        return[0, 0, 0, 0, 0, 12, 12];
    }
    if (code == 47) {
        return[1, 2, 4, 8, 16, 0, 0];
    }
    if (code == 48) {
        return[14, 17, 19, 21, 25, 17, 14];
    }
    if (code == 49) {
        return[4, 12, 4, 4, 4, 4, 14];
    }
    if (code == 50) {
        return[14, 17, 1, 2, 4, 8, 31];
    }
    if (code == 51) {
        return[30, 1, 1, 14, 1, 1, 30];
    }
    if (code == 52) {
        return[2, 6, 10, 18, 31, 2, 2];
    }
    if (code == 53) {
        return[31, 16, 30, 1, 1, 17, 14];
    }
    if (code == 54) {
        return[6, 8, 16, 30, 17, 17, 14];
    }
    if (code == 55) {
        return[31, 1, 2, 4, 8, 8, 8];
    }
    if (code == 56) {
        return[14, 17, 17, 14, 17, 17, 14];
    }
    if (code == 57) {
        return[14, 17, 17, 15, 1, 2, 12];
    }
    if (code == 58) {
        return[0, 12, 12, 0, 12, 12, 0];
    }
    if (code == 61) {
        return[0, 0, 31, 0, 31, 0, 0];
    }
    if (code == 65) {
        return[14, 17, 17, 31, 17, 17, 17];
    }
    if (code == 66) {
        return[30, 17, 17, 30, 17, 17, 30];
    }
    if (code == 67) {
        return[14, 17, 16, 16, 16, 17, 14];
    }
    if (code == 68) {
        return[30, 17, 17, 17, 17, 17, 30];
    }
    if (code == 69) {
        return[31, 16, 16, 30, 16, 16, 31];
    }
    if (code == 70) {
        return[31, 16, 16, 30, 16, 16, 16];
    }
    if (code == 71) {
        return[14, 17, 16, 23, 17, 17, 15];
    }
    if (code == 72) {
        return[17, 17, 17, 31, 17, 17, 17];
    }
    if (code == 73) {
        return[14, 4, 4, 4, 4, 4, 14];
    }
    if (code == 74) {
        return[7, 2, 2, 2, 18, 18, 12];
    }
    if (code == 75) {
        return[17, 18, 20, 24, 20, 18, 17];
    }
    if (code == 76) {
        return[16, 16, 16, 16, 16, 16, 31];
    }
    if (code == 77) {
        return[17, 27, 21, 21, 17, 17, 17];
    }
    if (code == 78) {
        return[17, 25, 21, 19, 17, 17, 17];
    }
    if (code == 79) {
        return[14, 17, 17, 17, 17, 17, 14];
    }
    if (code == 80) {
        return[30, 17, 17, 30, 16, 16, 16];
    }
    if (code == 81) {
        return[14, 17, 17, 17, 21, 18, 13];
    }
    if (code == 82) {
        return[30, 17, 17, 30, 20, 18, 17];
    }
    if (code == 83) {
        return[15, 16, 16, 14, 1, 1, 30];
    }
    if (code == 84) {
        return[31, 4, 4, 4, 4, 4, 4];
    }
    if (code == 85) {
        return[17, 17, 17, 17, 17, 17, 14];
    }
    if (code == 86) {
        return[17, 17, 17, 17, 17, 10, 4];
    }
    if (code == 87) {
        return[17, 17, 17, 21, 21, 21, 10];
    }
    if (code == 88) {
        return[17, 17, 10, 4, 10, 17, 17];
    }
    if (code == 89) {
        return[17, 17, 10, 4, 4, 4, 4];
    }
    if (code == 90) {
        return[31, 1, 2, 4, 8, 16, 31];
    }
    return[31, 17, 2, 4, 4, 0, 4];
}
fct drawTinyChar(output, x, y, scale, code, red, green, blue) {
    var rows << fontRows(code);
    var row << 0;
    while (row < 7) {
        var bits << rows[row];
        var column << 0;
        while (column < 5) {
            var bit << 1 shl(4 - column);
            if ((bits band bit) != 0) {
                introRect(output, x + column * scale, y + row * scale, scale, scale, red, green, blue);
            }
            column << column + 1;
        }
        row << row + 1;
    }
    return true;
}
fct drawTinyCodes(output, x, y, scale, codes, count, red, green, blue) {
    var index << 0;
    while (index < count) {
        drawTinyChar(output, x + index *(scale * 6), y, scale, codes[index], red, green, blue);
        index << index + 1;
    }
    return true;
}
fct drawKeyCode(output, x, y, scale, code, red, green, blue) {
    if (code == 4) {
        drawTinyCodes(output, x, y, scale,[65], 1, red, green, blue);
        return true;
    }
    if (code == 7) {
        drawTinyCodes(output, x, y, scale,[68], 1, red, green, blue);
        return true;
    }
    if (code == 13) {
        drawTinyCodes(output, x, y, scale,[74], 1, red, green, blue);
        return true;
    }
    if (code == 14) {
        drawTinyCodes(output, x, y, scale,[75], 1, red, green, blue);
        return true;
    }
    if (code == 22) {
        drawTinyCodes(output, x, y, scale,[83], 1, red, green, blue);
        return true;
    }
    if (code == 26) {
        drawTinyCodes(output, x, y, scale,[87], 1, red, green, blue);
        return true;
    }
    if (code == 27) {
        drawTinyCodes(output, x, y, scale,[88], 1, red, green, blue);
        return true;
    }
    if (code == 29) {
        drawTinyCodes(output, x, y, scale,[90], 1, red, green, blue);
        return true;
    }
    if (code == 40) {
        drawTinyCodes(output, x, y, scale,[69, 78, 84, 69, 82], 5, red, green, blue);
        return true;
    }
    if (code == 41) {
        drawTinyCodes(output, x, y, scale,[69, 83, 67], 3, red, green, blue);
        return true;
    }
    if (code == 43) {
        drawTinyCodes(output, x, y, scale,[84, 65, 66], 3, red, green, blue);
        return true;
    }
    if (code == 44) {
        drawTinyCodes(output, x, y, scale,[83, 80, 65, 67, 69], 5, red, green, blue);
        return true;
    }
    if (code == 79) {
        drawTinyCodes(output, x, y, scale,[82, 73, 71, 72, 84], 5, red, green, blue);
        return true;
    }
    if (code == 80) {
        drawTinyCodes(output, x, y, scale,[76, 69, 70, 84], 4, red, green, blue);
        return true;
    }
    if (code == 81) {
        drawTinyCodes(output, x, y, scale,[68, 79, 87, 78], 4, red, green, blue);
        return true;
    }
    if (code == 82) {
        drawTinyCodes(output, x, y, scale,[85, 80], 2, red, green, blue);
        return true;
    }
    if (code == 225 or code == 229) {
        drawTinyCodes(output, x, y, scale,[83, 72, 73, 70, 84], 5, red, green, blue);
        return true;
    }
    drawTinyCodes(output, x, y, scale,[83, 67], 2, red, green, blue);
    return true;
}
fct drawSettingsRow(output, y, number, labelCodes, labelCount, keyCode) {
    drawTinyChar(output, 26, y, 1, number, 236, 238, 236);
    drawTinyCodes(output, 40, y, 1, labelCodes, labelCount, 236, 238, 236);
    drawTinyChar(output, 106, y, 1, 61, 236, 238, 236);
    drawKeyCode(output, 124, y, 1, keyCode, 120, 220, 255);
    return true;
}
fct drawSettingsOverlay(output, controls, captureAction, gamepadMask) {
    introRect(output, 10, 8, 236, 224, 8, 12, 28);
    introRect(output, 12, 10, 232, 220, 24, 28, 58);
    introRect(output, 14, 12, 228, 20, 42, 56, 116);
    drawTinyCodes(output, 22, 18, 1,[90, 85, 77, 66, 82, 65, 32, 78, 69, 83, 32, 48, 46, 53, 46, 52, 48], 17, 236, 238, 236);
    drawTinyCodes(output, 22, 42, 1,[83, 69, 84, 84, 73, 78, 71, 83], 8, 255, 220, 120);
    drawSettingsRow(output, 62, 49,[65], 1, controls["p1A"]);
    drawSettingsRow(output, 78, 50,[66], 1, controls["p1B"]);
    drawSettingsRow(output, 94, 51,[83, 69, 76, 69, 67, 84], 6, controls["p1Select"]);
    drawSettingsRow(output, 110, 52,[83, 84, 65, 82, 84], 5, controls["p1Start"]);
    drawSettingsRow(output, 126, 53,[85, 80], 2, controls["p1Up"]);
    drawSettingsRow(output, 142, 54,[68, 79, 87, 78], 4, controls["p1Down"]);
    drawSettingsRow(output, 158, 55,[76, 69, 70, 84], 4, controls["p1Left"]);
    drawSettingsRow(output, 174, 56,[82, 73, 71, 72, 84], 5, controls["p1Right"]);
    drawTinyCodes(output, 22, 196, 1,[70, 49, 32, 72, 73, 68, 69, 32, 32, 70, 50, 32, 82, 69, 83, 69, 84], 17, 236, 238, 236);
    drawTinyCodes(output, 22, 210, 1,[49, 45, 56, 32, 82, 69, 77, 65, 80, 32, 32, 69, 83, 67, 32, 69, 88, 73, 84], 19, 236, 238, 236);
    if (captureAction != "") {
        introRect(output, 18, 34, 220, 18, 72, 30, 30);
        drawTinyCodes(output, 26, 40, 1,[80, 82, 69, 83, 83, 32, 78, 69, 87, 32, 75, 69, 89], 13, 255, 220, 120);
    }
    if (gamepadMask != 0) {
        drawTinyCodes(output, 144, 42, 1,[88, 66, 79, 88, 32, 79, 78], 7, 120, 255, 160);
    } else {
        drawTinyCodes(output, 144, 42, 1,[88, 66, 79, 88, 32, 65, 85, 84, 79], 9, 120, 220, 255);
    }
    return true;
}
fct le16(bytesData, offset) {
    return toInt(bytesData[offset]) +(toInt(bytesData[offset + 1]) shl 8);
}
fct le32(bytesData, offset) {
    return toInt(bytesData[offset]) +(toInt(bytesData[offset + 1]) shl 8) +(toInt(bytesData[offset + 2]) shl 16) +(toInt(bytesData[offset + 3]) shl 24);
}
fct fillIntroFallback(output) {
    var y << 0;
    while (y < 240) {
        var x << 0;
        while (x < 256) {
            var destination <<(y * 256 + x) * 4;
            output[destination] << 17u8;
            output[destination + 1] << 19u8;
            output[destination + 2] << 24u8;
            output[destination + 3] << 255u8;
            x << x + 1;
        }
        y << y + 1;
    }
    introRect(output, 42, 82, 172, 76, 30, 36, 58);
    introRect(output, 48, 88, 160, 64, 226, 235, 255);
    introRect(output, 54, 94, 148, 52, 30, 36, 58);
    return true;
}
fct glyphCell(output, baseX, baseY, scale, column, row, red, green, blue) {
    introRect(output, baseX + column * scale, baseY + row * scale, scale - 1, scale - 1, red, green, blue);
    return true;
}
fct glyphN(output, x, y, scale, red, green, blue) {
    var row << 0;
    while (row < 7) {
        glyphCell(output, x, y, scale, 0, row, red, green, blue);
        glyphCell(output, x, y, scale, 4, row, red, green, blue);
        row << row + 1;
    }
    glyphCell(output, x, y, scale, 1, 1, red, green, blue);
    glyphCell(output, x, y, scale, 2, 2, red, green, blue);
    glyphCell(output, x, y, scale, 3, 3, red, green, blue);
    return true;
}
fct glyphO(output, x, y, scale, red, green, blue) {
    var column << 0;
    while (column < 5) {
        glyphCell(output, x, y, scale, column, 0, red, green, blue);
        glyphCell(output, x, y, scale, column, 6, red, green, blue);
        column << column + 1;
    }
    var row << 1;
    while (row < 6) {
        glyphCell(output, x, y, scale, 0, row, red, green, blue);
        glyphCell(output, x, y, scale, 4, row, red, green, blue);
        row << row + 1;
    }
    return true;
}
fct glyphR(output, x, y, scale, red, green, blue) {
    var row << 0;
    while (row < 7) {
        glyphCell(output, x, y, scale, 0, row, red, green, blue);
        row << row + 1;
    }
    var column << 1;
    while (column < 4) {
        glyphCell(output, x, y, scale, column, 0, red, green, blue);
        glyphCell(output, x, y, scale, column, 3, red, green, blue);
        column << column + 1;
    }
    glyphCell(output, x, y, scale, 4, 1, red, green, blue);
    glyphCell(output, x, y, scale, 4, 2, red, green, blue);
    glyphCell(output, x, y, scale, 2, 4, red, green, blue);
    glyphCell(output, x, y, scale, 3, 5, red, green, blue);
    glyphCell(output, x, y, scale, 4, 6, red, green, blue);
    return true;
}
fct glyphM(output, x, y, scale, red, green, blue) {
    var row << 0;
    while (row < 7) {
        glyphCell(output, x, y, scale, 0, row, red, green, blue);
        glyphCell(output, x, y, scale, 4, row, red, green, blue);
        row << row + 1;
    }
    glyphCell(output, x, y, scale, 1, 1, red, green, blue);
    glyphCell(output, x, y, scale, 2, 2, red, green, blue);
    glyphCell(output, x, y, scale, 3, 1, red, green, blue);
    return true;
}
fct glyphE(output, x, y, scale, red, green, blue) {
    var row << 0;
    while (row < 7) {
        glyphCell(output, x, y, scale, 0, row, red, green, blue);
        row << row + 1;
    }
    var column << 1;
    while (column < 5) {
        glyphCell(output, x, y, scale, column, 0, red, green, blue);
        glyphCell(output, x, y, scale, column, 3, red, green, blue);
        glyphCell(output, x, y, scale, column, 6, red, green, blue);
        column << column + 1;
    }
    return true;
}
fct glyphS(output, x, y, scale, red, green, blue) {
    var column << 0;
    while (column < 5) {
        glyphCell(output, x, y, scale, column, 0, red, green, blue);
        glyphCell(output, x, y, scale, column, 3, red, green, blue);
        glyphCell(output, x, y, scale, column, 6, red, green, blue);
        column << column + 1;
    }
    glyphCell(output, x, y, scale, 0, 1, red, green, blue);
    glyphCell(output, x, y, scale, 0, 2, red, green, blue);
    glyphCell(output, x, y, scale, 4, 4, red, green, blue);
    glyphCell(output, x, y, scale, 4, 5, red, green, blue);
    return true;
}
fct glyphC(output, x, y, scale, red, green, blue) {
    var column << 0;
    while (column < 5) {
        glyphCell(output, x, y, scale, column, 0, red, green, blue);
        glyphCell(output, x, y, scale, column, 6, red, green, blue);
        column << column + 1;
    }
    var row << 1;
    while (row < 6) {
        glyphCell(output, x, y, scale, 0, row, red, green, blue);
        row << row + 1;
    }
    return true;
}
fct paintNoRomShell(output) {
    var y << 0;
    while (y < 240) {
        var x << 0;
        while (x < 256) {
            var destination <<(y * 256 + x) * 4;
            output[destination] << 10u8;
            output[destination + 1] << 12u8;
            output[destination + 2] << 18u8;
            output[destination + 3] << 255u8;
            x << x + 1;
        }
        y << y + 1;
    }
    introRect(output, 14, 14, 228, 4, 114, 232, 179);
    introRect(output, 14, 222, 228, 4, 114, 232, 179);
    introRect(output, 14, 14, 4, 212, 114, 232, 179);
    introRect(output, 238, 14, 4, 212, 114, 232, 179);
    glyphN(output, 32, 68, 6, 114, 232, 179);
    glyphO(output, 68, 68, 6, 114, 232, 179);
    glyphR(output, 116, 68, 6, 114, 232, 179);
    glyphO(output, 152, 68, 6, 114, 232, 179);
    glyphM(output, 188, 68, 6, 114, 232, 179);
    glyphE(output, 70, 152, 3, 226, 235, 255);
    glyphS(output, 91, 152, 3, 226, 235, 255);
    glyphC(output, 112, 152, 3, 226, 235, 255);
    introRect(output, 142, 162, 44, 3, 226, 235, 255);
    return output;
}
fct paintIntroBitmap(output, path) {
    if (!fileExists(path)) {
        return false;
    }
    var romBytes << readBytes(path);
    if (sizeOf(romBytes) < 54) {
        return false;
    }
    if (toInt(romBytes[0]) != 66 or toInt(romBytes[1]) != 77) {
        return false;
    }
    var pixelOffset << le32(romBytes, 10);
    var width << le32(romBytes, 18);
    var height << le32(romBytes, 22);
    var bits << le16(romBytes, 28);
    if (width < 256 or height < 240 or bits != 24) {
        return false;
    }
    var rowStride <<((width * 3 + 3) / 4) * 4;
    var cropX <<(width - 256) / 2;
    var cropY <<(height - 240) / 2;
    var y << 0;
    while (y < 240) {
        var x << 0;
        while (x < 256) {
            var sourceY << height - 1 -(y + cropY);
            var sourceX << x + cropX;
            var source << pixelOffset + sourceY * rowStride + sourceX * 3;
            var destination <<(y * 256 + x) * 4;
            if (source + 2 < sizeOf(romBytes)) {
                output[destination] << romBytes[source + 2];
                output[destination + 1] << romBytes[source + 1];
                output[destination + 2] << romBytes[source];
                output[destination + 3] << 255u8;
            } else {
                output[destination] << 17u8;
                output[destination + 1] << 19u8;
                output[destination + 2] << 24u8;
                output[destination + 3] << 255u8;
            }
            x << x + 1;
        }
        y << y + 1;
    }
    return true;
}
fct paintIntroRgba(output) {
    if (paintIntroBitmap(output, "assets/zumbra-nes.bmp")) {
        return output;
    }
    fillIntroFallback(output);
    return output;
}
fct showStartupIntro(context, headlessMode) {
    if (headlessMode) {
        return true;
    }
    var pixels << bytes(256 * 240 * 4);
    paintIntroRgba(pixels);
    var started << native.ticks(context);
    while (!native.shouldClose(context) and native.ticks(context) - started < 1200u64) {
        native.present(context, pixels);
        native.pollAll(context, 32);
        native.delay(context, 50);
        started << started;
    }
    return true;
}
fct stableShell(context, headlessMode) {
    var pixels << bytes(256 * 240 * 4);
    paintNoRomShell(pixels);
    native.present(context, pixels);
    native.setStatus(context, "Zumbra NES 0.5.45 | O/Enter abrir ROM | Z demo Zebra | Esc/F12 sair");
    var running << true;
    var frames << 0u64;
    var lastPresent << native.ticks(context);
    var selectedPath << "";
    var lastOpen << false;
    var lastDemo << false;
    var lastHelp << false;
    while (running and!native.shouldClose(context)) {
        native.pollAll(context, 32);
        if (native.keyDown(context, 41) or native.keyDown(context, 69)) {
            running << false;
        }
        var openNow << native.keyDown(context, 18) or native.keyDown(context, 40) or native.keyDown(context, 44);
        if (openNow and!lastOpen and!headlessMode) {
            selectedPath << native.pickRom(context);
            if (selectedPath != "") {
                running << false;
            } else {
                native.setStatus(context, "Zumbra NES 0.5.45 | nenhuma ROM escolhida | O/Enter abrir | Z demo Zebra");
                running << running;
            }
        }
        lastOpen << openNow;
        var demoNow << native.keyDown(context, 29);
        if (demoNow and!lastDemo and!headlessMode and fileExists("fixtures/homebrew/zebra-platformer.nes")) {
            selectedPath << "fixtures/homebrew/zebra-platformer.nes";
            running << false;
        }
        lastDemo << demoNow;
        var helpNow << native.keyDown(context, 6) or native.keyDown(context, 11);
        if (helpNow and!lastHelp) {
            native.setStatus(context, "AJUDA | O/Enter abrir ROM | Z demo | F1 settings | 1-8 remap em jogo | F2 reset | Esc/F12 sair");
            running << running;
        }
        lastHelp << helpNow;
        var nowTicks << native.ticks(context);
        if (nowTicks - lastPresent >= 250u64) {
            native.present(context, pixels);
            lastPresent << nowTicks;
        }
        native.delay(context, 16);
        if (headlessMode) {
            frames << frames + 1u64;
            if (frames >= 2u64) {
                running << false;
            }
        }
    }
    return {
        "frames": frames, "path": selectedPath
    };
}
fct openGameRuntime(path) {
    if (path == "" or!fileExists(path)) {
        return {
            "ok": false, "message": "ROM file not found", "path": path
        };
    }
    var romBytes << readBytes(path);
    var inspection << cartridge.inspectImage(romBytes);
    if (!inspection.ok) {
        return {
            "ok": false, "message": inspection.message, "path": path
        };
    }
    var cart << cartridge.fromBytes(romBytes, path);
    var info << cart["info"];
    var mapperId << info.header.mapper;
    var compatibility << mapper.compatibility(mapperId);
    if (!compatibility["ok"]) {
        return {
            "ok": false, "message": compatibility["message"], "path": path
        };
    }
    var machine << console.create(cart);
    return {
        "ok": true, "message": "ok", "path": path, "machine": machine, "mapper": mapperId, "rgba": palette.rgbaBuffer(machine["bus"]["ppu"]["framebuffer"])
    };
} /// Runtime-editable player 1 bindings persisted as JSON in the project directory.
fct controlDefaults() {
    return {
        "p1A": 29, "p1B": 27, "p1Select": 43, "p1Start": 40, "p1Up": 82, "p1Down": 81, "p1Left": 80, "p1Right": 79
    };
}
fct controlFile() {
    return "zumbra-nes-controls.json";
}
fct controlValue(source, key, fallback) {
    var value << source[key];
    if (toString(value) == "null") {
        return fallback;
    }
    return toInt(value);
}
fct loadControlSettings() {
    var controls << controlDefaults();
    if (fileExists(controlFile())) {
        var loaded << jsondata.readJson(controlFile());
        controls["p1A"] << controlValue(loaded, "p1A", controls["p1A"]);
        controls["p1B"] << controlValue(loaded, "p1B", controls["p1B"]);
        controls["p1Select"] << controlValue(loaded, "p1Select", controls["p1Select"]);
        controls["p1Start"] << controlValue(loaded, "p1Start", controls["p1Start"]);
        controls["p1Up"] << controlValue(loaded, "p1Up", controls["p1Up"]);
        controls["p1Down"] << controlValue(loaded, "p1Down", controls["p1Down"]);
        controls["p1Left"] << controlValue(loaded, "p1Left", controls["p1Left"]);
        controls["p1Right"] << controlValue(loaded, "p1Right", controls["p1Right"]);
    }
    return controls;
}
fct saveControlSettings(controls) {
    jsondata.writeJson(controlFile(), controls, true);
    return true;
}
fct keyName(code) {
    if (code == 4) {
        return "A";
    }
    if (code == 7) {
        return "D";
    }
    if (code == 13) {
        return "J";
    }
    if (code == 14) {
        return "K";
    }
    if (code == 22) {
        return "S";
    }
    if (code == 26) {
        return "W";
    }
    if (code == 27) {
        return "X";
    }
    if (code == 29) {
        return "Z";
    }
    if (code == 40) {
        return "Enter";
    }
    if (code == 41) {
        return "Esc";
    }
    if (code == 43) {
        return "Tab";
    }
    if (code == 44) {
        return "Space";
    }
    if (code == 58) {
        return "F1";
    }
    if (code == 59) {
        return "F2";
    }
    if (code == 60) {
        return "F3";
    }
    if (code == 69) {
        return "F12";
    }
    if (code == 79) {
        return "Right";
    }
    if (code == 80) {
        return "Left";
    }
    if (code == 81) {
        return "Down";
    }
    if (code == 82) {
        return "Up";
    }
    if (code == 88) {
        return "Keypad Enter";
    }
    if (code == 225) {
        return "Left Shift";
    }
    if (code == 229) {
        return "Right Shift";
    }
    return "scancode " + toString(code);
}
fct controlSummary(controls) {
    return "A=" + keyName(controls["p1A"]) + " B=" + keyName(controls["p1B"]) + " Select=" + keyName(controls["p1Select"]) + " Start=" + keyName(controls["p1Start"]) + " U=" + keyName(controls["p1Up"]) + " D=" + keyName(controls["p1Down"]) + " L=" + keyName(controls["p1Left"]) + " R=" + keyName(controls["p1Right"]);
}
fct showControlSettings(context, controls) {
    native.setStatus(context, "SETTINGS | F1 fecha | 1-8 remap | F2 reset | " + controlSummary(controls));
    return true;
}
fct settingsAction(context) {
    if (native.keyDown(context, 30)) {
        return "p1A";
    }
    if (native.keyDown(context, 31)) {
        return "p1B";
    }
    if (native.keyDown(context, 32)) {
        return "p1Select";
    }
    if (native.keyDown(context, 33)) {
        return "p1Start";
    }
    if (native.keyDown(context, 34)) {
        return "p1Up";
    }
    if (native.keyDown(context, 35)) {
        return "p1Down";
    }
    if (native.keyDown(context, 36)) {
        return "p1Left";
    }
    if (native.keyDown(context, 37)) {
        return "p1Right";
    }
    return "";
}
fct actionLabel(action) {
    if (action == "p1A") {
        return "A";
    }
    if (action == "p1B") {
        return "B";
    }
    if (action == "p1Select") {
        return "Select";
    }
    if (action == "p1Start") {
        return "Start";
    }
    if (action == "p1Up") {
        return "Up";
    }
    if (action == "p1Down") {
        return "Down";
    }
    if (action == "p1Left") {
        return "Left";
    }
    if (action == "p1Right") {
        return "Right";
    }
    return action;
}
fct remapControl(context, controls, action) {
    native.setStatus(context, "SETTINGS | pressione nova tecla para " + actionLabel(action) + " | Esc cancela");
    var code << native.captureKey(context, "Press new key for " + actionLabel(action));
    if (code == 58 or code == 59 or code == 69 or code == 41) {
        native.setStatus(context, "SETTINGS | tecla reservada/cancelada: " + keyName(code));
    } else {
        if (code >= 0) {
            controls[action] << code;
            saveControlSettings(controls);
            native.setStatus(context, "SETTINGS | " + actionLabel(action) + " = " + keyName(code) + " | salvo");
        } else {
            native.setStatus(context, "SETTINGS | remapeamento cancelado");
        }
    }
    showControlSettings(context, controls);
    return true;
}
fct stablePlayerOneMask(context, controls) {
    var mask << 0;
    var keyA << controls["p1A"];
    var keyB << controls["p1B"];
    var keySelect << controls["p1Select"];
    var keyStart << controls["p1Start"];
    var keyUp << controls["p1Up"];
    var keyDownControl << controls["p1Down"];
    var keyLeft << controls["p1Left"];
    var keyRight << controls["p1Right"];
    if ((keyA >= 0 and native.keyDown(context, keyA)) or native.keyDown(context, 13)) {
        mask << mask bor 0x01;
    }
    if ((keyB >= 0 and native.keyDown(context, keyB)) or native.keyDown(context, 14)) {
        mask << mask bor 0x02;
    }
    if ((keySelect >= 0 and native.keyDown(context, keySelect)) or native.keyDown(context, 225) or native.keyDown(context, 229)) {
        mask << mask bor 0x04;
    }
    if ((keyStart >= 0 and native.keyDown(context, keyStart)) or native.keyDown(context, 44) or native.keyDown(context, 88)) {
        mask << mask bor 0x08;
    }
    if ((keyUp >= 0 and native.keyDown(context, keyUp)) or native.keyDown(context, 26)) {
        mask << mask bor 0x10;
    }
    if ((keyDownControl >= 0 and native.keyDown(context, keyDownControl)) or native.keyDown(context, 22)) {
        mask << mask bor 0x20;
    }
    if ((keyLeft >= 0 and native.keyDown(context, keyLeft)) or native.keyDown(context, 4)) {
        mask << mask bor 0x40;
    }
    if ((keyRight >= 0 and native.keyDown(context, keyRight)) or native.keyDown(context, 7)) {
        mask << mask bor 0x80;
    }

    // Hardware never allows opposite directions at the same time. Filtering here
    // prevents stuck multicart/title menus when SDL repeats or a gamepad reports
    // two opposing d-pad states during connection noise.
    if ((mask band 0x10) != 0 and(mask band 0x20) != 0) {
        mask << mask band 0xCF;
    }
    if ((mask band 0x40) != 0 and(mask band 0x80) != 0) {
        mask << mask band 0x3F;
    }
    return mask;
}
fct gamepadDown(context, button) {
    return native.gamepadButton(context, 0, button) or native.gamepadButton(context, 1, button);
}
fct gamepadPlayerOneMask(context) {
    var mask << 0;
    if (gamepadDown(context, 0) or gamepadDown(context, 2)) {
        mask << mask bor 0x01;
    }
    if (gamepadDown(context, 1) or gamepadDown(context, 3)) {
        mask << mask bor 0x02;
    }
    if (gamepadDown(context, 4)) {
        mask << mask bor 0x04;
    }
    if (gamepadDown(context, 6) or gamepadDown(context, 7)) {
        mask << mask bor 0x08;
    }
    if (gamepadDown(context, 11)) {
        mask << mask bor 0x10;
    }
    if (gamepadDown(context, 12)) {
        mask << mask bor 0x20;
    }
    if (gamepadDown(context, 13)) {
        mask << mask bor 0x40;
    }
    if (gamepadDown(context, 14)) {
        mask << mask bor 0x80;
    }
    if ((mask band 0x10) != 0 and(mask band 0x20) != 0) {
        mask << mask band 0xCF;
    }
    if ((mask band 0x40) != 0 and(mask band 0x80) != 0) {
        mask << mask band 0x3F;
    }
    return mask;
}
fct inputLockedMask(rawMask, lockFrames) {
    if (lockFrames > 0) {
        return 0;
    }
    return rawMask;
}
fct maskEdge(current, previous, bit) {
    return(current band bit) != 0 and(previous band bit) == 0;
}
fct edgeBits(current, previous, bits) {
    var edges << 0;
    if ((bits band 0x01) != 0 and maskEdge(current, previous, 0x01)) {
        edges << edges bor 0x01;
    }
    if ((bits band 0x02) != 0 and maskEdge(current, previous, 0x02)) {
        edges << edges bor 0x02;
    }
    if ((bits band 0x04) != 0 and maskEdge(current, previous, 0x04)) {
        edges << edges bor 0x04;
    }
    if ((bits band 0x08) != 0 and maskEdge(current, previous, 0x08)) {
        edges << edges bor 0x08;
    }
    if ((bits band 0x10) != 0 and maskEdge(current, previous, 0x10)) {
        edges << edges bor 0x10;
    }
    if ((bits band 0x20) != 0 and maskEdge(current, previous, 0x20)) {
        edges << edges bor 0x20;
    }
    if ((bits band 0x40) != 0 and maskEdge(current, previous, 0x40)) {
        edges << edges bor 0x40;
    }
    if ((bits band 0x80) != 0 and maskEdge(current, previous, 0x80)) {
        edges << edges bor 0x80;
    }
    return edges;
}

/// Runs the interactive SDL3 frontend, or a deterministic two-frame headless smoke.
pub fct run() {
    var context << native.create("Zumbra NES 0.5.45", 3, true, false, false);
    var headlessMode << native.headless(context);
    if (!native.valid(context)) {
        show(native.error(context));
        return true;
    }
    native.pollAll(context, 4);
    showStartupIntro(context, headlessMode);
    var initialPath << native.initialRom();
    if (initialPath == "--zebra") {
        initialPath << "fixtures/homebrew/zebra-platformer.nes";
    }
    if (initialPath == "" and headlessMode and fileExists("fixtures/synthetic/z23-visible-frame.nes")) {
        initialPath << "fixtures/synthetic/z23-visible-frame.nes";
    }
    if (initialPath == "") {
        var shellResult << stableShell(context, headlessMode);
        initialPath << shellResult["path"];
        if (initialPath == "") {
            native.destroy(context);
            show("Z23 desktop session complete");
            show(shellResult["frames"]);
            return true;
        }
        showStartupIntro(context, headlessMode);
    }
    var game << openGameRuntime(initialPath);
    if (!game["ok"]) {
        native.destroy(context);
        show(game["message"]);
        return false;
    }
    console.setPerformanceMode(game["machine"], true);
    // 0.5.45: audio is opt-in after performance mode so the desktop queue receives
    // real APU samples. This is slower than silent fast mode, but avoids the
    // confusing "no sound" release behavior.
    console.setAudioOutput(game["machine"], true);
    var audioCursor << audioOutput.createCursor();
    var running << true;
    var paused << false;
    var frames << 0u64;
    var pendingFrame << true;
    var lastPresent << native.ticks(context);
    var lastP << false;
    var mapperId << game["mapper"];
    var controls << loadControlSettings();
    var lastF1 << false;
    var lastF2 << false;
    var lastSettingsAction << "";
    var settingsVisible << false;
    var captureAction << "";
    var inputLock << 12;
    native.setStatus(context, "Zumbra NES 0.5.45 | mapper " + toString(mapperId) + " | F1 settings | gamepad auto | P pausa | F12 sair");
    var loopMemoryMark << runtimeMemoryMark();
    runtimeMemoryResetPeak();
    while (running and!native.shouldClose(context)) {
        var frameStart << native.ticks(context);
        native.pollAll(context, 16);
        if (native.keyDown(context, 41)) {
            if (settingsVisible) {
                settingsVisible << false;
                paused << false;
                captureAction << "";
                inputLock << 10;
                native.setStatus(context, "Zumbra NES 0.5.45 | mapper " + toString(mapperId) + " | F1 settings | F12 sair");
            }
        }
        if (native.keyDown(context, 69)) {
            running << false;
        }
        var pNow << native.keyDown(context, 19);
        if (pNow and!lastP and!settingsVisible) {
            paused <<!paused;
        }
        lastP << pNow;
        var f1Now << native.keyDown(context, 58);
        if (f1Now and!lastF1) {
            settingsVisible <<!settingsVisible;
            paused << settingsVisible;
            captureAction << "";
            inputLock << 8;
            showControlSettings(context, controls);
        }
        lastF1 << f1Now;
        var f2Now << native.keyDown(context, 59);
        if (settingsVisible and f2Now and!lastF2) {
            paused << true;
            controls << controlDefaults();
            saveControlSettings(controls);
            inputLock << 8;
            showControlSettings(context, controls);
        }
        lastF2 << f2Now;
        var selectedSettingAction << "";
        if (settingsVisible) {
            selectedSettingAction << settingsAction(context);
        }
        if (settingsVisible and selectedSettingAction != "" and selectedSettingAction != lastSettingsAction) {
            paused << true;
            captureAction << selectedSettingAction;
            remapControl(context, controls, selectedSettingAction);
            captureAction << "";
            inputLock << 8;
        }
        lastSettingsAction << selectedSettingAction;
        var keyboardMask << stablePlayerOneMask(context, controls);
        var detectedGamepadMask << gamepadPlayerOneMask(context);
        var rawPlayerOneMask << keyboardMask bor detectedGamepadMask;
        if (settingsVisible) {
            rawPlayerOneMask << 0;
        }
        if (inputLock > 0) {
            // 0.5.45: fixed cooldown, not "wait until every button is released".
            // Holding Start/D-pad while a multicart changes banks should not lock
            // out controller input forever or make the title screen look frozen.
            inputLock << inputLock - 1;
            rawPlayerOneMask << 0;
        }
        var playerOneMask << inputLockedMask(rawPlayerOneMask, inputLock);
        console.setController(game["machine"], 1, playerOneMask);
        console.setController(game["machine"], 2, 0);
        if (!paused) {
            if (pendingFrame) {
                console.clearFrameComplete(game["machine"]);
                pendingFrame << false;
            }
            var frameCompleteNow << false;
            var loops << 0;
            // 0.5.45: run toward a real NES frame instead of advancing only a
            // few tiny slices per host frame. The PPU fast-timing path keeps
            // VBlank/NMI moving without per-dot rendering overhead.
            var sliceLimit << 262144;
            var sliceCap << 192;
            if (mapperId == 10 and!headlessMode) {
                sliceLimit << 393216;
                sliceCap << 224;
            }
            if (mapperId == 227 and!headlessMode) {
                sliceLimit << 196608;
                sliceCap << 160;
            }
            while (!frameCompleteNow and!native.shouldClose(context) and loops < sliceCap) {
                var code << console.runFrameSliceCodeFast(game["machine"], sliceLimit);
                if (code < 0) {
                    frameCompleteNow << true;
                }
                loops << loops + 1;
                if ((loops % 16) == 0) {
                    native.pollAll(context, 2);
                }
                if ((loops % 64) == 0) {
                    runtimeMemoryReset(loopMemoryMark);
                }
            }
            runtimeMemoryReset(loopMemoryMark);
            if (frameCompleteNow) {
                pendingFrame << true;
                frames << frames + 1u64;
                var framebuffer << game["machine"]["bus"]["ppu"]["framebuffer"];
                var rgba << palette.writeRgba(framebuffer, game["rgba"]);
                if (settingsVisible) {
                    drawSettingsOverlay(rgba, controls, captureAction, detectedGamepadMask);
                }
                native.present(context, rgba);
                var audioSamples << audioOutput.drainClean(game["machine"]["bus"]["apu"], audioCursor);
                var queuedAudioBytes << native.audioQueued(context);
                // 0.5.45: low-latency queue guard. If the SDL queue is already
                // backed up, drop this frame's drained samples instead of adding
                // late audio. This avoids the dirty/slow "buffer avalanche" sound
                // while keeping the emulator responsive.
                if (sizeOf(audioSamples) > 0 and queuedAudioBytes < 12288) {
                    native.queueAudio(context, audioSamples);
                }
                lastPresent << native.ticks(context);
                runtimeMemoryReset(loopMemoryMark);
            } else {
                native.delay(context, 1);
                pendingFrame << pendingFrame;
            }
        } else {
            var pausedTicks << native.ticks(context);
            if (pausedTicks - lastPresent >= 100u64) {
                console.renderFrameSnapshot(game["machine"]);
                var pausedRgba << palette.writeRgba(game["machine"]["bus"]["ppu"]["framebuffer"], game["rgba"]);
                if (settingsVisible) {
                    drawSettingsOverlay(pausedRgba, controls, captureAction, detectedGamepadMask);
                }
                native.present(context, pausedRgba);
                lastPresent << pausedTicks;
                runtimeMemoryReset(loopMemoryMark);
            }
            native.delay(context, 16);
            paused << paused;
        }
        if (headlessMode and frames >= 2u64) {
            running << false;
        }
        var elapsed << native.ticks(context) - frameStart;
        if (elapsed < 1u64) {
            native.delay(context, 1);
        }
        elapsed << elapsed;
    }
    native.destroy(context);
    show("Z23 desktop session complete");
    show(frames);
    return true;
}
