    }
    if (id == "popeye-score-5000") {
        return "5K SCORE";
    }
    if (id == "popeye-score-10000") {
        return "10K SCORE";
    }
    if (id == "popeye-score-30000") {
        return "30K SCORE";
    }
    if (id == "popeye-score-60000") {
        return "60K SCORE";
    }
    if (id == "popeye-score-100000") {
        return "100K SCORE";
    }
    if (id == "popeye-score-200000") {
        return "200K SCORE";
    }
    if (id == "popeye-round-2") {
        return "ROUND TWO";
    }
    if (id == "popeye-round-3") {
        return "ROUND THREE";
    }
    return "ACHIEVEMENT";
}
fct drawAchievementRow(output, y, row) {
    var unlocked << toInt(row["unlocked"]) == 1;
    if (unlocked) {
        introRect(output, 22, y - 2, 212, 12, 18, 62, 54);
        drawTinyText(output, 28, y, 1, row["title"], 23, 150, 255, 190);
        drawTinyCodes(output, 204, y, 1,[68, 79, 78, 69], 4, 150, 255, 190);
        return true;
    }
    introRect(output, 22, y - 2, 212, 12, 32, 36, 68);
    drawTinyText(output, 28, y, 1, row["title"], 23, 226, 230, 238);
    var progress << toInt(row["progress"]);
    var target << toInt(row["target"]);
    var compact << target >= 10000;
    if (compact) {
        progress << progress / 1000;
        target << target / 1000;
    }
    var progressX << drawTinyNumber(output, 174, y, 1, progress, 120, 220, 255);
    drawTinyChar(output, progressX, y, 1, 47, 120, 220, 255);
    var targetX << drawTinyNumber(output, progressX + 6, y, 1, target, 120, 220, 255);
    if (compact) {
        drawTinyChar(output, targetX, y, 1, 75, 120, 220, 255);
    }
    return true;
}
fct drawAchievementsOverlay(output, rows, summary) {
    introRect(output, 12, 24, 232, 194, 8, 12, 28);
    introRect(output, 14, 26, 228, 190, 24, 28, 58);
    drawTinyCodes(output, 24, 36, 1,[76, 79, 67, 65, 76, 32, 65, 67, 72, 73, 69, 86, 69, 77, 69, 78, 84, 83], 18, 255, 220, 120);
    drawTinyCodes(output, 24, 50, 1,[85, 78, 76, 79, 67, 75, 69, 68], 8, 120, 255, 160);
    var summaryX << drawTinyNumber(output, 78, 50, 1, summary["unlocked"], 120, 255, 160);
    drawTinyChar(output, summaryX, 50, 1, 47, 120, 255, 160);
    drawTinyNumber(output, summaryX + 6, 50, 1, summary["total"], 120, 255, 160);
    var percentX << drawTinyNumber(output, 126, 50, 1, summary["percent"], 255, 220, 120);
    drawTinyCodes(output, percentX + 6, 50, 1,[80, 67, 84], 3, 255, 220, 120);
    if (sizeOf(rows) == 0) {
        drawTinyCodes(output, 24, 86, 1,[78, 79, 32, 71, 65, 77, 69, 45, 83, 80, 69, 67, 73, 70, 73, 67, 32, 80, 65, 67, 75], 21, 236, 238, 236);
        drawTinyCodes(output, 24, 102, 1,[84, 72, 73, 83, 32, 82, 79, 77, 32, 78, 69, 69, 68, 83, 32, 65, 32, 76, 79, 67, 65, 76, 32, 80, 65, 67, 75], 27, 120, 220, 255);
    } else {
        var index << 0;
        var rowY << 66;
        while (index < sizeOf(rows) and index < 8) {
            drawAchievementRow(output, rowY, rows[index]);
            rowY << rowY + 15;
            index << index + 1;
        }
    }
    drawTinyCodes(output, 24, 194, 1,[70, 57, 32, 79, 82, 32, 69, 32, 69, 88, 80, 79, 82, 84], 14, 120, 220, 255);
    drawTinyCodes(output, 168, 194, 1,[69, 83, 67, 32, 66, 65, 67, 75], 8, 236, 238, 236);
    return true;
}
fct drawAchievementToast(output, achievementId) {
    introRect(output, 18, 12, 220, 48, 8, 12, 28);
    introRect(output, 20, 14, 216, 44, 64, 48, 20);
    drawTinyCodes(output, 28, 22, 1,[65, 67, 72, 73, 69, 86, 69, 77, 69, 78, 84, 32, 85, 78, 76, 79, 67, 75, 69, 68], 20, 255, 220, 120);
    drawAchievementTitle(output, 28, 40, achievementId, 236, 238, 236);
    return true;
}
fct drawBackupToast(output, success) {
    introRect(output, 24, 66, 208, 28, 8, 12, 28);
    if (success) {
        introRect(output, 26, 68, 204, 24, 18, 62, 54);
        drawTinyCodes(output, 34, 76, 1,[74, 83, 79, 78, 32, 66, 65, 67, 75, 85, 80, 32, 69, 88, 80, 79, 82, 84, 69, 68], 20, 150, 255, 190);
    } else {
        introRect(output, 26, 68, 204, 24, 76, 28, 28);
        drawTinyCodes(output, 34, 76, 1,[69, 88, 80, 79, 82, 84, 32, 70, 65, 73, 76, 69, 68], 13, 255, 180, 160);
    }
    return true;
}
fct drawTechnicalOverlay(output, mapperId, frames, queuedAudioBytes, lastAudioSamples, audioEnabled, gamepadMask) {
    introRect(output, 6, 6, 154, 86, 8, 12, 28);
    introRect(output, 8, 8, 150, 82, 24, 28, 58);
    drawTinyCodes(output, 14, 16, 1,[84, 69, 67, 72, 32, 79, 86, 69, 82, 76, 65, 89], 12, 255, 220, 120);
    drawTinyCodes(output, 14, 30, 1,[77, 65, 80, 80, 69, 82], 6, 236, 238, 236);
    drawTinyNumber(output, 76, 30, 1, mapperId, 120, 220, 255);
    drawTinyCodes(output, 14, 44, 1,[65, 85, 68, 73, 79], 5, 236, 238, 236);
    if (audioEnabled) {
        drawTinyCodes(output, 76, 44, 1,[79, 78], 2, 120, 255, 160);
    } else {
        drawTinyCodes(output, 76, 44, 1,[79, 70, 70], 3, 255, 150, 120);
    }
    drawTinyCodes(output, 14, 58, 1,[81, 85, 69, 85, 69], 5, 236, 238, 236);
    drawTinyNumber(output, 76, 58, 1, queuedAudioBytes, 120, 220, 255);
    drawTinyCodes(output, 14, 72, 1,[83, 65, 77, 80, 76, 69, 83], 7, 236, 238, 236);
    drawTinyNumber(output, 76, 72, 1, lastAudioSamples, 120, 220, 255);
    if (gamepadMask != 0) {
        drawTinyCodes(output, 124, 44, 1,[71, 80], 2, 120, 255, 160);
    }
    return true;
}
fct drawLibraryRow(output, y, row, selected) {
    if (selected) {
        introRect(output, 18, y - 3, 220, 25, 42, 56, 116);
        drawTinyChar(output, 22, y + 1, 1, 62, 255, 220, 120);
    }
    var titleRed << 236;
    var titleGreen << 238;
    var titleBlue << 236;
    if (selected) {
        titleRed << 255;
        titleGreen << 245;
        titleBlue << 180;
    }
    drawTinyText(output, 32, y, 1, gameLibrary.displayTitle(row), 28, titleRed, titleGreen, titleBlue);
    var total << toInt(row["achievement_total"]);
    var unlocked << toInt(row["achievement_unlocked"]);
    var percent << toInt(row["achievement_percent"]);
    var subtitle << "";
    if (total > 0) {
        subtitle << "ACH " + toString(unlocked) + "/" + toString(total) + " " + toString(percent) + "%";
    } else {
        subtitle << "NO PACK";
    }
    subtitle << subtitle + "  PLAY " + gameLibrary.playTimeLabel(row["play_seconds"]);
    drawTinyText(output, 32, y + 11, 1, subtitle, 31, 120, 220, 255);
    if (!fileExists(row["path"])) {
        drawTinyText(output, 190, y + 11, 1, "MISSING", 7, 255, 150, 120);
    }
    return true;
}
fct drawGameLibrary(output, rows, totalCount, cursor, offset, filterIndex, sortIndex, search, searchActive) {
    introRect(output, 0, 0, 256, 240, 8, 10, 22);
    introRect(output, 8, 8, 240, 224, 6, 8, 18);
    introRect(output, 10, 10, 236, 220, 20, 24, 48);
    introRect(output, 14, 14, 228, 22, 42, 56, 116);
    drawTinyText(output, 22, 22, 1, "GAME LIBRARY", 20, 255, 220, 120);
    drawTinyText(output, 150, 22, 1, toString(totalCount) + " GAMES", 13, 120, 255, 160);
    drawTinyText(output, 20, 44, 1, "FILTER " + gameLibrary.filterLabel(filterIndex), 22, 236, 238, 236);
    drawTinyText(output, 132, 44, 1, "SORT " + gameLibrary.sortLabel(sortIndex), 18, 236, 238, 236);
    if (searchActive) {
        introRect(output, 16, 56, 224, 16, 72, 30, 30);
        drawTinyText(output, 22, 61, 1, "SEARCH > " + search, 34, 255, 220, 120);
    } else {
        if (search != "") {
            drawTinyText(output, 22, 61, 1, "SEARCH " + search, 34, 120, 255, 160);
        } else {
            drawTinyText(output, 22, 61, 1, "F4 SEARCH", 16, 120, 220, 255);
        }
    }
    if (sizeOf(rows) == 0) {
        drawTinyText(output, 40, 104, 1, "NO GAMES MATCH THIS VIEW", 30, 236, 238, 236);
        drawTinyText(output, 40, 124, 1, "LOAD A ROM OR CHANGE FILTER", 30, 120, 220, 255);
    } else {
        var index << 0;
        var rowY << 82;
        while (index < sizeOf(rows) and index < 5) {
            drawLibraryRow(output, rowY, rows[index], cursor - offset == index);
            rowY << rowY + 27;
            index << index + 1;
        }
    }
    drawTinyText(output, 18, 218, 1, "A OPEN  B BACK  F2 FILTER  F3 SORT", 37, 236, 238, 236);
    return true;
}
fct drawDetailMenuRow(output, y, selected, text) {
    if (selected) {
        introRect(output, 24, y - 3, 208, 14, 42, 56, 116);
        drawTinyChar(output, 30, y, 1, 62, 255, 220, 120);
        drawTinyText(output, 44, y, 1, text, 25, 255, 245, 180);
    } else {
        drawTinyText(output, 44, y, 1, text, 25, 236, 238, 236);
    }
    return true;
}
fct drawGameDetails(output, row, selected) {
    introRect(output, 0, 0, 256, 240, 8, 10, 22);
    introRect(output, 8, 8, 240, 224, 6, 8, 18);
    introRect(output, 10, 10, 236, 220, 20, 24, 48);
    introRect(output, 14, 14, 228, 22, 42, 56, 116);
    drawTinyText(output, 22, 22, 1, gameLibrary.displayTitle(row), 34, 255, 220, 120);
    var total << toInt(row["achievement_total"]);
    var unlocked << toInt(row["achievement_unlocked"]);
    drawTinyText(output, 22, 48, 1, "ACHIEVEMENTS", 14, 236, 238, 236);
    if (total > 0) {
        drawTinyText(output, 118, 48, 1, toString(unlocked) + "/" + toString(total) + "  " + toString(row["achievement_percent"]) + "%", 18, 120, 255, 160);
    } else {
        drawTinyText(output, 118, 48, 1, "NO PACK", 12, 255, 150, 120);
    }
    drawTinyText(output, 22, 64, 1, "PLAY TIME", 12, 236, 238, 236);
    drawTinyText(output, 118, 64, 1, gameLibrary.playTimeLabel(row["play_seconds"]), 18, 120, 220, 255);
    drawTinyText(output, 22, 80, 1, "SESSIONS", 12, 236, 238, 236);
    drawTinyText(output, 118, 80, 1, toString(row["sessions"]), 18, 120, 220, 255);
    drawTinyText(output, 22, 96, 1, "LAST PLAYED", 14, 236, 238, 236);
    drawTinyText(output, 118, 96, 1, gameLibrary.lastPlayedLabel(row["last_opened"], unixTimeSeconds()), 18, 120, 220, 255);
    drawTinyText(output, 22, 112, 1, "MAPPER", 10, 236, 238, 236);
    drawTinyText(output, 118, 112, 1, toString(row["mapper"]), 18, 120, 220, 255);
    drawTinyText(output, 22, 128, 1, "ROM", 10, 236, 238, 236);
    if (fileExists(row["path"])) {
        drawTinyText(output, 118, 128, 1, "READY", 18, 120, 255, 160);
    } else {
        drawTinyText(output, 118, 128, 1, "FILE MISSING", 18, 255, 150, 120);
    }
    drawTinyText(output, 22, 144, 1, "ID", 10, 236, 238, 236);
    drawTinyText(output, 118, 144, 1, gameLibrary.prefix(row["digest"], 16), 18, 120, 220, 255);
    drawDetailMenuRow(output, 172, selected == 0, "PLAY");
    drawDetailMenuRow(output, 190, selected == 1, "ACHIEVEMENTS");
    drawDetailMenuRow(output, 208, selected == 2, "BACK");
    drawTinyText(output, 22, 224, 1, "A SELECT  B/ESC BACK", 30, 236, 238, 236);
    return true;
}
fct drawLibraryAchievementRow(output, y, row, selected) {
    if (selected) {
        introRect(output, 18, y - 3, 220, 24, 42, 56, 116);
        drawTinyChar(output, 22, y, 1, 62, 255, 220, 120);
    }
    var unlocked << toInt(row["unlocked"]) == 1;
    if (unlocked) {
        drawTinyText(output, 32, y, 1, row["title"], 25, 150, 255, 190);
        drawTinyText(output, 188, y, 1, "DONE", 6, 150, 255, 190);
    } else {
        drawTinyText(output, 32, y, 1, row["title"], 25, 236, 238, 236);
        var target << toInt(row["target"]);
        var progress << toInt(row["progress"]);
        drawTinyText(output, 188, y, 1, toString(progress) + "/" + toString(target), 8, 120, 220, 255);
    }
    drawTinyText(output, 32, y + 11, 1, row["description"], 31, 120, 220, 255);
    return true;
}
fct drawLibraryAchievements(output, gameRow, rows, selected, offset, filterIndex) {
    introRect(output, 0, 0, 256, 240, 8, 10, 22);
    introRect(output, 8, 8, 240, 224, 6, 8, 18);
    introRect(output, 10, 10, 236, 220, 20, 24, 48);
    introRect(output, 14, 14, 228, 22, 42, 56, 116);
    drawTinyText(output, 22, 22, 1, gameLibrary.displayTitle(gameRow), 34, 255, 220, 120);
    drawTinyText(output, 20, 44, 1, "ACHIEVEMENTS " + toString(gameRow["achievement_unlocked"]) + "/" + toString(gameRow["achievement_total"]) + " " + toString(gameRow["achievement_percent"]) + "%", 34, 236, 238, 236);
    drawTinyText(output, 20, 58, 1, "VIEW " + gameLibrary.achievementFilterLabel(filterIndex), 26, 120, 220, 255);
    if (sizeOf(rows) == 0) {
        drawTinyText(output, 42, 108, 1, "NO ACHIEVEMENTS IN THIS VIEW", 31, 236, 238, 236);
    } else {
        var localStart << offset;
        var index << localStart;
        var rowY << 78;
        while (index < sizeOf(rows) and index < localStart + 5) {
            drawLibraryAchievementRow(output, rowY, rows[index], selected == index);
            rowY << rowY + 27;
            index << index + 1;
        }
    }
    drawTinyText(output, 18, 218, 1, "UP/DOWN  LR VIEW  F9 EXPORT  B/ESC BACK", 40, 236, 238, 236);
    return true;
}
fct saveRecentPath(path) {
    if (path == "") {
        return false;
    }
    var db << store.open(desktopSettingsPath());
    store.saveSetting(db, "lastRom", path);
    store.close(db);
    return true;
}
fct saveStatePath() {
    return "zumbra-nes-quickstate.state";
}
fct stableShell(context, headlessMode) {
    var pixels << bytes(256 * 240 * 4);
    var controls << loadControlSettings();
    var audioEnabled << loadAudioSetting();
    var selectedPath << "";
    var running << true;
    var frames << 0u64;
    var lastPresent << native.ticks(context);
    var selected << 0;
    var previousMask << 0;
    var aboutVisible << false;
    var controlsVisible << false;
    var captureAction << "";
    var captureReady << false;
    var lastSettingsAction << "";
    var lastF2 << false;
    var lastEsc << false;
    var lastLibraryF2 << false;
    var lastLibraryF3 << false;
    var lastLibraryF4 << false;
    var lastLibraryF9 << false;
    var lastSearchCode <<-1;
    // 0 main, 1 library, 2 game details, 3 achievement browser.
    var shellView << 0;
    var libraryDb << store.open(desktopSettingsPath());
    var libraryFilter << 0;
    var librarySort << 0;
    var librarySearch << "";
    var librarySearchActive << false;
    var libraryCursor << 0;
    var libraryState << gameLibrary.pageState(libraryDb, libraryFilter, librarySort, librarySearch, libraryCursor, 5);
    var libraryRows << libraryState["rows"];
    var libraryTotal << toInt(libraryState["total"]);
    var libraryOffset << toInt(libraryState["offset"]);
    libraryCursor << toInt(libraryState["cursor"]);
    var mainLibraryCount << gameLibrary.count(libraryDb, 0, "");
    var detailRow << {
        "digest": "", "path": "", "display_title": "UNKNOWN ROM", "library_title": "", "mapper": 0, "last_opened": 0, "play_seconds": 0, "sessions": 0, "pack_source": "none", "pack_version": 0, "achievement_total": 0, "achievement_unlocked": 0, "achievement_percent": 0
    };
    var detailSelected << 0;
    var achievementFilter << 0;
    var achievementCursor << 0;
    var achievementOffset << 0;
    var libraryAchievementRows <<[];
    native.setStatus(context, "Zumbra NES 0.5.63 | Load ROM | Game Library | Controls | Audio | Achievements");
    while (running and!native.shouldClose(context)) {
        native.pollAll(context, 32);
        var controllerMask << externalControllerMask(context);
        var mask << stablePlayerOneMask(context, controls) bor controllerMask;
        var edges << edgeBits(mask, previousMask, 0xFF);
        previousMask << mask;
        var confirmPressed <<(edges band 0x09) != 0;
        var backPressed <<(edges band 0x02) != 0;
        var escNow << native.keyDown(context, 41);
        if (escNow and!lastEsc) {
            if (aboutVisible) {
                aboutVisible << false;
                native.setStatus(context, "Zumbra NES 0.5.63 | Main menu");
            } else {
                if (controlsVisible) {
                    if (captureAction != "") {
                        captureAction << "";
                        captureReady << false;
                        showControlSettings(context, controls);
                    } else {
                        controlsVisible << false;
                        native.setStatus(context, "Zumbra NES 0.5.63 | Main menu");
                    }
                } else {
                    if (librarySearchActive) {
                        librarySearchActive << false;
                        lastSearchCode <<-1;
                        native.setStatus(context, "GAME LIBRARY | search kept | F4 edit | Esc back");
                    } else {
                        if (shellView == 3) {
                            shellView << 2;
                            native.setStatus(context, "GAME DETAILS | A select | B/Esc back");
                        } else {
                            if (shellView == 2) {
                                shellView << 1;
                                native.setStatus(context, "GAME LIBRARY | F2 filter | F3 sort | F4 search");
                            } else {
                                if (shellView == 1) {
                                    shellView << 0;
                                    native.setStatus(context, "Zumbra NES 0.5.63 | Main menu");
                                }
                            }
                        }
                    }
                }
            }
        }
        lastEsc << escNow;
        if (native.keyDown(context, 69)) {
            running << false;
        }
        if (controlsVisible) {
            var selectedSettingAction << "";
            if (captureAction == "") {
                selectedSettingAction << settingsAction(context);
                if (selectedSettingAction != "" and selectedSettingAction != lastSettingsAction) {
                    captureAction << selectedSettingAction;
                    captureReady << false;
                    native.setStatus(context, "CONTROLS | press a new key for " + actionLabel(captureAction) + " | Esc cancels");
                }
            } else {
                var captureCode << native.firstKeyDown(context);
                if (!captureReady) {
                    if (captureCode < 0) {
                        captureReady << true;
                    }
                } else {
                    if (captureCode >= 0 and captureCode != 41) {
                        if (saveRemapCode(context, controls, captureAction, captureCode)) {
                            captureAction << "";
                            captureReady << false;
                            showControlSettings(context, controls);
                        }
                    }
                }
            }
            lastSettingsAction << selectedSettingAction;
            var f2Now << native.keyDown(context, 59);
            if (captureAction == "" and f2Now and!lastF2) {
                controls << controlDefaults();
                saveControlSettings(controls);
                showControlSettings(context, controls);
            }
            lastF2 << f2Now;
        } else {
            lastSettingsAction << "";
            lastF2 << native.keyDown(context, 59);
        }
        if (!aboutVisible and!controlsVisible) {
            if (shellView == 0) {
                if ((edges band 0x10) != 0) {
                    selected << selected - 1;
                    if (selected < 0) {
                        selected << 7;
                    }
                }
                if ((edges band 0x20) != 0) {
                    selected << selected + 1;
                    if (selected > 7) {
                        selected << 0;
                    }
                }
                if (confirmPressed) {
                    if (selected == 0 and!headlessMode) {
                        selectedPath << native.pickRom(context);
                        if (selectedPath != "") {
                            saveRecentPath(selectedPath);
                            running << false;
                        }
                    }
                    if (selected == 1) {
                        shellView << 1;
                        libraryFilter << 0;
                        librarySearch << "";
                        librarySearchActive << false;
                        libraryCursor << 0;
                        libraryState << gameLibrary.pageState(libraryDb, libraryFilter, librarySort, librarySearch, libraryCursor, 5);
                        libraryRows << libraryState["rows"];
                        libraryTotal << toInt(libraryState["total"]);
                        libraryOffset << toInt(libraryState["offset"]);
                        libraryCursor << toInt(libraryState["cursor"]);
                        native.setStatus(context, "GAME LIBRARY | F2 filter | F3 sort | F4 search | gamepad D-pad/A/B");
                    }
                    if (selected == 2 and fileExists("fixtures/homebrew/zebra-platformer.nes")) {
                        selectedPath << "fixtures/homebrew/zebra-platformer.nes";
                        running << false;
                    }
                    if (selected == 3) {
                        controlsVisible << true;
                        captureAction << "";
                        captureReady << false;
                        lastSettingsAction << "";
                        native.setStatus(context, "CONTROLS | 1-8 remap | F2 reset | Esc back | external gamepads auto");
                    }
                    if (selected == 4) {
                        audioEnabled <<!audioEnabled;
                        saveAudioSetting(audioEnabled);
                        if (audioEnabled) {
                            native.setStatus(context, "AUDIO ON");
                        } else {
                            native.setStatus(context, "AUDIO OFF");
                        }
                    }
                    if (selected == 5) {
                        shellView << 1;
                        libraryFilter << 1;
                        librarySearch << "";
                        librarySearchActive << false;
                        libraryCursor << 0;
                        libraryState << gameLibrary.pageState(libraryDb, libraryFilter, librarySort, librarySearch, libraryCursor, 5);
                        libraryRows << libraryState["rows"];
                        libraryTotal << toInt(libraryState["total"]);
                        libraryOffset << toInt(libraryState["offset"]);
                        libraryCursor << toInt(libraryState["cursor"]);
                        native.setStatus(context, "ACHIEVEMENT LIBRARY | known games | A open | B/Esc back");
                    }
                    if (selected == 6) {
                        aboutVisible << true;
                    }
                    if (selected == 7) {
                        running << false;
                    }
                }
            } else {
                if (shellView == 1) {
                    if (backPressed and!librarySearchActive) {
                        shellView << 0;
                        native.setStatus(context, "Zumbra NES 0.5.63 | Main menu");
                    }
                    if (librarySearchActive) {
                        var searchCode << native.firstKeyDown(context);
                        if (searchCode < 0) {
                            lastSearchCode <<-1;
                        } else {
                            if (searchCode != lastSearchCode) {
                                if (searchCode == 40) {
                                    librarySearchActive << false;
                                } else {
                                    if (searchCode == 42) {
                                        librarySearch << removeLastCharacter(librarySearch);
                                    } else {
                                        var nextCharacter << searchCharacter(searchCode);
                                        if (nextCharacter != "" and sizeOf(librarySearch) < 24) {
                                            librarySearch << librarySearch + nextCharacter;
                                        }
                                    }
                                }
                                libraryCursor << 0;
                                libraryState << gameLibrary.pageState(libraryDb, libraryFilter, librarySort, librarySearch, libraryCursor, 5);
                                libraryRows << libraryState["rows"];
                                libraryTotal << toInt(libraryState["total"]);
                                libraryOffset << toInt(libraryState["offset"]);
                                libraryCursor << toInt(libraryState["cursor"]);
                            }
                            lastSearchCode << searchCode;
                        }
                    } else {
                        if ((edges band 0x10) != 0 and libraryTotal > 0) {
                            libraryCursor << libraryCursor - 1;
                            if (libraryCursor < 0) {
                                libraryCursor << 0;
                            }
                            libraryState << gameLibrary.pageState(libraryDb, libraryFilter, librarySort, librarySearch, libraryCursor, 5);
                            libraryRows << libraryState["rows"];
                            libraryOffset << toInt(libraryState["offset"]);
                            libraryCursor << toInt(libraryState["cursor"]);
                        }
                        if ((edges band 0x20) != 0 and libraryTotal > 0) {
                            libraryCursor << libraryCursor + 1;
                            if (libraryCursor >= libraryTotal) {
                                libraryCursor << libraryTotal - 1;
                            }
                            libraryState << gameLibrary.pageState(libraryDb, libraryFilter, librarySort, librarySearch, libraryCursor, 5);
                            libraryRows << libraryState["rows"];
                            libraryOffset << toInt(libraryState["offset"]);
                            libraryCursor << toInt(libraryState["cursor"]);
                        }
                        var libraryF2Now << native.keyDown(context, 59);
                        var libraryF3Now << native.keyDown(context, 60);
                        var libraryF4Now << native.keyDown(context, 61);
                        var filterChanged << false;
                        if ((edges band 0x80) != 0) {
                            libraryFilter << gameLibrary.nextFilter(libraryFilter);
                            filterChanged << true;
                        }
                        if ((edges band 0x40) != 0) {
                            libraryFilter << gameLibrary.previousFilter(libraryFilter);
                            filterChanged << true;
                        }
                        if (libraryF2Now and!lastLibraryF2) {
                            libraryFilter << gameLibrary.nextFilter(libraryFilter);
                            filterChanged << true;
                        }
                        if (filterChanged) {
                            libraryCursor << 0;
                            libraryState << gameLibrary.pageState(libraryDb, libraryFilter, librarySort, librarySearch, libraryCursor, 5);
                            libraryRows << libraryState["rows"];
                            libraryTotal << toInt(libraryState["total"]);
                            libraryOffset << toInt(libraryState["offset"]);
                            libraryCursor << toInt(libraryState["cursor"]);
                        }
                        if (((edges band 0x04) != 0) or(libraryF3Now and!lastLibraryF3)) {
                            librarySort << gameLibrary.nextSort(librarySort);
                            libraryCursor << 0;
                            libraryState << gameLibrary.pageState(libraryDb, libraryFilter, librarySort, librarySearch, libraryCursor, 5);
                            libraryRows << libraryState["rows"];
                            libraryTotal << toInt(libraryState["total"]);
                            libraryOffset << toInt(libraryState["offset"]);
                            libraryCursor << toInt(libraryState["cursor"]);
                        }
                        if (libraryF4Now and!lastLibraryF4) {
                            librarySearchActive << true;
                            lastSearchCode <<-1;
                            native.setStatus(context, "GAME LIBRARY SEARCH | type | Backspace erase | Enter done | Esc leave search");
                        }
                        lastLibraryF2 << libraryF2Now;
                        lastLibraryF3 << libraryF3Now;
                        lastLibraryF4 << libraryF4Now;
                        if (confirmPressed and libraryTotal > 0 and sizeOf(libraryRows) > 0) {
                            var localIndex << libraryCursor - libraryOffset;
                            if (localIndex >= 0 and localIndex < sizeOf(libraryRows)) {
                                detailRow << gameLibrary.detail(libraryDb, libraryRows[localIndex]["digest"]);
                                detailSelected << 0;
                                shellView << 2;
                                native.setStatus(context, "GAME DETAILS | A select | B/Esc back");
                            }
                        }
                    }
                } else {
                    if (shellView == 2) {
                        if (backPressed) {
                            shellView << 1;
                            native.setStatus(context, "GAME LIBRARY | F2 filter | F3 sort | F4 search");
                        }
                        if ((edges band 0x10) != 0) {
                            detailSelected << detailSelected - 1;
                            if (detailSelected < 0) {
                                detailSelected << 2;
                            }
                        }
                        if ((edges band 0x20) != 0) {
                            detailSelected << detailSelected + 1;
                            if (detailSelected > 2) {
                                detailSelected << 0;
                            }
                        }
                        if (confirmPressed) {
                            if (detailSelected == 0) {
                                if (fileExists(detailRow["path"])) {
                                    selectedPath << detailRow["path"];
                                    saveRecentPath(selectedPath);
                                    running << false;
                                } else {
                                    native.setStatus(context, "ROM FILE MISSING | reload the ROM to refresh its path");
                                }
                            }
                            if (detailSelected == 1) {
                                if (toInt(detailRow["achievement_total"]) > 0) {
                                    achievementFilter << 0;
                                    achievementCursor << 0;
                                    var achievementState << gameLibrary.achievementState(libraryDb, detailRow["digest"], achievementFilter, achievementCursor, 5);
                                    libraryAchievementRows << achievementState["rows"];
                                    achievementCursor << toInt(achievementState["cursor"]);
                                    achievementOffset << toInt(achievementState["offset"]);
                                    shellView << 3;
                                    native.setStatus(context, "ACHIEVEMENTS | D-pad navigate/filter | F9 export | B/Esc back");
                                } else {
                                    native.setStatus(context, "NO GAME-SPECIFIC ACHIEVEMENT PACK FOR THIS ROM");
                                }
                            }
                            if (detailSelected == 2) {
                                shellView << 1;
                                native.setStatus(context, "GAME LIBRARY | F2 filter | F3 sort | F4 search");
                            }
                        }
                    } else {
                        if (shellView == 3) {
                            if (backPressed) {
                                shellView << 2;
                                native.setStatus(context, "GAME DETAILS | A select | B/Esc back");
                            }
                            if ((edges band 0x10) != 0 and sizeOf(libraryAchievementRows) > 0) {
                                achievementCursor << achievementCursor - 1;
                                if (achievementCursor < 0) {
                                    achievementCursor << 0;
                                }
                            }
                            if ((edges band 0x20) != 0 and sizeOf(libraryAchievementRows) > 0) {
                                achievementCursor << achievementCursor + 1;
                                if (achievementCursor >= sizeOf(libraryAchievementRows)) {
                                    achievementCursor << sizeOf(libraryAchievementRows) - 1;
                                }
                            }
                            var achievementFilterChanged << false;
                            if ((edges band 0x80) != 0) {
                                achievementFilter << gameLibrary.nextAchievementFilter(achievementFilter);
                                achievementFilterChanged << true;
                            }
                            if ((edges band 0x40) != 0) {
                                achievementFilter << gameLibrary.previousAchievementFilter(achievementFilter);
                                achievementFilterChanged << true;
                            }
                            if (achievementFilterChanged) {
                                achievementCursor << 0;
                                var filteredAchievementState << gameLibrary.achievementState(libraryDb, detailRow["digest"], achievementFilter, achievementCursor, 5);
                                libraryAchievementRows << filteredAchievementState["rows"];
                                achievementCursor << toInt(filteredAchievementState["cursor"]);
                                achievementOffset << toInt(filteredAchievementState["offset"]);
                            } else {
                                if (sizeOf(libraryAchievementRows) > 0) {
                                    achievementOffset <<(achievementCursor / 5) * 5;
                                } else {
                                    achievementOffset << 0;
                                }
                            }
                            var libraryF9Now << native.keyDown(context, 66);
                            if (libraryF9Now and!lastLibraryF9) {
                                var exportOk << offlineAchievements.exportBackup(libraryDb, offlineAchievements.backupPath());
                                if (exportOk) {
                                    native.setStatus(context, "LOCAL ACHIEVEMENT BACKUP EXPORTED | " + offlineAchievements.backupPath());
                                } else {
                                    native.setStatus(context, "ACHIEVEMENT BACKUP EXPORT FAILED");
                                }
                            }
                            lastLibraryF9 << libraryF9Now;
                        }
                    }
                }
            }
        }
        if (shellView == 0) {
            drawMainMenu(pixels, selected, audioEnabled, mainLibraryCount);
            if (aboutVisible) {
                drawAboutOverlay(pixels);
            }
            if (controlsVisible) {
                drawSettingsOverlay(pixels, controls, captureAction);
            }
        } else {
            if (shellView == 1) {
                drawGameLibrary(pixels, libraryRows, libraryTotal, libraryCursor, libraryOffset, libraryFilter, librarySort, librarySearch, librarySearchActive);
            }
            if (shellView == 2) {
                drawGameDetails(pixels, detailRow, detailSelected);
            }
            if (shellView == 3) {
                drawLibraryAchievements(pixels, detailRow, libraryAchievementRows, achievementCursor, achievementOffset, achievementFilter);
            }
        }
        var nowTicks << native.ticks(context);
        if (nowTicks - lastPresent >= 33u64) {
            native.present(context, pixels);
            lastPresent << nowTicks;
        }
        native.delay(context, 16);
        if (headlessMode) {
            frames << frames + 1u64;
            if (frames >= 2u64) {
                running << false;
            }
        }
    }
    store.close(libraryDb);
    return {
        "frames": frames, "path": selectedPath, "audio": audioEnabled
    };
}
fct openGameRuntime(path) {
    if (path == "" or!fileExists(path)) {
        return {
            "ok": false, "message": "ROM file not found", "path": path
        };
    }
    var romBytes << readBytes(path);
    var inspection << cartridge.inspectImage(romBytes);
    if (!inspection.ok) {
        return {
            "ok": false, "message": inspection.message, "path": path
        };
    }
    var cart << cartridge.fromBytes(romBytes, path);
    var info << cart["info"];
    var mapperId << info.header.mapper;
    var compatibility << mapper.compatibility(mapperId);
    if (!compatibility["ok"]) {
        return {
            "ok": false, "message": compatibility["message"], "path": path
        };
    }
    var machine << console.create(cart);
    return {
        "ok": true, "message": "ok", "path": path, "machine": machine, "mapper": mapperId, "info": info, "digest": info.digest, "rgba": palette.rgbaBuffer(machine["bus"]["ppu"]["framebuffer"])
    };
} /// Runtime-editable player 1 bindings persisted through typed settings.
fct inputLockedMask(rawMask, lockFrames) {
    if (lockFrames > 0) {
        return 0;
    }
    return rawMask;
} /// Runs the interactive SDL3 frontend, or a deterministic two-frame headless smoke.
// Desktop build compatibility helpers.
fct runGameSession(context, path, audioEnabled, headlessMode) {
    var game << openGameRuntime(path);
    if (!game["ok"]) {
        return {
            "ok": false, "message": game["message"], "frames": 0u64, "audio": audioEnabled, "returnToMenu": true
        };
    }
    if (headlessMode) {
        return {
            "ok": true, "message": "ok", "frames": 2u64, "audio": audioEnabled, "returnToMenu": false
        };
    }
    saveRecentPath(path);
    var gameDb << store.open(desktopSettingsPath());
    var gameInfo << game["info"];
    var gameDigest << game["digest"];
    var sessionStartedTicks << native.ticks(context);
    var sessionStartedAt << unixTimeSeconds();
    offlineAchievements.install(gameDb, gameInfo, sessionStartedAt);
    var sessionId << store.beginSession(gameDb, gameDigest, sessionStartedAt);
    console.setPerformanceMode(game["machine"], true);
    // Audio is enabled after performance mode so the desktop queue receives
    // real APU samples. This is slower than silent fast mode, but avoids the
    // confusing "no sound" release behavior.
    console.setAudioOutput(game["machine"], audioEnabled);
    var audioCursor << audioOutput.createCursor();
    var running << true;
    var returnToMenu << false;
    var paused << false;
    var frames << 0u64;
    var pendingFrame << true;
    var lastPresent << native.ticks(context);
    var lastP << false;
    var lastEsc << false;
    var mapperId << game["mapper"];
    var controls << loadControlSettings();
    var lastF1 << false;
    var lastF2 << false;
    var lastSettingsAction << "";
    var settingsVisible << false;
    var captureAction << "";
    var captureReady << false;
    var inputLock << 12;
    var overlayVisible << false;
    var lastF3 << false;
    var lastF5 << false;
    var lastF8 << false;
    var lastF6 << false;
    var lastF9 << false;
    var lastExportE << false;
    var achievementsVisible << false;
    var achievementNoticeFrames << 0;
    var backupNoticeFrames << 0;
    var backupNoticeOk << false;
    var achievementNoticeId << "";
    var lastAchievementInputMask << 0;
    native.setStatus(context, "Zumbra NES 0.5.63 | mapper " + toString(mapperId) + " | Esc menu | F1 controls | F3 overlay | F5 save | F6 achievements | F8 load | F12 quit");
    // Achievement rows/summary are heap-backed SQLite values. Keep a base mark
    // before the cache so refreshes can free the previous snapshot without
    // leaving dangling dictionaries across runtimeMemoryReset().
    var achievementCacheBaseMark << runtimeMemoryMark();
    var achievementRowsView << offlineAchievements.rows(gameDb, gameDigest);
    var achievementSummaryView << offlineAchievements.summary(gameDb, gameDigest);
    var achievementUnlockedCount << toInt(achievementSummaryView["unlocked"]);
    var achievementTotalCount << toInt(achievementSummaryView["total"]);
    var lastAudioSamples << 0;
    var loopMemoryMark << runtimeMemoryMark();
    runtimeMemoryResetPeak();
    while (running and!native.shouldClose(context)) {
        var frameStart << native.ticks(context);
        native.pollAll(context, 16);
        var escNow << native.keyDown(context, 41);
        if (escNow and!lastEsc) {
            if (settingsVisible) {
                if (captureAction != "") {
                    captureAction << "";
                    captureReady << false;
                    showControlSettings(context, controls);
                } else {
                    settingsVisible << false;
                    paused << false;
                    inputLock << 10;
                    native.setStatus(context, "Zumbra NES 0.5.63 | mapper " + toString(mapperId) + " | Esc menu | F1 controls | F3 overlay | F5 save | F6 achievements | F8 load | F12 quit");
                }
            } else {
                if (achievementsVisible) {
                    achievementsVisible << false;
                    native.setStatus(context, "Zumbra NES 0.5.63 | mapper " + toString(mapperId) + " | Esc menu | F6 achievements");
                } else {
                    returnToMenu << true;
                    running << false;
                }
            }
        }
        lastEsc << escNow;
        if (native.keyDown(context, 69)) {
            running << false;
        }
        var pNow << native.keyDown(context, 19);
        if (pNow and!lastP and!settingsVisible) {
            paused <<!paused;
        }
        lastP << pNow;
        var f1Now << native.keyDown(context, 58);
        if (f1Now and!lastF1 and captureAction == "") {
            settingsVisible <<!settingsVisible;
            paused << settingsVisible;
            captureAction << "";
            captureReady << false;
            inputLock << 8;
            showControlSettings(context, controls);
        }
        lastF1 << f1Now;
        var f2Now << native.keyDown(context, 59);
        if (settingsVisible and captureAction == "" and f2Now and!lastF2) {
            paused << true;
            controls << controlDefaults();
            saveControlSettings(controls);
            inputLock << 8;
            showControlSettings(context, controls);
        }
        lastF2 << f2Now;
        var f3Now << native.keyDown(context, 60);
        if (f3Now and!lastF3) {
            overlayVisible <<!overlayVisible;
        }
        lastF3 << f3Now;
        var f5Now << native.keyDown(context, 62);
        if (f5Now and!lastF5 and!settingsVisible) {
            saveState.save(saveStatePath(), game["machine"]);
            store.recordSaveState(gameDb, gameDigest, 0, saveStatePath(), unixTimeSeconds(), frames);
            native.setStatus(context, "SAVE STATE saved to " + saveStatePath());
        }
        lastF5 << f5Now;
        var f8Now << native.keyDown(context, 65);
        if (f8Now and!lastF8 and!settingsVisible) {
            var loadResult << saveState.load(saveStatePath(), game["machine"]);
            if (loadResult.ok) {
                native.setStatus(context, "SAVE STATE loaded");
                pendingFrame << true;
            } else {
                native.setStatus(context, "SAVE STATE failed: " + loadResult.message);
            }
        }
        lastF8 << f8Now;
        var f6Now << native.keyDown(context, 63);
        if (f6Now and!lastF6 and!settingsVisible) {
            achievementsVisible <<!achievementsVisible;
            runtimeMemoryReset(achievementCacheBaseMark);
            achievementRowsView << offlineAchievements.rows(gameDb, gameDigest);
            achievementSummaryView << offlineAchievements.summary(gameDb, gameDigest);
            achievementUnlockedCount << toInt(achievementSummaryView["unlocked"]);
            achievementTotalCount << toInt(achievementSummaryView["total"]);
            native.setStatus(context, "ACHIEVEMENTS " + toString(achievementUnlockedCount) + "/" + toString(achievementTotalCount) + " local | F9 export JSON");
            loopMemoryMark << runtimeMemoryMark();
        }
        lastF6 << f6Now;
        var f9Now << native.keyDown(context, 66);
        var exportENow << native.keyDown(context, 8);
        var exportPressed <<(f9Now and!lastF9) or(achievementsVisible and exportENow and!lastExportE);
        if (exportPressed and!settingsVisible) {
            backupNoticeOk << offlineAchievements.exportBackup(gameDb, offlineAchievements.backupPath());
            backupNoticeFrames << 180;
            if (backupNoticeOk) {
                native.setStatus(context, "BACKUP JSON: " + offlineAchievements.backupPath());
                show("Achievement backup exported: " + offlineAchievements.backupPath());
            } else {
                native.setStatus(context, "BACKUP JSON failed: " + offlineAchievements.backupPath());
                show("Achievement backup export failed: " + offlineAchievements.backupPath());
            }
        }
        lastF9 << f9Now;
        lastExportE << exportENow;
        var selectedSettingAction << "";
        if (settingsVisible and captureAction == "") {
            selectedSettingAction << settingsAction(context);
            if (selectedSettingAction != "" and selectedSettingAction != lastSettingsAction) {
                paused << true;
                captureAction << selectedSettingAction;
                captureReady << false;
                native.setStatus(context, "CONTROLS | press a new key for " + actionLabel(captureAction) + " | Esc cancels");
            }
        } else {
            if (settingsVisible and captureAction != "") {
                var captureCode << native.firstKeyDown(context);
                if (!captureReady) {
                    if (captureCode < 0) {
                        captureReady << true;
                    }
                } else {
                    if (captureCode >= 0 and captureCode != 41) {
                        if (saveRemapCode(context, controls, captureAction, captureCode)) {
                            captureAction << "";
                            captureReady << false;
                            inputLock << 8;
                            showControlSettings(context, controls);
                        }
                    }
                }
            }
        }
        lastSettingsAction << selectedSettingAction;
        var keyboardMask << stablePlayerOneMask(context, controls);
        var externalControllerInput << externalControllerMask(context);
        var rawPlayerOneMask << keyboardMask bor externalControllerInput;
        if (settingsVisible or achievementsVisible) {
            rawPlayerOneMask << 0;
        }
        if (inputLock > 0) {
            // Fixed cooldown, not "wait until every button is released".
            // Holding Start/D-pad while a multicart changes banks should not lock
            // out controller input forever or make the title screen look frozen.
            inputLock << inputLock - 1;
            rawPlayerOneMask << 0;
        }
        var playerOneMask << inputLockedMask(rawPlayerOneMask, inputLock);
        console.setController(game["machine"], 1, playerOneMask);
        console.setController(game["machine"], 2, 0);
        if (!paused) {
            if (pendingFrame) {
                console.clearFrameComplete(game["machine"]);
                pendingFrame << false;
            }
            var frameCompleteNow << false;
            var loops << 0;
            // Run toward a real NES frame instead of advancing only a
            // few tiny slices per host frame. The PPU fast-timing path keeps
            // VBlank/NMI moving without per-dot rendering overhead.
            var sliceLimit << 262144;
            var sliceCap << 192;
            if (mapperId == 10 and!headlessMode) {
                sliceLimit << 393216;
                sliceCap << 224;
            }
            if (mapperId == 227 and!headlessMode) {
                sliceLimit << 196608;
                sliceCap << 160;
            }
            while (!frameCompleteNow and!native.shouldClose(context) and loops < sliceCap) {
                var code << console.runFrameSliceCodeFast(game["machine"], sliceLimit);
                if (code < 0) {
                    frameCompleteNow << true;
                }
                loops << loops + 1;
                if ((loops % 16) == 0) {
                    native.pollAll(context, 2);
                }
                if ((loops % 64) == 0) {
                    runtimeMemoryReset(loopMemoryMark);
                }
            }
            runtimeMemoryReset(loopMemoryMark);
            if (frameCompleteNow) {
                pendingFrame << true;
                var frames << frames + 1u64;
                var sessionSeconds <<(native.ticks(context) - sessionStartedTicks) / 1000u64;
                // Feed audio before SQLite/UI work. Achievement persistence can
                // occasionally take longer than a frame, so the device queue must
                // already have this frame's samples before progress is evaluated.
                var audioSamples << audioOutput.drainClean(game["machine"]["bus"]["apu"], audioCursor);
                lastAudioSamples << sizeOf(audioSamples);
                var queuedAudioBytes << native.audioQueued(context);
                if (audioEnabled and sizeOf(audioSamples) > 0 and queuedAudioBytes < 12288) {
                    native.queueAudio(context, audioSamples);
                }
                var inputAchievementEdge << playerOneMask != 0 and playerOneMask != lastAchievementInputMask;
                lastAchievementInputMask << playerOneMask;
                if (achievementUnlockedCount < achievementTotalCount and(frames <= 2u64 or(frames % 60u64) == 0u64 or inputAchievementEdge)) {
                    var unlockedNow << achievements.evaluate(gameDb, gameDigest, game["machine"], frames, playerOneMask, sessionSeconds, unixTimeSeconds());
                    var unlockedNowCount << sizeOf(unlockedNow);
                    if (unlockedNowCount > 0) {
                        achievementNoticeFrames << 180;
                        // Never keep a SQLite-owned/dynamic string across a runtime
                        // memory reset. Canonicalize to one static bundled-pack id.
                        achievementNoticeId << stableAchievementNoticeId(unlockedNow[0]["id"]);
                    }
                    if (achievementsVisible or unlockedNowCount > 0) {
                        // Free the previous cache and every transient allocation, then
                        // rebuild the snapshot and move the per-frame mark after it.
                        // Keep the refreshed SQLite snapshot outside the per-frame reset region.
                        runtimeMemoryReset(achievementCacheBaseMark);
                        achievementRowsView << offlineAchievements.rows(gameDb, gameDigest);
                        achievementSummaryView << offlineAchievements.summary(gameDb, gameDigest);
                        achievementUnlockedCount << toInt(achievementSummaryView["unlocked"]);
                        achievementTotalCount << toInt(achievementSummaryView["total"]);
                        if (unlockedNowCount > 0) {
                            native.setStatus(context, "ACHIEVEMENT: " + achievementNoticeLabel(achievementNoticeId) + " | " + toString(achievementUnlockedCount) + "/" + toString(achievementTotalCount));
                        }
                        loopMemoryMark << runtimeMemoryMark();
                    }
                }
                var framebuffer << game["machine"]["bus"]["ppu"]["framebuffer"];
                var rgba << palette.writeRgba(framebuffer, game["rgba"]);
                if (overlayVisible) {
                    drawTechnicalOverlay(rgba, mapperId, frames, native.audioQueued(context), lastAudioSamples, audioEnabled, externalControllerInput);
                }
                if (achievementsVisible) {
                    drawAchievementsOverlay(rgba, achievementRowsView, achievementSummaryView);
                }
                if (achievementNoticeFrames > 0) {
                    drawAchievementToast(rgba, achievementNoticeId);
                    achievementNoticeFrames << achievementNoticeFrames - 1;
                }
                if (backupNoticeFrames > 0) {
                    drawBackupToast(rgba, backupNoticeOk);
                    backupNoticeFrames << backupNoticeFrames - 1;
                }
                if (settingsVisible) {
                    drawSettingsOverlay(rgba, controls, captureAction);
                }
                native.present(context, rgba);
                lastPresent << native.ticks(context);
                runtimeMemoryReset(loopMemoryMark);
            } else {
                native.delay(context, 1);
                pendingFrame << pendingFrame;
            }
        } else {
            var pausedTicks << native.ticks(context);
            if (pausedTicks - lastPresent >= 100u64) {
                console.renderFrameSnapshot(game["machine"]);
                var pausedRgba << palette.writeRgba(game["machine"]["bus"]["ppu"]["framebuffer"], game["rgba"]);
                if (overlayVisible) {
                    drawTechnicalOverlay(pausedRgba, mapperId, frames, native.audioQueued(context), lastAudioSamples, audioEnabled, externalControllerInput);
                }
                if (achievementsVisible) {
                    drawAchievementsOverlay(pausedRgba, achievementRowsView, achievementSummaryView);
                }
                if (backupNoticeFrames > 0) {
                    drawBackupToast(pausedRgba, backupNoticeOk);
                    backupNoticeFrames << backupNoticeFrames - 1;
                }
                if (settingsVisible) {
                    drawSettingsOverlay(pausedRgba, controls, captureAction);
                }
                native.present(context, pausedRgba);
                lastPresent << pausedTicks;
                runtimeMemoryReset(loopMemoryMark);
            }
            native.delay(context, 16);
            paused << paused;
        }
        if (headlessMode and frames >= 2u64) {
            running << false;
        }
        var elapsed << native.ticks(context) - frameStart;
        if (elapsed < 1u64) {
            native.delay(context, 1);
        }
        elapsed << elapsed;
    }
    var sessionEndedTicks << native.ticks(context);
    var sessionEndedAt << unixTimeSeconds();
    var finalSeconds <<(sessionEndedTicks - sessionStartedTicks) / 1000u64;
    store.finishSession(gameDb, sessionId, gameDigest, sessionEndedAt, finalSeconds, frames);
    store.close(gameDb);
    return {
        "ok": true, "message": "ok", "frames": frames, "audio": audioEnabled, "returnToMenu": returnToMenu
    };
} /// Runs the interactive SDL3 frontend, or a deterministic two-frame headless smoke.
pub fct run() {
    var context << native.create("Zumbra NES 0.5.63", 3, true, false, false);
    var headlessMode << native.headless(context);
    if (!native.valid(context)) {
        show(native.error(context));
        return true;
    }
    native.pollAll(context, 4);
    showStartupIntro(context, headlessMode);
    var audioEnabled << loadAudioSetting();
    var activePath << native.initialRom();
    if (activePath == "--zebra") {
        activePath << "fixtures/homebrew/zebra-platformer.nes";
    }
    if (activePath == "" and headlessMode and fileExists("fixtures/synthetic/visible-frame.nes")) {
        activePath << "fixtures/synthetic/visible-frame.nes";
    }
    var appRunning << true;
    var totalFrames << 0u64;
    while (appRunning and!native.shouldClose(context)) {
        if (activePath == "") {
            var shellResult << stableShell(context, headlessMode);
            totalFrames << totalFrames + u64(shellResult["frames"]);
            activePath << shellResult["path"];
            audioEnabled << shellResult["audio"];
            if (activePath == "") {
                appRunning << false;
            }
        } else {
            var sessionResult << runGameSession(context, activePath, audioEnabled, headlessMode);
            totalFrames << totalFrames + u64(sessionResult["frames"]);
            audioEnabled << sessionResult["audio"];
            if (!sessionResult["ok"]) {
                show(sessionResult["message"]);
                activePath << "";
                if (headlessMode) {
                    appRunning << false;
                }
            } else {
                if (headlessMode) {
                    appRunning << false;
                } else {
                    if (sessionResult["returnToMenu"]) {
                        activePath << "";
                        native.setStatus(context, "Zumbra NES 0.5.63 | Main menu");
                    } else {
                        appRunning << false;
                    }
                }
            }
        }
    }
    native.destroy(context);
    show("Zumbra NES desktop session complete");
    show(totalFrames);
    return true;
}
