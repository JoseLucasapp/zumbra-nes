fct le16(bytesData, offset) {
    return toInt(bytesData[offset]) +(toInt(bytesData[offset + 1]) shl 8);
}
fct le32(bytesData, offset) {
    return toInt(bytesData[offset]) +(toInt(bytesData[offset + 1]) shl 8) +(toInt(bytesData[offset + 2]) shl 16) +(toInt(bytesData[offset + 3]) shl 24);
}
fct fillIntroFallback(output) {
    var y << 0;
    while (y < 240) {
        var x << 0;
        while (x < 256) {
            var destination <<(y * 256 + x) * 4;
            output[destination] << 17u8;
            output[destination + 1] << 19u8;
            output[destination + 2] << 24u8;
            output[destination + 3] << 255u8;
            x << x + 1;
        }
        y << y + 1;
    }
    introRect(output, 42, 82, 172, 76, 30, 36, 58);
    introRect(output, 48, 88, 160, 64, 226, 235, 255);
    introRect(output, 54, 94, 148, 52, 30, 36, 58);
    return true;
}
fct glyphCell(output, baseX, baseY, scale, column, row, red, green, blue) {
    introRect(output, baseX + column * scale, baseY + row * scale, scale - 1, scale - 1, red, green, blue);
    return true;
}
fct glyphN(output, x, y, scale, red, green, blue) {
    var row << 0;
    while (row < 7) {
        glyphCell(output, x, y, scale, 0, row, red, green, blue);
        glyphCell(output, x, y, scale, 4, row, red, green, blue);
        row << row + 1;
    }
    glyphCell(output, x, y, scale, 1, 1, red, green, blue);
    glyphCell(output, x, y, scale, 2, 2, red, green, blue);
    glyphCell(output, x, y, scale, 3, 3, red, green, blue);
    return true;
}
fct glyphO(output, x, y, scale, red, green, blue) {
    var column << 0;
    while (column < 5) {
        glyphCell(output, x, y, scale, column, 0, red, green, blue);
        glyphCell(output, x, y, scale, column, 6, red, green, blue);
        column << column + 1;
    }
    var row << 1;
    while (row < 6) {
        glyphCell(output, x, y, scale, 0, row, red, green, blue);
        glyphCell(output, x, y, scale, 4, row, red, green, blue);
        row << row + 1;
    }
    return true;
}
fct glyphR(output, x, y, scale, red, green, blue) {
    var row << 0;
    while (row < 7) {
        glyphCell(output, x, y, scale, 0, row, red, green, blue);
        row << row + 1;
    }
    var column << 1;
    while (column < 4) {
        glyphCell(output, x, y, scale, column, 0, red, green, blue);
        glyphCell(output, x, y, scale, column, 3, red, green, blue);
        column << column + 1;
    }
    glyphCell(output, x, y, scale, 4, 1, red, green, blue);
    glyphCell(output, x, y, scale, 4, 2, red, green, blue);
    glyphCell(output, x, y, scale, 2, 4, red, green, blue);
    glyphCell(output, x, y, scale, 3, 5, red, green, blue);
    glyphCell(output, x, y, scale, 4, 6, red, green, blue);
    return true;
}
fct glyphM(output, x, y, scale, red, green, blue) {
    var row << 0;
    while (row < 7) {
        glyphCell(output, x, y, scale, 0, row, red, green, blue);
        glyphCell(output, x, y, scale, 4, row, red, green, blue);
        row << row + 1;
    }
    glyphCell(output, x, y, scale, 1, 1, red, green, blue);
    glyphCell(output, x, y, scale, 2, 2, red, green, blue);
    glyphCell(output, x, y, scale, 3, 1, red, green, blue);
    return true;
}
fct glyphE(output, x, y, scale, red, green, blue) {
    var row << 0;
    while (row < 7) {
        glyphCell(output, x, y, scale, 0, row, red, green, blue);
        row << row + 1;
    }
    var column << 1;
    while (column < 5) {
        glyphCell(output, x, y, scale, column, 0, red, green, blue);
        glyphCell(output, x, y, scale, column, 3, red, green, blue);
        glyphCell(output, x, y, scale, column, 6, red, green, blue);
        column << column + 1;
    }
    return true;
}
fct glyphS(output, x, y, scale, red, green, blue) {
    var column << 0;
    while (column < 5) {
        glyphCell(output, x, y, scale, column, 0, red, green, blue);
        glyphCell(output, x, y, scale, column, 3, red, green, blue);
        glyphCell(output, x, y, scale, column, 6, red, green, blue);
        column << column + 1;
    }
    glyphCell(output, x, y, scale, 0, 1, red, green, blue);
    glyphCell(output, x, y, scale, 0, 2, red, green, blue);
    glyphCell(output, x, y, scale, 4, 4, red, green, blue);
    glyphCell(output, x, y, scale, 4, 5, red, green, blue);
    return true;
}
fct glyphC(output, x, y, scale, red, green, blue) {
    var column << 0;
    while (column < 5) {
        glyphCell(output, x, y, scale, column, 0, red, green, blue);
        glyphCell(output, x, y, scale, column, 6, red, green, blue);
        column << column + 1;
    }
    var row << 1;
    while (row < 6) {
        glyphCell(output, x, y, scale, 0, row, red, green, blue);
        row << row + 1;
    }
    return true;
}
fct paintNoRomShell(output) {
    var y << 0;
    while (y < 240) {
        var x << 0;
        while (x < 256) {
            var destination <<(y * 256 + x) * 4;
            output[destination] << 10u8;
            output[destination + 1] << 12u8;
            output[destination + 2] << 18u8;
            output[destination + 3] << 255u8;
            x << x + 1;
        }
        y << y + 1;
    }
    introRect(output, 14, 14, 228, 4, 114, 232, 179);
    introRect(output, 14, 222, 228, 4, 114, 232, 179);
    introRect(output, 14, 14, 4, 212, 114, 232, 179);
    introRect(output, 238, 14, 4, 212, 114, 232, 179);
    glyphN(output, 32, 68, 6, 114, 232, 179);
    glyphO(output, 68, 68, 6, 114, 232, 179);
    glyphR(output, 116, 68, 6, 114, 232, 179);
    glyphO(output, 152, 68, 6, 114, 232, 179);
    glyphM(output, 188, 68, 6, 114, 232, 179);
    glyphE(output, 70, 152, 3, 226, 235, 255);
    glyphS(output, 91, 152, 3, 226, 235, 255);
    glyphC(output, 112, 152, 3, 226, 235, 255);
    introRect(output, 142, 162, 44, 3, 226, 235, 255);
    return output;
}
fct paintIntroBitmap(output, path) {
    if (!fileExists(path)) {
        return false;
    }
    var romBytes << readBytes(path);
    if (sizeOf(romBytes) < 54) {
        return false;
    }
    if (toInt(romBytes[0]) != 66 or toInt(romBytes[1]) != 77) {
        return false;
    }
    var pixelOffset << le32(romBytes, 10);
    var width << le32(romBytes, 18);
    var height << le32(romBytes, 22);
    var bits << le16(romBytes, 28);
    if (width <= 0 or height <= 0 or bits != 24) {
        return false;
    }

    // The intro surface is NES-sized (256x240). The old code center-cropped
    // larger bitmaps to exactly 256x240 source pixels, which made high-resolution
    // logos look massively zoomed in on the small emulator window. Scale the
    // complete bitmap into a centered safe area instead, preserving aspect ratio.
    var targetMaxWidth << 224;
    var targetMaxHeight << 200;
    var drawWidth << targetMaxWidth;
    var drawHeight <<(height * targetMaxWidth) / width;
    if (drawHeight > targetMaxHeight) {
        drawHeight << targetMaxHeight;
        drawWidth <<(width * targetMaxHeight) / height;
    }
    if (drawWidth < 1) {
        drawWidth << 1;
    }
    if (drawHeight < 1) {
        drawHeight << 1;
    }
    var destinationX <<(256 - drawWidth) / 2;
    var destinationY <<(240 - drawHeight) / 2;
    var rowStride <<((width * 3 + 3) / 4) * 4;
    // Opaque black letterbox/padding avoids compositor transparency around
    // aspect ratios that do not exactly match the 256x240 presentation surface.
    var clearY << 0;
    while (clearY < 240) {
        var clearX << 0;
        while (clearX < 256) {
            var clearDestination <<(clearY * 256 + clearX) * 4;
            output[clearDestination] << 0u8;
            output[clearDestination + 1] << 0u8;
            output[clearDestination + 2] << 0u8;
            output[clearDestination + 3] << 255u8;
            clearX << clearX + 1;
        }
        clearY << clearY + 1;
    }

    // Nearest-neighbour scaling keeps the loader simple and deterministic while
    // fixing the actual issue: source pixels are sampled across the whole image
    // rather than taking a 256x240 crop from its center.
    var y << 0;
    while (y < drawHeight) {
        var sourceYTop <<(y * height) / drawHeight;
        var sourceY << height - 1 - sourceYTop;
        var x << 0;
        while (x < drawWidth) {
            var sourceX <<(x * width) / drawWidth;
            var source << pixelOffset + sourceY * rowStride + sourceX * 3;
            var destination <<((y + destinationY) * 256 +(x + destinationX)) * 4;
            if (source + 2 < sizeOf(romBytes)) {
                output[destination] << romBytes[source + 2];
                output[destination + 1] << romBytes[source + 1];
                output[destination + 2] << romBytes[source];
                output[destination + 3] << 255u8;
            }
            x << x + 1;
        }
        y << y + 1;
    }
    return true;
}
fct paintIntroRgba(output) {
    if (paintIntroBitmap(output, "assets/zumbra-nes.bmp")) {
        return output;
    }
    fillIntroFallback(output);
    return output;
}
fct showStartupIntro(context, headlessMode) {
    if (headlessMode) {
        return true;
    }
    var pixels << bytes(256 * 240 * 4);
    paintIntroRgba(pixels);
    var started << native.ticks(context);
    while (!native.shouldClose(context) and native.ticks(context) - started < 1200u64) {
        native.present(context, pixels);
        native.pollAll(context, 32);
        native.delay(context, 50);
        started << started;
    }
    return true;
}
fct drawMenuRow(output, y, selected, labelCodes, labelCount) {
    if (selected) {
        introRect(output, 22, y - 3, 210, 14, 42, 56, 116);
        drawTinyChar(output, 28, y, 1, 62, 255, 220, 120);
        drawTinyCodes(output, 42, y, 1, labelCodes, labelCount, 255, 245, 180);
    } else {
        drawTinyCodes(output, 42, y, 1, labelCodes, labelCount, 236, 238, 236);
    }
    return true;
}
fct drawMainMenu(output, selected, audioEnabled, libraryCount) {
    var y << 0;
    while (y < 240) {
        var x << 0;
        while (x < 256) {
            var destination <<(y * 256 + x) * 4;
            output[destination] << 8u8;
            output[destination + 1] << 10u8;
            output[destination + 2] << 22u8;
            output[destination + 3] << 255u8;
            x << x + 1;
        }
        y << y + 1;
    }
    introRect(output, 8, 8, 240, 224, 6, 8, 18);
    introRect(output, 10, 10, 236, 220, 20, 24, 48);
    introRect(output, 14, 14, 228, 22, 42, 56, 116);
    drawTinyText(output, 22, 22, 1, "ZUMBRA NES 0.5.63", 32, 236, 238, 236);
    drawTinyText(output, 22, 46, 1, "LOCAL GAME LIBRARY + ACHIEVEMENTS", 35, 120, 220, 255);
    drawMenuRow(output, 68, selected == 0,[76, 79, 65, 68, 32, 82, 79, 77], 8);
    drawMenuRow(output, 84, selected == 1,[71, 65, 77, 69, 32, 76, 73, 66, 82, 65, 82, 89], 12);
    drawMenuRow(output, 100, selected == 2,[90, 69, 66, 82, 65, 32, 68, 69, 77, 79], 10);
    drawMenuRow(output, 116, selected == 3,[67, 79, 78, 84, 82, 79, 76, 83], 8);
    drawMenuRow(output, 132, selected == 4,[65, 85, 68, 73, 79], 5);
    drawMenuRow(output, 148, selected == 5,[65, 67, 72, 73, 69, 86, 69, 77, 69, 78, 84, 83], 12);
    drawMenuRow(output, 164, selected == 6,[65, 66, 79, 85, 84], 5);
    drawMenuRow(output, 180, selected == 7,[81, 85, 73, 84], 4);
    drawTinyText(output, 22, 202, 1, "UP/DOWN MOVE  A/START OK", 36, 236, 238, 236);
    drawTinyText(output, 22, 216, 1, "F1 CONTROLS  F6 ACH  F12 QUIT", 36, 236, 238, 236);
    if (audioEnabled) {
        drawTinyText(output, 150, 132, 1, "ON", 3, 120, 255, 160);
    } else {
        drawTinyText(output, 150, 132, 1, "OFF", 3, 255, 150, 120);
    }
    drawTinyNumber(output, 166, 84, 1, libraryCount, 120, 255, 160);
    drawTinyText(output, 188, 84, 1, "GAMES", 5, 120, 255, 160);
    return true;
}
