import "../achievements/catalog.zum" as catalog;
import "../achievements/engine.zum" as achievements;
import "../core/audio_output.zum" as audioOutput;
import "../core/cartridge.zum" as cartridge;
import "../core/console.zum" as console;
import "../core/mapper.zum" as mapper;
import "../debugger/debugger.zum" as debug;
import "../persistence/save_ram.zum" as saveRam;
import "../persistence/save_state.zum" as saveState;
import "../core/palette.zum" as palette;
import "../persistence/store.zum" as store;
import "input.zum" as input;
import "native_bridge.zum" as native;
pub struct DesktopState {
    paused: bool;
    frameAdvance: bool;
    fullscreen: bool;
    muted: bool;
    frames: u64;
    sessionStarted: u64;
    lastSecond: u64;
    fpsFrames: int;
    fps: int;
    saveSlot: int;
    running: bool;
    pendingFrame: bool;
    lastPresent: u64;
    inputBoost: int;
    lastPlayerOne: int;
    lastPlayerTwo: int;
    visibleFrames: int;
    blankFrames: int;
    heldPlayerOne: int;
    heldPlayerTwo: int;
    playerOneHold: int;
    playerTwoHold: int;
}
fct noResult() {
}
fct libraryText(db) {
    var rows << store.recentRoms(db, 20);
    var text << "ROMs recentes\n\n";
    var index << 0;
    while (index < sizeOf(rows)) {
        text << text + toString(index + 1) + ". " + rows[index]["path"] + "\n";
        text << text + "   mapper " + toString(rows[index]["mapper"]) + " | " + toString(rows[index]["play_seconds"]) + "s | " + toString(rows[index]["sessions"]) + " sessões\n";
        index << index + 1;
    }
    if (sizeOf(rows) == 0) {
        text << text + "Nenhuma ROM registrada.\n";
    }
    text;
}
fct achievementText(db, game) {
    if (!game["ok"]) {
        return "Nenhum jogo carregado.";
    }
    var rows << store.achievementRows(db, game["info"].digest);
    var text << "Conquistas locais\n\n";
    var index << 0;
    while (index < sizeOf(rows)) {
        var marker << "[ ]";
        if (rows[index]["unlocked"] == 1) {
            marker << "[x]";
        }
        text << text + marker + " " + rows[index]["title"] + "\n";
        text << text + "    " + rows[index]["description"] + " (" + toString(rows[index]["progress"]) + "/" + toString(rows[index]["target"]) + ")\n";
        index << index + 1;
    }
    text;
}
fct debuggerText(game) {
    if (!game["ok"]) {
        return "Nenhum jogo carregado.";
    }
    var text << debug.summary(game["debugger"]) + "\n\nPróximas instruções:\n";
    var lines << debug.disassemble(game["debugger"], game["machine"]["cpu"].pc, 12);
    var index << 0;
    while (index < sizeOf(lines)) {
        text << text + lines[index]["text"] + "\n";
        index << index + 1;
    }
    text;
}
fct statePath(game, dataDirectory, slot) {
    dataDirectory + "/states/" + game["info"].digest + "-slot" + toString(slot) + ".zst";
}
fct capture(context, prompt, current) {
    var next << native.captureKey(context, prompt);
    if (next >= 0) {
        return next;
    }
    current;
}
fct remapControllers(context, preferences) {
    native.notify(context, "Remapeamento", "Pressione as teclas solicitadas. Esc cancela cada campo.");
    preferences.p1A << capture(context, "Jogador 1: pressione A", preferences.p1A);
    preferences.p1B << capture(context, "Jogador 1: pressione B", preferences.p1B);
    preferences.p1Select << capture(context, "Jogador 1: pressione Select", preferences.p1Select);
    preferences.p1Start << capture(context, "Jogador 1: pressione Start", preferences.p1Start);
    preferences.p1Up << capture(context, "Jogador 1: pressione Cima", preferences.p1Up);
    preferences.p1Down << capture(context, "Jogador 1: pressione Baixo", preferences.p1Down);
    preferences.p1Left << capture(context, "Jogador 1: pressione Esquerda", preferences.p1Left);
    preferences.p1Right << capture(context, "Jogador 1: pressione Direita", preferences.p1Right);
    preferences.p2A << capture(context, "Jogador 2: pressione A", preferences.p2A);
    preferences.p2B << capture(context, "Jogador 2: pressione B", preferences.p2B);
    preferences.p2Select << capture(context, "Jogador 2: pressione Select", preferences.p2Select);
    preferences.p2Start << capture(context, "Jogador 2: pressione Start", preferences.p2Start);
    preferences.p2Up << capture(context, "Jogador 2: pressione Cima", preferences.p2Up);
    preferences.p2Down << capture(context, "Jogador 2: pressione Baixo", preferences.p2Down);
    preferences.p2Left << capture(context, "Jogador 2: pressione Esquerda", preferences.p2Left);
    preferences.p2Right << capture(context, "Jogador 2: pressione Direita", preferences.p2Right);
    true;
} // 0.5.21: keep the Mapper 227 desktop path free from additional helper-call indirection.
// The real desktop runtime was still aborting with "value is not callable" only when
// the command-line Mapper 227 ROM entered the interactive loop. The affected path was
// the set of small Mapper 227/splash helper calls introduced after 0.5.10, not the
// headless smoke path. Inline the scheduler decisions in run() and present the
// framebuffer directly.
fct visibleFramebuffer(framebuffer) {
    if (sizeOf(framebuffer) == 0) {
        return false;
    }
    var first << toInt(framebuffer[0]) band 0x3F;
    var index << 0;
    var nonZero << 0;
    var different << 0;
    while (index < sizeOf(framebuffer)) {
        var color << toInt(framebuffer[index]) band 0x3F;
        if (color != 0) {
            nonZero << nonZero + 1;
        }
        if (color != first) {
            different << different + 1;
        }
        if (nonZero >= 32 and different >= 8) {
            return true;
        }
        index << index + 257;
    }
    false;
}
fct introRect(output, x, y, width, height, red, green, blue) {
    var yy << y;
    while (yy < y + height) {
        var xx << x;
        while (xx < x + width) {
            if (xx >= 0 and xx < 256 and yy >= 0 and yy < 240) {
                var destination <<(yy * 256 + xx) * 4;
                output[destination] << u8(red);
                output[destination + 1] << u8(green);
                output[destination + 2] << u8(blue);
                output[destination + 3] << 255u8;
            }
            xx << xx + 1;
        }
        yy << yy + 1;
    }
    true;
}
fct drawBlockZ(output, x, y, scale, red, green, blue) {
    introRect(output, x, y, 26 * scale, 4 * scale, red, green, blue);
    introRect(output, x, y + 22 * scale, 26 * scale, 4 * scale, red, green, blue);
    var step << 0;
    while (step < 6) {
        introRect(output, x +(20 - step * 4) * scale, y +(4 + step * 3) * scale, 6 * scale, 4 * scale, red, green, blue);
        step << step + 1;
    }
    true;
}
fct drawBlockU(output, x, y, scale, red, green, blue) {
    introRect(output, x, y, 4 * scale, 23 * scale, red, green, blue);
    introRect(output, x + 20 * scale, y, 4 * scale, 23 * scale, red, green, blue);
    introRect(output, x + 4 * scale, y + 22 * scale, 16 * scale, 4 * scale, red, green, blue);
    true;
}
fct drawBlockM(output, x, y, scale, red, green, blue) {
    introRect(output, x, y, 4 * scale, 26 * scale, red, green, blue);
    introRect(output, x + 22 * scale, y, 4 * scale, 26 * scale, red, green, blue);
    introRect(output, x + 5 * scale, y + 4 * scale, 5 * scale, 6 * scale, red, green, blue);
    introRect(output, x + 11 * scale, y + 8 * scale, 5 * scale, 6 * scale, red, green, blue);
    introRect(output, x + 17 * scale, y + 4 * scale, 5 * scale, 6 * scale, red, green, blue);
    true;
}
fct drawBlockB(output, x, y, scale, red, green, blue) {
    introRect(output, x, y, 4 * scale, 26 * scale, red, green, blue);
    introRect(output, x, y, 18 * scale, 4 * scale, red, green, blue);
    introRect(output, x, y + 11 * scale, 19 * scale, 4 * scale, red, green, blue);
    introRect(output, x, y + 22 * scale, 18 * scale, 4 * scale, red, green, blue);
    introRect(output, x + 18 * scale, y + 4 * scale, 4 * scale, 7 * scale, red, green, blue);
    introRect(output, x + 19 * scale, y + 15 * scale, 4 * scale, 7 * scale, red, green, blue);
    true;
}
fct drawBlockR(output, x, y, scale, red, green, blue) {
    drawBlockB(output, x, y, scale, red, green, blue);
    introRect(output, x + 12 * scale, y + 15 * scale, 5 * scale, 5 * scale, red, green, blue);
    introRect(output, x + 17 * scale, y + 19 * scale, 5 * scale, 7 * scale, red, green, blue);
    true;
}
fct drawBlockA(output, x, y, scale, red, green, blue) {
    introRect(output, x, y + 6 * scale, 4 * scale, 20 * scale, red, green, blue);
    introRect(output, x + 20 * scale, y + 6 * scale, 4 * scale, 20 * scale, red, green, blue);
    introRect(output, x + 4 * scale, y, 16 * scale, 5 * scale, red, green, blue);
    introRect(output, x + 4 * scale, y + 12 * scale, 16 * scale, 4 * scale, red, green, blue);
    true;
}
fct drawZumbraWord(output) {
    var red << 226;
    var green << 235;
    var blue << 255;
    var scale << 1;
    var x << 28;
    var y << 100;
    drawBlockZ(output, x, y, scale, red, green, blue);
    drawBlockU(output, x + 31, y, scale, red, green, blue);
    drawBlockM(output, x + 61, y, scale, red, green, blue);
    drawBlockB(output, x + 93, y, scale, red, green, blue);
    drawBlockR(output, x + 122, y, scale, red, green, blue);
    drawBlockA(output, x + 151, y, scale, red, green, blue);
    true;
}
fct le16(data, offset) {
    toInt(data[offset]) +(toInt(data[offset + 1]) shl 8);
}
fct le32(data, offset) {
    toInt(data[offset]) +(toInt(data[offset + 1]) shl 8) +(toInt(data[offset + 2]) shl 16) +(toInt(data[offset + 3]) shl 24);
}
fct paintIntroBitmap(output, path) {
    if (!fileExists(path)) {
        return false;
    }
    var data << readBytes(path);
    if (sizeOf(data) < 54) {
        return false;
    }
    if (toInt(data[0]) != 66 or toInt(data[1]) != 77) {
        return false;
    }
    var pixelOffset << le32(data, 10);
    var width << le32(data, 18);
    var height << le32(data, 22);
    var bits << le16(data, 28);
    if (width < 256 or height < 240 or bits != 24) {
        return false;
    }
    var rowStride <<((width * 3 + 3) / 4) * 4;
    var cropX <<(width - 256) / 2;
    var cropY <<(height - 240) / 2;
    var y << 0;
    while (y < 240) {
        var x << 0;
        while (x < 256) {
            var sourceY << height - 1 -(y + cropY);
            var sourceX << x + cropX;
            var source << pixelOffset + sourceY * rowStride + sourceX * 3;
            var destination <<(y * 256 + x) * 4;
            output[destination] << data[source + 2];
            output[destination + 1] << data[source + 1];
            output[destination + 2] << data[source];
            output[destination + 3] << 255u8;
            x << x + 1;
        }
        y << y + 1;
    }
    true;
}
fct paintIntroRgba(output, phase) {
    phase;
    // 0.5.21: prefer the bundled icon/photo-like bitmap. The previous hand-drawn
    // block letters could read as "Zumbba" because the R glyph looked like B.
    if (paintIntroBitmap(output, "assets/zumbra-nes.bmp")) {
        return output;
    }
    var y << 0;
    while (y < 240) {
        var x << 0;
        while (x < 256) {
            var destination <<(y * 256 + x) * 4;
            output[destination] << 20u8;
            output[destination + 1] << 22u8;
            output[destination + 2] << 28u8;
            output[destination + 3] << 255u8;
            x << x + 1;
        }
        y << y + 1;
    } // Fallback: do not attempt to spell the word with ambiguous block letters.
    introRect(output, 48, 100, 160, 40, 38, 44, 70);
    introRect(output, 56, 108, 144, 24, 226, 235, 255);
    output;
}
fct showStartupIntro(context, headlessMode) {
    if (headlessMode) {
        return true;
    }
    var pixels << bytes(256 * 240 * 4);
    paintIntroRgba(pixels, 0);
    native.present(context, pixels);
    native.pollAll(context, 64);
    native.delay(context, 550);
    true;
}
fct emptyGame(message) {
    {
        "ok": false, "message": message, "path": ""
    };
}
fct openGame(path, db, timestamp, dataDirectory) {
    if (path == "" or!fileExists(path)) {
        return {
            "ok": false, "message": "ROM file not found", "path": path
        };
    }
    var data << readBytes(path);
    var inspection << cartridge.inspectImage(data);
    if (!inspection.ok) {
        return {
            "ok": false, "message": inspection.message, "path": path
        };
    }
    var cart << cartridge.fromBytes(data, path);
    var info << cart["info"];
    var compatibility << mapper.compatibility(info.header.mapper);
    if (!compatibility["ok"]) {
        return {
            "ok": false, "message": compatibility["message"], "path": path
        };
    }
    var machine << console.create(cart);
    saveRam.load(machine, dataDirectory);
    var debuggerState << debug.create(machine);
    store.recordRom(db, info, timestamp);
    store.seedAchievements(db, info.digest, catalog.defaults());
    var sessionId << store.beginSession(db, info.digest, timestamp);
    {
        "ok": true, "message": "ok", "path": path, "cart": cart, "machine": machine, "info": info, "sessionId": sessionId, "audioCursor": audioOutput.createCursor(), "debugger": debuggerState, "dataDirectory": dataDirectory, "rgba": palette.rgbaBuffer(machine["bus"]["ppu"]["framebuffer"])
    };
}
fct closeSession(db, game, state, timestamp, dataDirectory) {
    if (game["ok"]) {
        saveRam.flush(game["machine"], dataDirectory);
        var seconds << toInt(timestamp - state.sessionStarted);
        store.finishSession(db, game["sessionId"], game["info"].digest, timestamp, seconds, state.frames);
    }
}
fct chooseInitialRom(context, db, headlessMode) {
    var path << native.initialRom();
    if (path != "") {
        return path;
    }
    if (headlessMode and fileExists("fixtures/synthetic/z23-visible-frame.nes")) {
        return "fixtures/synthetic/z23-visible-frame.nes";
    }
    if (!headlessMode) {
        return "";
    }
    "";
}
fct updateStatus(context, game, state, preferences) {
    if (!game["ok"]) {
        native.setStatus(context, game["message"]);
        return;
    }
    var mode << "running";
    if (state.paused) {
        mode << "paused";
    }
    var status << game["path"] + " | mapper " + toString(game["info"].header.mapper) + " | slot " + toString(state.saveSlot) + " | " + mode;
    if (preferences.showFps) {
        status << status + " | " + toString(state.fps) + " FPS";
    }
    native.setStatus(context, status);
}
fct mainMenuText(db, game, preferences) {
    var text << "Zumbra NES\n\n";
    text << text + "Jogos\n";
    text << text + "  O: abrir ROM NES/Famicom\n";
    text << text + "  F5: fechar ROM atual\n";
    text << text + "  R: resetar ROM atual\n\n";
    text << text + "Controles\n";
    text << text + "  Setas/WASD: direcional\n";
    text << text + "  Z/J: A | X/K: B | Enter/Espaco: Start | Shift/Tab/Backspace: Select\n";
    text << text + "  F3: remapear teclado/gamepad\n\n";
    text << text + "GPU/Video\n";
    text << text + "  F6/F7: escala | F11: fullscreen | F12: VSync\n\n";
    text << text + "CPU/Execucao\n";
    text << text + "  P: pausar/continuar | F4: turbo seguro | F: frame advance\n";
    text << text + "  Estado atual: escala " + toString(preferences.scale) + " | volume " + toString(preferences.volume) + " | turbo " + toString(preferences.unlimited) + " | vsync " + toString(preferences.vsync) + "\n";
    text << text + "  Esc: sair\n\n";
    text << text + "Biblioteca recente\n";
    text << text + libraryText(db);
    if (game["ok"]) {
        text << text + "\nROM atual: " + game["path"] + " | mapper " + toString(game["info"].header.mapper) + "\n";
    }
    text << text + "\nObservacao: Mapper 227 roda em modo seguro para nao travar o PC. Se a ROM parar em tela preta, a emulacao pausa em vez de continuar consumindo CPU.";
    text;
}
fct showMainMenu(context, db, game, preferences) {
    native.showPanel(context, "Menu Zumbra NES", mainMenuText(db, game, preferences));
    true;
}
fct openGameRuntime(path) {
    if (path == "" or!fileExists(path)) {
        return {
            "ok": false, "message": "ROM file not found", "path": path
        };
    }
    var data << readBytes(path);
    var inspection << cartridge.inspectImage(data);
    if (!inspection.ok) {
        return {
            "ok": false, "message": inspection.message, "path": path
        };
    }
    var cart << cartridge.fromBytes(data, path);
    var info << cart["info"];
    var compatibility << mapper.compatibility(info.header.mapper);
    if (!compatibility["ok"]) {
        return {
            "ok": false, "message": compatibility["message"], "path": path
        };
    }
    var machine << console.create(cart);
    {
        "ok": true, "message": "ok", "path": path, "machine": machine, "info": info, "rgba": palette.rgbaBuffer(machine["bus"]["ppu"]["framebuffer"])
    };
}
fct stableKey(context, code) {
    if (code < 0) {
        return false;
    }
    native.keyDown(context, code);
}
fct stablePlayerOneMask(context) {
    var mask << 0;
    if (stableKey(context, 29) or stableKey(context, 13)) {
        mask << mask bor 0x01;
    }
    if (stableKey(context, 27) or stableKey(context, 14)) {
        mask << mask bor 0x02;
    }
    if (stableKey(context, 229) or stableKey(context, 225) or stableKey(context, 43) or stableKey(context, 42)) {
        mask << mask bor 0x04;
    }
    if (stableKey(context, 40) or stableKey(context, 44) or stableKey(context, 88)) {
        mask << mask bor 0x08;
    }
    if (stableKey(context, 82) or stableKey(context, 26)) {
        mask << mask bor 0x10;
    }
    if (stableKey(context, 81) or stableKey(context, 22)) {
        mask << mask bor 0x20;
    }
    if (stableKey(context, 80) or stableKey(context, 4)) {
        mask << mask bor 0x40;
    }
    if (stableKey(context, 79) or stableKey(context, 7)) {
        mask << mask bor 0x80;
    }
    mask;
}
fct stableShell(context, headlessMode) {
    var pixels << bytes(256 * 240 * 4);
    paintIntroRgba(pixels, 0);
    native.present(context, pixels);
    native.setStatus(context, "Zumbra | O abrir ROM depois | Esc sair");
    var running << true;
    var frames << 0u64;
    var lastPresent << native.ticks(context);
    while (running and!native.shouldClose(context)) {
        native.pollAll(context, 32);
        if (native.keyDown(context, 41)) {
            running << false;
        }
        var nowTicks << native.ticks(context);
        if (nowTicks - lastPresent >= 250u64) {
            native.present(context, pixels);
            lastPresent << nowTicks;
        }
        native.delay(context, 16);
        if (headlessMode) {
            frames << frames + 1u64;
            if (frames >= 2u64) {
                running << false;
            }
        }
    }
    frames;
}

/// Runs the interactive SDL3 frontend, or a deterministic two-frame headless smoke.
pub fct run() {
    var context << native.create("Zumbra NES 0.5.21", 3, true, false, false);
    var headlessMode << native.headless(context);
    if (!native.valid(context)) {
        panic(native.error(context));
    }
    native.pollAll(context, 8);
    showStartupIntro(context, headlessMode);
    var initialPath << native.initialRom();
    if (initialPath == "" and headlessMode and fileExists("fixtures/synthetic/z23-visible-frame.nes")) {
        initialPath << "fixtures/synthetic/z23-visible-frame.nes";
    }
    if (initialPath == "") {
        var shellFrames << stableShell(context, headlessMode);
        native.destroy(context);
        show("Z23 desktop session complete");
        show(shellFrames);
        return true;
    }
    var game << openGameRuntime(initialPath);
    if (!game["ok"]) {
        native.destroy(context);
        panic(game["message"]);
    }
    var running << true;
    var paused << false;
    var frames << 0u64;
    var pendingFrame << true;
    var lastPresent << native.ticks(context);
    var lastP << false;
    var mapperId << game["info"].header.mapper;
    native.setStatus(context, "Zumbra | mapper " + toString(mapperId) + " | P pausa | Esc sair");
    while (running and!native.shouldClose(context)) {
        var frameStart << native.ticks(context);
        native.pollAll(context, 32);
        if (native.keyDown(context, 41)) {
            running << false;
        }
        var pNow << native.keyDown(context, 19);
        if (pNow and!lastP) {
            paused <<!paused;
        }
        lastP << pNow;
        var playerOne << stablePlayerOneMask(context);
        console.setController(game["machine"], 1, playerOne);
        console.setController(game["machine"], 2, 0);
        if (!paused) {
            if (pendingFrame) {
                console.clearFrameComplete(game["machine"]);
                pendingFrame << false;
            }
            var frameCompleteNow << false;
            var loops << 0;
            var sliceLimit << 512;
            if (mapperId == 227 and!headlessMode) {
                sliceLimit << 96;
            }
            while (!frameCompleteNow and!native.shouldClose(context) and loops < 6 and native.ticks(context) - frameStart <= 10u64) {
                console.setVideoOutput(game["machine"], true);
                var code << console.runFrameSliceCode(game["machine"], sliceLimit);
                if (code < 0) {
                    frameCompleteNow << true;
                }
                loops << loops + 1;
                native.pollAll(context, 8);
            }
            if (frameCompleteNow) {
                pendingFrame << true;
                frames << frames + 1u64;
                var framebuffer << game["machine"]["bus"]["ppu"]["framebuffer"];
                var rgba << palette.writeRgba(framebuffer, game["rgba"]);
                native.present(context, rgba);
                lastPresent << native.ticks(context);
            } else {
                native.delay(context, 2);
            }
        } else {
            var pausedTicks << native.ticks(context);
            if (pausedTicks - lastPresent >= 100u64) {
                var pausedRgba << palette.writeRgba(game["machine"]["bus"]["ppu"]["framebuffer"], game["rgba"]);
                native.present(context, pausedRgba);
                lastPresent << pausedTicks;
            }
            native.delay(context, 16);
        }
        if (headlessMode and frames >= 2u64) {
            running << false;
        }
        if (!headlessMode and mapperId == 227) {
            native.delay(context, 8);
        } else {
            var elapsed << native.ticks(context) - frameStart;
            if (elapsed < 16u64) {
                native.delay(context, toInt(16u64 - elapsed));
            }
        }
    }
    native.destroy(context);
    show("Z23 desktop session complete");
    show(frames);
    true;
}
